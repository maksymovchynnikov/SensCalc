    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SectionCell", "=", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"match", "=", RowBox[{"SelectFirst", "[", RowBox[{"inp", ",", RowBox[{RowBox[{RowBox[{"#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[Equal]", "section"}], "&"}], ",", RowBox[{"Missing", "[", "\"NotFound\"", "]"}]}], "]"}]}], "}"}], ",", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"MissingQ", "[", "match", "]"}], ",", RowBox[{RowBox[{"infoDialog", "[", TemplateBox[{"\"No production section is available for \"", "section"}, "RowDefault"], "]"}], ";", RowBox[{"Return", "[", RowBox[{"$Failed", ",", "Block"}], "]"}]}]}], "]"}], ";", RowBox[{"First", "[", "match", "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{"SectionCell", "=!=", "$Canceled"}], ")"}]}], ",", 
       RowBox[{"infoDialog", "[", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<There is no section/section name associated with the \
given LLP and production channel: \>\"", ",", "section", 
           ",", "\"\<Add them\>\""}], "}"}], "]"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"SectionCell", "=!=", "$Canceled"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"SelectionMove", "[", 
            RowBox[{"SectionCell", ",", "All", ",", "CellGroup"}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"Scan", "[", RowBox[{RowBox[{RowBox[{"ToExpression", "[", RowBox[{"#1", ",", "StandardForm"}], "]"}], "&"}], ",", RowBox[{"Cases", "[", RowBox[{RowBox[{"NotebookRead", "[", RowBox[{"ParentNotebook", "[", "SectionCell", "]"}], "]"}], ",", RowBox[{RowBox[{"Cell", "[", RowBox[{RowBox[{"BoxData", "[", "boxes_", "]"}], ",", "\"Input\"", ",", "___"}], "]"}], "\[RuleDelayed]", "boxes"}], ",", "\[Infinity]"}], "]"}]}], "]"}]}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{RowBox[{"BlockProductionComputation", "[", RowBox[{"LLP_", ",", "prodlist_"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"seclist", ",", RowBox[{"LLPsel", "=", RowBox[{"Which", "[", RowBox[{RowBox[{"LLP", "\[Equal]", "\"Dark-QCD-rho\""}], ",", "\"DP\"", ",", RowBox[{"StringContainsQ", "[", RowBox[{"LLP", ",", "\"Inelastic-dipole-DM\""}], "]"}], ",", "\"Inelastic-dipole-DM\"", ",", "True", ",", "LLP"}], "]"}]}]}], "}"}], ",", RowBox[{RowBox[{"seclist", "=", RowBox[{RowBox[{"(", RowBox[{RowBox[{"LLPsel", "<>", "\"_\"", "<>", "#1"}], "&"}], ")"}], "/@", "prodlist"}]}], ";", RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"SubsetQ", "[", RowBox[{RowBox[{"Last", "/@", "inp"}], ",", "seclist"}], "]"}]}], ",", RowBox[{RowBox[{"Print", "[", RowBox[{"\"Missing production sections: \"", ",", RowBox[{"Complement", "[", RowBox[{"seclist", ",", RowBox[{"Last", "/@", "inp"}]}], "]"}]}], "]"}], ";", RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"Print", "[", TemplateBox[{"\"Production: \"", RowBox[{"prodlist", "\[LeftDoubleBracket]", "modeIndex", "\[RightDoubleBracket]"}], "\" | mode \"", "modeIndex", "\" of \"", RowBox[{"Length", "[", "prodlist", "]"}]}, "RowDefault"], "]"}], ";", RowBox[{"SectionEvaluator", "[", RowBox[{"seclist", "\[LeftDoubleBracket]", "modeIndex", "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[{"{", RowBox[{"modeIndex", ",", RowBox[{"Length", "[", "seclist", "]"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
