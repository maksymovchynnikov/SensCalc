Cell[BoxData[RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"TrueQ", "[", "productionSelectionReady", "]"}], ",", RowBox[{RowBox[{RowBox[{"CondSelLLP", "[", "prod_", "]"}], ":=", RowBox[{"If", "[", RowBox[{RowBox[{"SelectedLLP", "\[NotEqual]", "\"HNL\""}], ",", RowBox[{RowBox[{"StringContainsQ", "[", RowBox[{RowBox[{"ProductionType", "[", RowBox[{"SelectedLLP", ",", "prod"}], "]"}], ",", RowBox[{"{", RowBox[{"\"Decay\"", ",", "\"Mixing\""}], "}"}]}], "]"}], "||", RowBox[{"StringContainsQ", "[", RowBox[{"prod", ",", "\"Primakov\""}], "]"}]}], ",", RowBox[{"StringContainsQ", "[", RowBox[{RowBox[{"ProductionType", "[", RowBox[{RowBox[{"ListHNLs", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", "prod"}], "]"}], ",", RowBox[{"{", RowBox[{"\"Decay\"", ",", "\"Mixing\""}], "}"}]}], "]"}]}], "]"}]}], ";", RowBox[{"If", "[", RowBox[{RowBox[{"Or", "@@", RowBox[{"Flatten", "[", RowBox[{"Table", "[", RowBox[{RowBox[{"Block", "[", RowBox[{RowBox[{"{", RowBox[{"SelectedLLP", "=", "llp"}], "}"}], ",", RowBox[{"CondSelLLP", "/@", RowBox[{"ProductionSelections", "[", "llp", "]"}]}]}], "]"}], ",", RowBox[{"{", RowBox[{"llp", ",", "SelectedLLPlist"}], "}"}]}], "]"}], "]"}]}], ",", RowBox[{RowBox[{"nsim", "=", RowBox[{"DialogInput", "[", RowBox[{RowBox[{"{", RowBox[{"br", "=", SuperscriptBox["10", "6"]}], "}"}], ",", RowBox[{"Column", "[", RowBox[{"{", RowBox[{"\"Number of simulated events per channel (decay and Primakov production):\"", ",", "\"Typical values: 10^6 to 10^7. This choice applies to all selected LLPs.\"", ",", RowBox[{"InputField", "[", RowBox[{RowBox[{"Dynamic", "[", "br", "]"}], ",", "Expression"}], "]"}], ",", RowBox[{"Row", "[", RowBox[{"{", RowBox[{RowBox[{"Button", "[", RowBox[{"\"Proceed\"", ",", RowBox[{"DialogReturn", "[", "br", "]"}], ",", RowBox[{"ImageSize", "\[Rule]", "Automatic"}]}], "]"}], ",", TemplateBox[{15}, "Spacer1"], ",", RowBox[{"Button", "[", RowBox[{"\"Cancel\"", ",", RowBox[{"DialogReturn", "[", "$Canceled", "]"}], ",", RowBox[{"ImageSize", "\[Rule]", "Automatic"}]}], "]"}]}], "}"}], "]"}]}], "}"}], "]"}]}], "]"}]}], ";", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"!", RowBox[{"NumericQ", "[", "nsim", "]"}]}], "||", RowBox[{"!", RowBox[{"TrueQ", "[", RowBox[{"1", "\[LessEqual]", "nsim", "<", "\[Infinity]"}], "]"}]}]}], ",", RowBox[{RowBox[{"productionSelectionReady", "=", "False"}], ";", RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", RowBox[{"nsim", "=", RowBox[{"2", " ", RowBox[{"Ceiling", "[", FractionBox[RowBox[{"IntegerPart", "[", "nsim", "]"}], "2"], "]"}]}]}], ";"}]}], "]"}], ";", RowBox[{"modes", "=", RowBox[{"DeleteDuplicates", "[", RowBox[{"Flatten", "[", RowBox[{"Table", "[", RowBox[{RowBox[{"ProcessesListFacility", "[", RowBox[{"LLP", ",", "Facility"}], "]"}], ",", RowBox[{"{", RowBox[{"LLP", ",", "LLPlistEffective"}], "}"}], ",", RowBox[{"{", RowBox[{"Facility", ",", "FacilitiesList"}], "}"}]}], "]"}], "]"}], "]"}]}], ";", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{RowBox[{"\[Theta]minExtrFacility", "[", RowBox[{"\"ESS\"", ",", "mode"}], "]"}], "=", "0.1`"}], ";", RowBox[{RowBox[{"\[Theta]minExtrFacility", "[", RowBox[{"\"Serpukhov\"", ",", "mode"}], "]"}], "=", SuperscriptBox["10", RowBox[{"-", "1.3`"}]]}], ";", RowBox[{RowBox[{"\[Theta]minExtrFacility", "[", RowBox[{"\"SPS\"", ",", "mode"}], "]"}], "=", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"StringContainsQ", "[", RowBox[{"mode", ",", "\"Pi0\""}], "]"}], "||", RowBox[{"StringContainsQ", "[", RowBox[{"mode", ",", "\"Primakov\""}], "]"}], "||", RowBox[{"StringContainsQ", "[", RowBox[{"mode", ",", "\"Eta\""}], "]"}], "||", RowBox[{"StringContainsQ", "[", RowBox[{"mode", ",", "\"Rho0\""}], "]"}], "||", RowBox[{"StringContainsQ", "[", RowBox[{"mode", ",", "\"Omega\""}], "]"}]}], ",", FractionBox["0.5`", SuperscriptBox["10", "3.`"]], ",", SuperscriptBox["10", RowBox[{"-", "3.`"}]]}], "]"}]}], ";", RowBox[{RowBox[{"\[Theta]minExtrFacility", "[", RowBox[{"\"FermilabBD\"", ",", "mode"}], "]"}], "=", RowBox[{RowBox[{"\[Theta]minExtrFacility