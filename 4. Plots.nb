          ";", "\[IndentingNewLine]", RowBox[{"couplingLabel", "=", "\"\\!\\(\\*SuperscriptBox[\\(\
\[CapitalLambda]\\), \\(-2\\)]\\) [\\!\\(\\*SuperscriptBox[\\(GeV\\), \\(-2\\)]\\)]\""}], ";", 
          "\[IndentingNewLine]", RowBox[{"dirplots", "=", RowBox[{"FileNameJoin", "[", 
              RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"plots\"", ",", 
                  "\"Sensitivities\"", ",", "LLPdirName"}], "}"}], "]"}]}], ";"}]], "Input"]}, 
