 RowBox[{
  RowBox[{"ParametersSensitivityTemp", "[", "i_", "]"}], ":=", 
  RowBox[{
   RowBox[{"StringCases", "[", RowBox[{RowBox[{"StringReplace", "[", RowBox[{RowBox[{"filenamesSensitivity", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", RowBox[{RowBox[{"RegularExpression", "[", "\"_cfg=[0-9a-f]+(?=\\\\.)\"", "]"}], "\[Rule]", "\"\""}]}], "]"}], ",", RowBox[{RowBox[{RowBox[{"\"Sensitivity_\"", "<>", "LLPdirName", "<>", "\"_at_\""}], "~~", "experiment__", "~~", "\"_BrhToSS=\"", "~~", "BrhToSS__", "~~", "\"_Nev=\"", "~~", "Nev__", "~~", "\"_Npot=\"", "~~", "Npot__", "~~", "\".mx\""}], "\[RuleDelayed]", RowBox[{"{", RowBox[{"experiment", ",", RowBox[{"ToExpression", "[", "BrhToSS", "]"}], ",", RowBox[{"ToExpression", "[", "Nev", "]"}], ",", "Npot"}], "}"}]}]}], "]"}], "[", 
