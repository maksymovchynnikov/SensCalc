Cell[BoxData[{
 RowBox[{
  RowBox[{"filenamesSensitivityTemp", "=", 
   RowBox[{"FileNames", "[", 
    RowBox[{"\"\<Sensitivity*.mx\>\"", ",", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        ",", "\"\<Sensitivity domains\>\"", ",", "LLPdirName"}], "}"}], "]"}],
      ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"filenamesSensitivity", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Last", "@", 
      RowBox[{"FileNameSplit", "@", 
       RowBox[{"filenamesSensitivityTemp", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "filenamesSensitivityTemp", "]"}], ",", "1"}], 
      "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParametersSensitivityTemp", "[", "i_", "]"}], ":=", 
  RowBox[{
   RowBox[{"StringCases", "[", RowBox[{RowBox[{"StringReplace", "[", RowBox[{RowBox[{"filenamesSensitivity", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", RowBox[{RowBox[{"RegularExpression", "[", "\"_cfg=[0-9a-f]+(?=\\\\.)\"", "]"}], "\[Rule]", "\"\""}]}], "]"}], ",", RowBox[{RowBox[{RowBox[{"\"Sensitivity_\"", "<>", "LLPdirName", "<>", "\"_at_\""}], "~~", "experiment__", "~~", "\"_Nev=\"", "~~", "Nev__", "~~", "\"_Npot=\"", "~~", "Npot__", "~~", "\".mx\""}], "\[RuleDelayed]", RowBox[{"{", RowBox[{"experiment", ",", RowBox[{"ToExpression", "[", "Nev", "]"}], ",", "Npot"}], "}"}]}]}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParametersSensitivity", "=", RowBox[{"Table", "[", RowBox[{RowBox[{"sensitivityRecord", "[", RowBox[{RowBox[{"filenamesSensitivityTemp", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", RowBox[{"ParametersSensitivityTemp", "[", "i", "]"}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", "filenamesSensitivity", "]"}], ",", "1"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<List of available sensitivities:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rowexpl", "=", RowBox[{"{", RowBox[{"{", RowBox[{"\"Experiment\"", ",", "\"\\!\\(\\*SubscriptBox[\\(N\\), \\(ev, min\\)]\\)\"", ",", "\"\\!\\(\\*SubscriptBox[\\(N\\), \\(PoT\\)]\\)\"", ",", "\"Production selection / configuration\""}], "}"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Join", "[", 
   RowBox[{"rowexpl", ",", "ParametersSensitivity"}], "]"}], "//", 
  "TableForm"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Selected sensitivities:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"listSensitivities", "=", 
   RowBox[{"selectionDialogn", "[", 
    RowBox[{
