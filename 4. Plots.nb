Cell[BoxData[{RowBox[{RowBox[{"LLPdirName", "=", "\"ALP-electroweak\""}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"dir", "=", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"contours\"", ",", "LLPdirName"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"ExcludedRegions", "[", "LLPdirName", "]"}], "=", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Import", "[", RowBox[{"#1", ",", "\"Table\""}], "]"}], "&"}], ")"}], "/@", RowBox[{"FileNames", "[", RowBox[{RowBox[{"LLPdirName", "<>", "\"-excluded*.txt\""}], ",", "dir"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"filenamesSensitivityTemp", "=", RowBox[{"FileNames", "[", RowBox[{"\"Sensitivity*.mx\"", ",", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"Sensitivity domains\"", ",", "LLPdirName"}], "}"}], "]"}], ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"filenamesSensitivity", "=", RowBox[{"FileNameTake", "/@", "filenamesSensitivityTemp"}]}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"ParametersSensitivityTemp", "[", "i_", "]"}], ":=", RowBox[{"First", "[", RowBox[{"StringCases", "[", RowBox[{RowBox[{"StringReplace", "[", RowBox[{RowBox[{"filenamesSensitivity", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", RowBox[{RowBox[{"RegularExpression", "[", "\"_cfg=[0-9a-f]+(?=\\\\.)\"", "]"}], "\[Rule]", "\"\""}]}], "]"}], ",", RowBox[{RowBox[{RowBox[{"\"Sensitivity_\"", "<>", "LLPdirName", "<>", "\"_at_\""}], "~~", "experiment__", "~~", "\"_Nev=\"", "~~", "Nev__", "~~", "\"_Npot=\"", "~~", "Npot__", "~~", "\".mx\""}], "\[RuleDelayed]", RowBox[{"{", RowBox[{"experiment", ",", RowBox[{"ToExpression", "[", "Nev", "]"}], ",", "Npot"}], "}"}]}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"sensitivityMetadataFiles", "=", RowBox[{RowBox[{"(", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"DirectoryName", "[