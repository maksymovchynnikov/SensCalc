Cell[CellGroupData[{Cell["Inelastic-DP-DM", "Chapter"], Cell["Choose one Model before importing \
sensitivities. Laboratory constraints and the black relic-target line are supplied only for Model \
1: Delta = (m(chi2)-m(chi1))/m(chi1) = 0.1, alpha_D = 0.1 and m(chi1)/m(V) = 1/3. The stored curves \
already use m(chi1) in GeV and epsilon^2; no further mass or coupling conversion is applied. \
Model-1 constraints are not reused for other Models.", "Text"], 
   Cell[CellGroupData[{Cell["Definitions", "Section"], 
      Cell[BoxData[RowBox[{RowBox[{"modelsInelastic", "=", 
            RowBox[{RowBox[{"{", "\"Inelastic-DP-DM-Model-1\"", "}"}], "\[Union]", 
              RowBox[{"FileNameTake", "/@", RowBox[{"Select", "[", RowBox[{RowBox[{"Join", "[", 
                      RowBox[{RowBox[{"FileNames", "[", RowBox[{"\"Inelastic-DP-DM-Model-*\"", ",", 
                            RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[
                                 {"NotebookDirectory", "[", "]"}], ",", 
                                 "\"Sensitivity domains\""}], "}"}], "]"}]}], "]"}], ",", 
                        RowBox[{"FileNames", "[", RowBox[{"\"Inelastic-DP-DM-Model-*\"", ",", 
                            RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[
                                 {"NotebookDirectory", "[", "]"}], ",", "\"phenomenology\""}], 
                                "}"}], "]"}]}], "]"}]}], "]"}], ",", "DirectoryQ"}], "]"}]}]}]}], 
          ";", "\[IndentingNewLine]", RowBox[{"LLPdirName", "=", RowBox[{"DialogInput", "[", 
              RowBox[{RowBox[{"{", RowBox[{"choice", "=", "\"Inelastic-DP-DM-Model-1\""}], "}"}], 
                ",", RowBox[{"Column", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Style", "[", 
                          RowBox[{"\"Select the inelastic dark-matter model\"", ",", "Bold", ",", 
                            RowBox[{"FontFamily", "\[Rule]", "\"Palatino\""}]}], "]"}], ",", 
                        RowBox[{"PopupMenu", "[", RowBox[{RowBox[{"Dynamic", "[", "choice", "]"}], 
                            ",", "modelsInelastic"}], "]"}], ",", 
                        "\"Model 1: Delta = 0.1, m(chi1)/m(V) = 1/3, alpha_D = 0.1.\"", ",", 
                        RowBox[{"Button", "[", RowBox[{"\"Use\"", ",", RowBox[{"DialogReturn", "[", 
                              "choice", "]"}]}], "]"}]}], "}"}], ",", RowBox[{"Spacings", 
                      "\[Rule]", "1"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"massLabel", "=", 
            "\"\\!\\(\\*SubscriptBox[\\(m\\), SubscriptBox[\\(\[Chi]\\), \\(1\\)]]\\) [GeV]\""}], 
          ";", "\[IndentingNewLine]", RowBox[{"couplingLabel", "=", 
            "\"\\!\\(\\*SuperscriptBox[\\(\[Epsilon]\\), \\(2\\)]\\)\""}], ";", 
          "\[IndentingNewLine]", RowBox[{"dirplots", "=", RowBox[{"FileNameJoin", "[", 
              RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"plots\"", ",", 
                  "\"Sensitivities\"", ",", "LLPdirName"}], "}"}], "]"}]}], ";"}]], "Input"]}, 
     Open]], Cell[CellGroupData[{Cell["Externally computed constraints/sensitivities", "Section"], 
      Cell[BoxData[
 {RowBox[{RowBox[{"dir", "=", RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"contours\"", ",", 
            "\"Inelastic-DP-DM\""}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{RowBox[{RowBox[{"ExcludedRegions", "[", "LLPdirName", "]"}], "=", RowBox[{"{", "}"}]}], ";"}], 
  "\[IndentingNewLine]", RowBox[{RowBox[{"relicTarget", "=", RowBox[{"{", "}"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"LLPdirName", "\[Equal]", "\"Inelastic-DP-DM-Model-1\""}], ",", 
        RowBox[{RowBox[{RowBox[{"ExcludedRegions", "[", "LLPdirName", "]"}], "=", 
            RowBox[{"{", RowBox[{"Rest", "[", RowBox[{"Import", "[", RowBox[{RowBox[{"FileNameJoin", "[", 
