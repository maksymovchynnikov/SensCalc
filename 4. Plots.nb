Cell[CellGroupData[{
Cell["ALP-electroweak", "Chapter", ExpressionUUID->"0c09d55d-3ef8-4fbb-a233-b482731d116a"],

Cell["Evaluate Definitions first, then this chapter. Existing bounds use gW = (Pi/alpha2) g_aWW and include the astrophysical SN1987 bound; see contours/ALP-electroweak/README.md. With no saved sensitivities this chapter plots the constraints alone.", "Text", ExpressionUUID->"7fa170a8-56a1-4e1f-b32e-35164be0f40a"],

Cell["Select sensitivities", "Section", ExpressionUUID->"3f675a93-ac88-4535-93f1-f38f7db15294"],

Cell[BoxData[RowBox[{RowBox[{"LLPdirName", "=", "\"ALP-electroweak\""}], ";", "\[IndentingNewLine]", RowBox[{"dir", "=", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"contours\"", ",", "LLPdirName"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ExcludedRegions", "[", "LLPdirName", "]"}], "=", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Import", "[", RowBox[{"#1", ",", "\"Table\""}], "]"}], "&"}], ")"}], "/@", RowBox[{"FileNames", "[", RowBox[{RowBox[{"LLPdirName", "<>", "\"-excluded*.txt\""}], ",", "dir"}], "]"}]}]}], ";", "\[IndentingNewLine]", RowBox[{"filenamesSensitivityTemp", "=", RowBox[{"FileNames", "[", RowBox[{"\"Sensitivity*.mx\"", ",", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"Sensitivity domains\"", ",", "LLPdirName"}], "}"}], "]"}], ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"filenamesSensitivity", "=", RowBox[{"FileNameTake", "/@", "filenamesSensitivityTemp"}]}], ";", "\[IndentingNewLine]", RowBox[{"ParametersSensitivity", "=", RowBox[{"Table", "[", RowBox[{RowBox[{"sensitivityRecord", "[", RowBox[{RowBox[{"filenamesSensitivityTemp", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", RowBox[{"First", "[", RowBox[{"StringCases", "[", RowBox[{RowBox[{"StringReplace", "[", RowBox[{RowBox[{"filenamesSensitivity", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", RowBox[{RowBox[{"RegularExpression", "[", "\"_cfg=[0-9a-f]+(?=\\\\.)\"", "]"}], "\[Rule]", "\"\""}]}], "]"}], ",", RowBox[{RowBox[{RowBox[{"\"Sensitivity_\"", "<>", "LLPdirName", "<>", "\"_at_\""}], "~~", "experiment__", "~~", "\"_Nev=\"", "~~", "Nev__", "~~", "\"_Npot=\"", "~~", "Npot__", "~~", "\".mx\""}], "\[RuleDelayed]", RowBox[{"{", RowBox[{"experiment", ",", RowBox[{"ToExpression", "[", "Nev", "]"}], ",", "Npot"}], "}"}]}]}], "]"}], "]"}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", "filenamesSensitivity", "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"listSensitivities", "=", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Length", "[", "ParametersSensitivity", "]"}], ">", "0"}], ",", RowBox[{"selectionDialog", "[", RowBox[{"ParametersSensitivity", ",", "\"{Experiment, N_ev,min, N_PoT}\""}], "]"}], ",", RowBox[{RowBox[{"Print", "[", "\"No ALP-electroweak sensitivities found; plotting existing constraints only.\"", "]"}], ";", "\[IndentingNewLine]", RowBox[{"{", "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"SensitivitiesForPlotTemp", "=", RowBox[{"Table", "[", RowBox[{RowBox[{"Select", "[", RowBox[{RowBox[{"Import", "[", RowBox[{RowBox[{"filenamesSensitivityTemp", "\[LeftDoubleBracket]", RowBox[{"First", "[", RowBox[{"FirstPosition", "[", RowBox[{"ParametersSensitivity", ",", "item"}], "]"}], "]"}], "\[RightDoubleBracket]"}], ",", "\"MX\""}], "]"}], ",", RowBox[{RowBox[{RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[{"-", "2"}], "\[RightDoubleBracket]"}], "\[Equal]", "\"Default\""}], "&"}]}], "]"}], ",", RowBox[{"{", RowBox[{"item", ",", "listSensitivities"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"SensitivitiesForPlot", "=", RowBox[{RowBox[{"(", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Length", "[", "#1", "]"}], ">", "0"}], ",", RowBox[{"#1", "\[LeftDoubleBracket]", RowBox[{"1", ",", RowBox[{"-", "1"}]}], "\[RightDoubleBracket]"}], ",", RowBox[{"{", "}"}]}], "]"}], "&"}], ")"}], "/@", "SensitivitiesForPlotTemp"}]}], ";"}]], "Input", ExpressionUUID->"ac79637a-7ece-47ef-aef8-bf83e3fc3ce2"],

Cell["Plot constraints and sensitivities", "Section", ExpressionUUID->"c318ea0d-1678-4bb9-81df-576171616e02"],

Cell[BoxData[RowBox[{RowBox[{"mminmaxoverall", "=", RowBox[{"{", RowBox[{"0.01`", ",", "5.2`"}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{"couplingminmaxoverall", "=", RowBox[{"{", RowBox[{FractionBox["1", SuperscriptBox["10", "6"]], ",", "0.1`"}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{"ColorsForPlot", "=", RowBox[{"Table", "[", RowBox[{RowBox[{"Directive", "[", RowBox[{"Thick", ",", RowBox[{RowBox[{"ColorData", "[", "97", "]"}], "[", "i", "]"}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", "listSensitivities", "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"plotstylelist", "=", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"ConstantArray", "[", RowBox[{RowBox[{"ColorsForPlot", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", RowBox[{"Length", "[", RowBox[{"Cases", "[", RowBox[{RowBox[{"SensitivitiesForPlot", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", RowBox[{"_", "?", "MatrixQ"}], ",", RowBox[{"{", RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}], "]"}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", "listSensitivities", "]"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"LegendsForPlot", "=", RowBox[{"Table", "[", RowBox[{TemplateBox[{RowBox[{"listSensitivities", "\[LeftDoubleBracket]", RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "\", N_ev \"", "\"\[GreaterEqual] \"", RowBox[{"listSensitivities", "\[LeftDoubleBracket]", RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}]}, "RowDefault"], ",", RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", "listSensitivities", "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"PlotSensitivityALPelectroweak", "=", RowBox[{"Show", "[", RowBox[{RowBox[{"ListLogLogPlot", "[", RowBox[{RowBox[{"ExcludedRegions", "[", "LLPdirName", "]"}], ",", RowBox[{"Joined", "\[Rule]", "True"}], ",", RowBox[{"PlotStyle", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"Directive", "[", RowBox[{"Gray", ",", RowBox[{"AbsoluteThickness", "[", "1.5`", "]"}]}], "]"}], ",", RowBox[{"Directive", "[", RowBox[{"Gray", ",", RowBox[{"AbsoluteThickness", "[", "1.5`", "]"}], ",", "Dashed"}], "]"}]}], "}"}]}], ",", RowBox[{"Prolog", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"Gray", ",", RowBox[{"Opacity", "[", "0.2`", "]"}], ",", RowBox[{"Polygon", "[", RowBox[{"Log", "[", RowBox[{RowBox[{"ExcludedRegions", "[", "LLPdirName", "]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}], "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"Gray", ",", RowBox[{"Opacity", "[", "0.1`", "]"}], ",", RowBox[{"Polygon", "[", RowBox[{"Log", "[", RowBox[{RowBox[{"ExcludedRegions", "[", "LLPdirName", "]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}], "]"}]}], "}"}]}], "}"}]}], ",", RowBox[{"Frame", "\[Rule]", "True"}], ",", RowBox[{"FrameLabel", "\[Rule]", RowBox[{"{", RowBox[{TemplateBox[{SubscriptBox["\"m\"", "\"a\""], "\" [GeV]\""}, "RowDefault"], ",", TemplateBox[{SubscriptBox["\"g\"", "\"W\""], "\" [\"", TemplateBox[{"\"GeV\"", RowBox[{"-", "1"}]}, "Superscript", SyntaxForm -> SuperscriptBox], "\"]\""}, "RowDefault"]}], "}"}]}], ",", RowBox[{"FrameStyle", "\[Rule]", RowBox[{"Directive", "[", RowBox[{"Black", ",", "20"}], "]"}]}], ",", RowBox[{"ImageSize", "\[Rule]", "Large"}], ",", RowBox[{"PlotRange", "\[Rule]", RowBox[{"{", RowBox[{"mminmaxoverall", ",", "couplingminmaxoverall"}], "}"}]}], ",", RowBox[{"PlotLabel", "\[Rule]", RowBox[{"Style", "[", RowBox[{"\"ALP-electroweak\"", ",", "18", ",", "Black"}], "]"}]}]}], "]"}], ",", RowBox[{"ListLogLogPlot", "[", RowBox[{RowBox[{"Cases", "[", RowBox[{"SensitivitiesForPlot", ",", RowBox[{"_", "?", "MatrixQ"}], ",", "\[Infinity]"}], "]"}], ",", RowBox[{"Joined", "\[Rule]", "True"}], ",", RowBox[{"PlotStyle", "\[Rule]", "plotstylelist"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"PlotSensitivityALPelectroweak", "=", RowBox[{"Legended", "[", RowBox[{"PlotSensitivityALPelectro