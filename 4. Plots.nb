Cell[CellGroupData[{

Cell["Selecting the `baseline` production and decay descriptions", \
"Subsection",
 CellChangeTimes->{{3.952592674562355*^9, 
  3.9525926913931274`*^9}},ExpressionUUID->"cb23110b-db4c-9b42-a7df-\
e84105c2c1ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bremDescriptions", ",", "decayDescriptions"}], "}"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"SensitivitiesForPlotTemp", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "#"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "SensitivitiesForPlotTemp", "]"}], ",", 
            "1"}], "}"}]}], "]"}], "//", "Flatten"}], "//", 
       "DeleteDuplicates"}], ")"}], "&"}], "/@", 
    RowBox[{"Range", "[", 
     RowBox[{"2", ",", "3"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bremBaseline", ",", "decayBaseline"}], "}"}], "=", 
   RowBox[{"DialogInput", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"choiceBrem", "=", 
        RowBox[{"bremDescriptions", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"choiceDecay", "=", 
        RowBox[{"decayDescriptions", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
           "\"\<Select the default choice of phenomenology description of \
\>\"", "<>", "LLPdirName", "<>", "\"\< to be used in default plots\>\""}], 
           ",", "Bold"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Bremsstrahlung description:\>\"", ",", "Bold"}], "]"}],
          ",", 
         RowBox[{"RadioButtonBar", "[", 
          RowBox[{
           RowBox[{"Dynamic", "[", "choiceBrem", "]"}], ",", 
           "bremDescriptions", ",", 
           RowBox[{"Appearance", "->", "\"\<Vertical\>\""}]}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Decay description:\>\"", ",", "Bold"}], "]"}], ",", 
         RowBox[{"RadioButtonBar", "[", 
          RowBox[{
           RowBox[{"Dynamic", "[", "choiceDecay", "]"}], ",", 
           "decayDescriptions", ",", 
           RowBox[{"Appearance", "->", "\"\<Vertical\>\""}]}], "]"}], ",", 
         RowBox[{"Button", "[", 
          RowBox[{"\"\<OK\>\"", ",", 
           RowBox[{"DialogReturn", "[", 
            RowBox[{"{", 
             RowBox[{"choiceBrem", ",", "choiceDecay"}], "}"}], "]"}]}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"Spacings", "->", "1"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sensBaseline", "=", 
   RowBox[{"{", 
    RowBox[{"{", "}"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"givenData", "=", 
         RowBox[{"SensitivitiesForPlotTemp", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ",", 
        RowBox[{"exp", "=", 
         RowBox[{"listSensitivities", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ",", "decdescr", ",", 
        "bremdescr"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bremGivenExperiment", ",", "decayGivenExperiment"}], "}"}], 
        "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"givenData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "#"}], "]"}], "]"}], "//", 
            "DeleteDuplicates"}], ")"}], "&"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"2", ",", "3"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"senstemp", "=", "givenData"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"For", " ", "each", " ", "experiment"}], ",", " ", 
         RowBox[{
         "selecting", " ", "baseline", " ", "decay", " ", "description"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"decayGivenExperiment", ",", "decayBaseline"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"senstemp", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"senstemp", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "==", "decayBaseline"}], 
              "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"decdescr", "=", 
           RowBox[{
            RowBox[{"givenData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "3"}], "]"}], "]"}], "//", 
            "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"decgivenexp", "=", 
           RowBox[{"DialogInput", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                "Local", " ", "variables", " ", "with", " ", "defaults", " ", 
                 "must", " ", "be", " ", "assigned", " ", "via", " ", 
                 "\"\<=\>\""}], ",", 
                RowBox[{"not", " ", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"var", ",", "default"}], "}"}], "}"}], "."}]}]}], 
               "*)"}], 
              RowBox[{"choice", "=", 
               RowBox[{"decdescr", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"Column", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    "\"\<No decay description \>\"", ",", " ", 
                    "decayBaseline", ",", "\"\< for the given setup \>\"", 
                    ",", "exp", ",", 
