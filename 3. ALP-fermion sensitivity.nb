                RowBox[{"\"\<-Upper\>\"", "->", "\"\<\>\""}]}], "}"}]}], 
             "]"}], "&"}], "/@", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"missingWeights", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"missingDistr", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}], ")"}], "//",
          "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"DistrCombinationsSelectedFacility", "=", 
        RowBox[{"Select", "[", 
