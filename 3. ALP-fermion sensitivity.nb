            "Bold"}], "]"}], ",", 
          RowBox[{"PopupMenu", "[", 
           RowBox[{
            RowBox[{"Dynamic", "[", "choice", "]"}], ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Stop computation\>\"", 
              ",", "\"\<Continue anyway\>\""}], "}"}]}], "]"}], ",", 
          RowBox[{"Spacer", "[", "5", "]"}], ",", 
          RowBox[{"Button", "[", 
           RowBox[{"\"\<Proceed\>\"", ",", 
