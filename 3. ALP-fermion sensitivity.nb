   RowBox[{
    RowBox[{RowBox[{"senscomput", "[", RowBox[{"tbrem_", ",", "tdrell_", ",", "descr_"}], "]"}], ":=", RowBox[{"Block", "[", RowBox[{RowBox[{"{", "}"}], ",", RowBox[{RowBox[{"massranges", "=", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"massminmaxMerged", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", "0.125`"}], "}"}], ",", RowBox[{"{", RowBox[{"0.14`", ",", "0.538`"}], "}"}], ",", RowBox[{"{", RowBox[{"0.538`", ",", "0.94`"}], "}"}], ",", RowBox[{"{", RowBox[{"0.974`", ",", RowBox[{"massminmaxMerged", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "}"}]}], "}"}]}], ";", RowBox[{"Clear", "[", "NevTotMerged", "]"}], ";", RowBox[{RowBox[{"NevTotMerged", "[", RowBox[{"mLLP_", ",", "coupling_"}], "]"}], "=", RowBox[{"mergedSystem", "[", RowBox[{"tbrem", ",", "tdrell", ",", "descr", ",", "mLLP", ",", "coupling"}], "]"}]}], ";", RowBox[{"DistributeDefinitions", "[", RowBox[{"NevTotMerged", ",", "exclRes"}], "]"}], ";", RowBox[{"ParallelEvaluate", "[", RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"rules", "=", RowBox[{"Cases", "[", RowBox[{RowBox[{"DownValues", "[", "NevTotMerged", "]"}], ",", RowBox[{"ifun_InterpolatingFunction", "\[RuleDelayed]", RowBox[{"ifun", "\[Rule]", RowBox[{"ListInterpolation", "[", RowBox[{RowBox[{"Developer`ToPackedArray", "[", RowBox[{"ifun", "[", "\"ValuesOnGrid\"", "]"}], "]"}], ",", RowBox[{"ifun", "[", "\"Coordinates\"", "]"}], ",", RowBox[{"InterpolationOrder", "\[Rule]", RowBox[{"ifun", "[", "\"InterpolationOrder\"", "]"}]}]}], "]"}]}]}], ",", "\[Infinity]", ",", RowBox[{"Heads", "\[Rule]", "True"}]}], "]"}]}], "}"}], ",", RowBox[{RowBox[{RowBox[{"DownValues", "[", "NevTotMerged", "]"}], "=", RowBox[{"Replace", "[", RowBox[{RowBox[{"DownValues", "[", "NevTotMerged", "]"}], ",", "rules", ",", RowBox[{"{", RowBox[{"0", ",", "\[Infinity]"}], "}"}], ",", RowBox[{"Heads", "\[Rule]", "True"}]}], "]"}]}], ";"}]}], "]"}], ",", RowBox[{"DistributedContexts", "\[Rule]", "None"}]}], "]"}], ";", RowBox[{RowBox[{"{", RowBox[{"RegSens1", ",", "RegSens2", ",", "RegSens3", ",", "RegSens4"}], "}"}], "=", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"massBounds", "=", "massranges"}], ",", RowBox[{"couplingBounds", "=", "couplingminmaxMerged"}]}], "}"}], ",", RowBox[{"ParallelTable", "[", RowBox[{RowBox[{"RegionPlot", "[", RowBox[{RowBox[{RowBox[{"NevTotMerged", "[", RowBox[{SuperscriptBox["10", "m"], ",", SuperscriptBox["10", "c"]}], "]"}], " ", RowBox[{"exclRes", "[", SuperscriptBox["10", "m"], "]"}]}], ",", RowBox[{"{", RowBox[{"m", ",", RowBox[{"Log10", "[", RowBox[{RowBox[{"massBounds", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}], ",", RowBox[{"Log10", "[", RowBox[{RowBox[{"massBounds", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"c", ",", RowBox[{"Log10", "[", RowBox[{"couplingBounds", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}], ",", RowBox[{"Log10", "[", RowBox[{"couplingBounds", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}]}], "}"}], ",", RowBox[{"PlotPoints", "\[Rule]", "200"}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", "massBounds", "]"}], ",", "1"}], "}"}], ",", RowBox[{"Method", "\[Rule]", "\"CoarsestGrained\""}], ",", RowBox[{"DistributedContexts", "\[Rule]", "None"}]}], "]"}]}], "]"}]}], ";", RowBox[{"SensTemp", "=", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Cases", "[", RowBox[{RowBox[{"Normal", "[", "#1", "]"}], ",", RowBox[{RowBox[{"Line", "[", "x_", "]"}], "\[RuleDelayed]", "x"}], ",", "\[Infinity]"}], "]"}], "&"}], ")"}], "/@", RowBox[{"{", RowBox[{"RegSens1", ",", "RegSens2", ",", "RegSens3", ",", "RegSens4"}], "}"}]}]}], ";", RowBox[{"SensTemp1", "=", RowBox[{"Join", "[", RowBox[{RowBox[{"SensTemp", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", RowBox[{"SensTemp", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", RowBox[{"SensTemp", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",", RowBox[{"SensTemp", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], "]"}]}], ";", RowBox[{"Table", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{"{", RowBox[{SuperscriptBox["10", RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]], ",", SuperscriptBox["10", RowBox[{"#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]]}], "}"}], "&"}], ")"}], "/@", RowBox[{"SensTemp1", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", "SensTemp1", "]"}], ",", "1"}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
