Cell[BoxData[{RowBox[{"Do", "[", "\[IndentingNewLine]", RowBox[{RowBox[{"Do", "[", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{RowBox[{"NevIntOverall", "[", RowBox[{"exp", ",", "mLLP_", ",", "y_", ",", "descr"}], "]"}], "=", RowBox[{"Sum", "[", RowBox[{RowBox[{"NevInt", "[", RowBox[{"exp", ",", "mLLP", ",", "y", ",", "prod", ",", "descr"}], "]"}], ",", RowBox[{"{", RowBox[{"prod", ",", RowBox[{"ProductionChannelsBaseline", "[", "exp", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", RowBox[{"{", RowBox[{"descr", ",", RowBox[{"decaydescriptions", "[", "exp", "]"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", ",", RowBox[{"{", RowBox[{"exp", ",", "SelectedExperimentList"}], "}"}]}], "]"}], "\[IndentingNewLine]", RowBox[{RowBox[{"pt", "[", RowBox[{"exp_", ",", "mLLP_", ",", "descr_"}], "]"}], ":=", RowBox[{"If", "[", RowBox[{RowBox[{"MemberQ", "[", RowBox[{"SelectedExperimentList", ",", "exp"}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"LogLogPlot", "[", RowBox[{RowBox[{"Evaluate", "[", RowBox[{"Table", "[", RowBox[{RowBox[{"NevInt", "[", RowBox[{"exp", ",", "mLLP", ",", "y", ",", "prod", ",", "descr"}], "]"}], ",", RowBox[{"{", RowBox[{"prod", ",", RowBox[{"ProductionChannelsBaseline", "[", "exp", "]"}]}], "}"}]}], "]"}], "]"}], ",", RowBox[{"{", RowBox[{"y", ",", RowBox[{RowBox[{"couplingminmaxOverall", "[", "exp", "]"}], "[", RowBox[{"[", "1", "]"}], "]"}], ",", RowBox[{RowBox[{"couplingminmaxOverall", "[", "exp", "]"}], "[", RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", RowBox[{"PlotLegends", "\[Rule]", RowBox[{"Placed", "[", RowBox[{RowBox[{RowBox[{RowBox[{"Style", "[", RowBox[{"#", ",", "15"}], "]"}], "&"}], "/@", RowBox[{"ProductionChannelsBaseline", "[", "exp", "]"}]}], ",", "Right"}], "]"}]}], ",", RowBox[{"PlotRange", "->", RowBox[{"{", RowBox[{RowBox[{"couplingminmaxOverall", "[", "exp", "]"}], ",", RowBox[{"{", RowBox[{SuperscriptBox["10", RowBox[{"-", "2"}]], ",", RowBox[{"NevMaxOverall", "[", "exp", "]"}]}], "}"}]}], "}"}]}], ",", RowBox[{"