Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"!", "CondMerged"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{RowBox[{"SensitivityExtractor", "[", RowBox[{"exp_", ",", "SelectedProduction_", ",", "Npot_", ",", "NevMin_", ",", "decayDescr_"}], "]"}], ":=", RowBox[{"Block", "[", RowBox[{RowBox[{"{", "}"}], ",", RowBox[{RowBox[{"massranges", "=", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{"mminmaxOverall", "[", "exp", "]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", "0.125`"}], "}"}], ",", RowBox[{"{", RowBox[{"0.14`", ",", "0.538`"}], "}"}], ",", RowBox[{"{", RowBox[{"0.538`", ",", "0.94`"}], "}"}], ",", RowBox[{"{", RowBox[{"0.974`", ",", RowBox[{RowBox[{"mminmaxOverall", "[", "exp", "]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "}"}]}], "}"}]}], ";", RowBox[{"Clear", "[", "NevTot", "]"}], ";", RowBox[{RowBox[{"NevTot", "[", RowBox[{"mLLP_", ",", "finv_"}], "]"}], "=", RowBox[{UnderoverscriptBox["\[Sum]", "prod", "SelectedProduction"], RowBox[{"NevInt", "[", RowBox[{"exp", ",", "mLLP", ",", "finv", ",", "prod", ",", "decayDescr"}], "]"}]}]}], ";", RowBox[{"DistributeDefinitions", "[", RowBox[{"NevTot", ",", "exclRes"}], "]"}], ";", RowBox[{"ParallelEvaluate", "[", RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"rules", "=", RowBox[{"Cases", "[", RowBox[{RowBox[{"DownValues", "[", "NevTot", "]"}], ",", RowBox[{"ifun_InterpolatingFunction", "\[RuleDelayed]", RowBox[{"ifun", "\[Rule]", RowBox[{"ListInterpolation", "[", RowBox[{RowBox[{"Developer`ToPackedArray", "[", RowBox[{"ifun", "[", "\"ValuesOnGrid\"", "]"}], "]"}], ",", RowBox[{"ifun", "[", "\"Coordinates\"", "]"}], ",", RowBox[{"InterpolationOrder", "\[Rule]", RowBox[{"ifun", "[", "\"InterpolationOrder\"", "]"}]}]}], "]"}]}]}], ",", "\[Infinity]", ",", RowBox[{"Heads", "\[Rule]", "True"}]}], "]"}]}], "}"}], ",", RowBox[{RowBox[{RowBox[{"DownValues", "[", "NevTot", "]"}], "=", RowBox[{"Replace", "[", RowBox[{RowBox[{"DownValues", "[", "NevTot", "]"}], ",", "rules", ",", RowBox[{"{", RowBox[{"0", ",", "\[Infinity]"}], "}"}], ",", RowBox[{"Heads", "\[Rule]", "True"}]}], "]"}]}], ";"}]}], "]"}], ",", RowBox[{"DistributedContexts", "\[Rule]", "None"}]}], "]"}], ";", RowBox[{RowBox[{"{", RowBox[{"RegSens1", ",", "RegSens2", ",", "RegSens3", ",", "RegSens4"}], "}"}], "=", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"massBounds", "=", "massranges"}], ",", RowBox[{"couplingBounds", "=", RowBox[{"couplingminmaxOverall", "[", "exp", "]"}]}], ",", RowBox[{"exposureRatio", "=", FractionBox["Npot", RowBox[{"NpotDefault", "[", "exp", "]"}]]}], ",", RowBox[{"eventThreshold", "=", "NevMin"}]}], "}"}], ",", RowBox[{"ParallelTable", "[", RowBox[{RowBox[{"RegionPlot", "[", RowBox[{RowBox[{RowBox[{"exposureRatio", " ", RowBox[{"NevTot", "[", RowBox[{SuperscriptBox["10", "mLLP"], ",", SuperscriptBox["10", "ga"]}], "]"}], " ", RowBox[{"exclRes", "[", SuperscriptBox["10", "mLLP"], "]"}]}], "\[GreaterEqual]", "eventThreshold"}], ",", RowBox[{"{", RowBox[{"mLLP", ",", RowBox[{"Log10", "[", RowBox[{RowBox[{"massBounds", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}], ",", RowBox[{"Log10", "[", RowBox[{RowBox[{"massBounds", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"ga", ",", RowBox[{"Log10", "[", RowBox[{"couplingBounds", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}], ",", RowBox[{"Log10", "[", RowBox[{"couplingBounds", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}]}], "}"}], ",", RowBox[{"PlotPoints", "\[Rule]", "200"}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", "massBounds", "]"}], ",", "1"}], "}"}], ",", RowBox[{"Method", "\[Rule]", "\"CoarsestGrained\""}], ",", RowBox[{"DistributedContexts", "\[Rule]", "None"}]}], "]"}]}], "]"}]}], ";", RowBox[{"SensTemp", "=", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Cases", "[", RowBox[{RowBox[{"Normal", "[", "#1", "]"}], ",", RowBox[{RowBox[{"Line", "[", "x_", "]"}], "\[RuleDelayed]", "x"}], ",", "\[Infinity]"}], "]"}], "&"}], ")"}], "/@", RowBox[{"{", RowBox[{"RegSens1", ",", "RegSens2", ",", "RegSens3", ",", "RegSens4"}], "}"}]}]}], ";", RowBox[{"SensTemp1", "=", RowBox[{"Join", "[", RowBox[{RowBox[{"SensTemp", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", RowBox[{"SensTemp", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", RowBox[{"SensTemp", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",", RowBox[{"SensTemp", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], "]"}]}], ";", RowBox[{"Table", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{"{", RowBox[{SuperscriptBox["10", RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]], ",", SuperscriptBox["10", RowBox[{"#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]]}], "}"}], "&"}], ")"}], "/@", RowBox[{"SensTemp1", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", "SensTemp1", "]"}], ",", "1"}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
