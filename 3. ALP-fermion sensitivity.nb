 RowBox[{"DeleteDuplicates", "[", RowBox[{"SelectedProduction", "[", "exp", "]"}], "]"}]}]}], ";", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"!", RowBox[{"VectorQ", "[", RowBox[{RowBox[{"ProductionNoDrellYanBrem", "[", "exp", "]"}], ",", "StringQ"}], "]"}]}], "||", RowBox[{"!", RowBox[{"DuplicateFreeQ", "[", RowBox[{"ProductionNoDrellYanBrem", "[", "exp", "]"}], "]"}]}]}], ",", RowBox[{RowBox[{"Print", "[", RowBox[{"\"Cannot resolve each selected production channel exactly once: \"", ",", RowBox[{"SelectedProduction", "[", "exp", "]"}]}], "]"}], ";", RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"ProductionListUnc", "[", RowBox[{"exp", ",", "t"}], "]"}], "=", RowBox[{RowBox[{"Function", "[", RowBox[{"proc", ",", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"StringContainsQ", "[", RowBox[{"proc", ",", "\"Central\""}], "]"}], "&&", RowBox[{"SubsetQ", "[", RowBox[{RowBox[{"Join", "[", RowBox[{"brem", ",", "drell"}], "]"}], ",", RowBox[{RowBox[{"(", RowBox[{RowBox[{"StringReplace", "[", RowBox[{"proc", ",", RowBox[{"\"Central\"", "\[Rule]", "#1"}]}], "]"}], "&"}], ")"}], "/@", "uncchoices"}]}], "]"}]}], ",", RowBox[{"StringReplace", "[", RowBox[{"proc", ",", RowBox[{"\"Central\"", "\[Rule]", "t"}]}], "]"}], ",", "proc"}], "]"}]}], "]"}], "/@", RowBox[{"ProductionNoDrellYanBrem", "[", "exp", "]"}]}]}], ",", RowBox[{"{", RowBox[{"t", ",", "uncchoices"}], "}"}]}], "]"}], ";", RowBox[{RowBox[{"IfBremUnc", "[", "exp", "]"}], "=", RowBox[{RowBox[{"Select", "[", RowBox[{RowBox[{"ProductionListUnc", "[", RowBox[{"exp", ",", "\"Lower\""}], "]"}], ",", RowBox[{RowBox[{"StringContainsQ", "[", RowBox[{"#1", ",", "\"Bremsstrahlung\""}], "]"}], "&"}]}], "]"}], "=!=", RowBox[{"Select", "[", RowBox[{RowBox[{"ProductionListUnc", "[", RowBox[{"exp", ",", "\"Upper\""}], "]"}], ",", RowBox[{RowBox[{"StringContainsQ", "[", RowBox[{"#1", ",", "\"Bremsstrahlung\""}], "]"}], "&"}]}], "]"}]}]}], ";", RowBox[{RowBox[{"IfDrellYanUnc", "[", "exp", "]"}], "=", RowBox[{RowBox[{"Select", "[", RowBox[{RowBox[{"ProductionListUnc", "[", RowBox[{"exp", ",", "\"Lower\""}], "]"}], ",", RowBox[{RowBox[{"StringContainsQ", "[", RowBox[{"#1", ",", "\"DrellYan\""}], "]"}], "&"}]}], "]"}], "=!=", RowBox[{"Select", "[", RowBox[{RowBox[{"ProductionListUnc", "[", RowBox[{"exp", ",", "\"Upper\""}], "]"}], ",", RowBox[{RowBox[{"StringContainsQ", "[", RowBox[{"#1", ",", "\"DrellYan\""}], "]"}], "&"}]}], "]"}]}]}], ";", RowBox[{RowBox[{"IfProdUnc", "[", "exp", "]"}], "=", RowBox[{RowBox[{"IfBremUnc", "[", "exp", "]"}], "||", RowBox[{"IfDrellYanUnc", "[", "exp", "]"}]}]}]}]}], "]"}], ";"}], ",", RowBox[{"{", RowBox[{"exp", ",", "SelectedExperimentList"}], "}"}]}], "]"}], ";", RowBox[{"bremchmerged", "=", RowBox[{"DeleteDuplicates", "[", RowBox[{"Flatten", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"BremChannelsList", "[", "#1", "]"}], "&"}], ")"}], "/@", "SelectedExperimentList"}], "]"}], "]"}]}], ";", RowBox[{"IfBremUncMerged", "=", RowBox[{"Or", "@@", RowBox[{"IfBremUnc", "/@", "SelectedExperimentList"}]}]}], ";", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{RowBox[{"bremChoiceMerged", "[", "t", "]"}], "=", RowBox[{"If", "[", RowBox[{"IfBremUncMerged", ",", RowBox[{"First", "[", RowBox[{"Select", "[", RowBox[{RowBox[{"ProductionListUnc", "[", RowBox[{RowBox[{"SelectFirst", "[", RowBox[{"SelectedExperimentList", ",", RowBox[{RowBox[{"IfBremUnc", "[", "#1", "]"}], "&"}]}], "]"}], ",", "t"}], "]"}], ",", RowBox[{RowBox[{"StringContainsQ", "[", RowBox[{"#1", ",", "\"Bremsstrahlung\""}], "]"}], "&"}]}], "]"}], "]"}], ",", "\"None\""}], "]"}]}], ";"}], ",", RowBox[{"{", RowBox[{"t", ",", "uncchoices"}], "}"}]}], "]"}], ";", RowBox[{"drellchmerged", "=", RowBox[{"DeleteDuplicates", "[", RowBox[{"Flatten", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"DrellYanChannelsList", "[", "#1", "]"}], "&"}], ")"}], "/@", "SelectedExperimentList"}], "]"}], "]"}]}], ";", RowBox[{"IfDrellYanUncMerged", "=", RowBox[{"Or", "@@", RowBox[{"IfDrellYanUnc", "/@", "SelectedExperimentList"}]}]}], ";", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{RowBox[{"drellChoiceMerged", "[", "t", "]"}], "=", RowBox[{"If", "[", RowBox[{"IfDrellYanUncMerged", ",", RowBox[{"First", "[", RowBox[{"Select", "[", RowBox[{RowBox[{"ProductionListUnc", "[", RowBox[{RowBox[{"SelectFirst", "[", RowBox[{"SelectedExperimentList", ",", RowBox[{RowBox[{"IfDrellYanUnc", "[", "#1", "]"}], "&"}]}], "]"}], ",", "t"}], "]"}], ",", RowBox[{RowBox[{"StringContainsQ", "[", RowBox[{"#1", ",", "\"DrellYan\""}], "]"}], "&"}]}], "]"}], "]"}], ",", "\"None\""}], "]"}]}], ";"}], ",", RowBox[{"{", RowBox[{"t", ",", "uncchoices"}], "}"}]}], "]"}], ";", RowBox[{"couplingminmaxMerged", "=", RowBox[{"MinMax", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Join", "[", "##1", "]"}], "&"}], ")"}], "@@", RowBox[{RowBox[{"(", RowBox[{RowBox[{"couplingminmaxOverall", "[", "#1", "]"}], "&"}], ")"}], "/@", "SelectedExperimentList"}]}], "]"}]}], ";", RowBox[{"decaydescriptionsmerged", "=", RowBox[{"Intersection", "@@", RowBox[{"decaydescriptions", "/@", "SelectedExperimentList"}]}]}], ";", RowBox[{"massminmaxMerged", "=", RowBox[{"MinMax", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Join", "[", "##1", "]"}], "&"}], ")"}], "@@", RowBox[{RowBox[{"(", RowBox[{RowBox[{"mminmaxOverall", "[", "#1", "]"}], "&"}], ")"}], "/@", "SelectedExperimentList"}]}], "]"}]}], ";", RowBox[{"masslistMerged", "=", RowBox[{"DeleteDuplicates", "[", RowBox[{"Sort", "[", RowBox[{"DeleteDuplicates", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Join", "[", "##1", "]"}], "&"}], ")"}], "@@", RowBox[{RowBox[{"(", RowBox[{RowBox[{"mgridfull", "[", "#1", "]"}], "&"}], ")"}], "/@", "SelectedExperimentList"}]}], "]"}], "]"}], "]"}]}], ";", RowBox[{"couplinglistMerged", "=", RowBox[{"DeleteDuplicates", "[", RowBox[{"Sort", "[", RowBox[{"DeleteDuplicates", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Join", "[", "##1", "]"}], "&"}], ")"}], "@@", RowBox[{RowBox[{"(", RowBox[{RowBox[{"couplinggridfull", "[", "#1", "]"}], "&"}], ")"}], "/@", "SelectedExperimentList"}]}], "]"}], "]"}], "]"}]}], ";", RowBox[{RowBox[{"ResourceFunction", "[", "\"MonitorProgress\"", "]"}], "[", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{RowBox[{"ResourceFunction", "[", "\"MonitorProgress\"", "]"}], "[", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{RowBox[{"mergedSystem", "[", RowBox[{"tbrem", ",", "tdrell", ",", "descr", ",", "mLLP_", ",", "finv_"}], "]"}], "=", RowBox[{"{", "}"}]}], ";"}], ",", RowBox[{"{", RowBox[{"tbrem", ",", "uncchoices"}], "}"}], ",", RowBox[{"{", RowBox[{"tdrell", ",", "uncchoices"}], "}"}]}], "]"}], ";", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"prodmodes", "=", RowBox[{"Join", "[", RowBox[{RowBox[{"Select", "[", RowBox[{RowBox[{"ProductionListUnc", "[", RowBox[{"exp", ",", "tbrem"}], "]"}], ",", RowBox[{RowBox[{"!", RowBox[{"StringContainsQ", "[", RowBox[{"#1", ",", "\"DrellYan\""}], "]"}]}], "&"}]}], "]"}], ",", RowBox[{"Select", "[", RowBox[{RowBox[{"ProductionListUnc", "[", RowBox[{"exp", ",", "tdrell"}], "]"}], ",", RowBox[{RowBox[{"StringContainsQ", "[", RowBox[{"#1", ",", "\"DrellYan\""}], "]"}], "&"}]}], "]"}]}], "]"}]}], ";", RowBox[{RowBox[{"NevSummed", "[", RowBox[{"exp", ",", "tbrem", ",", "tdrell", ",", "descr", ",", "mLLP_", ",", "finv_"}], "]"}], "=", FractionBox[RowBox[{UnderoverscriptBox["\[Sum]", "prod", "prodmodes"], FractionBox[RowBox[{RowBox[{"NpotVal", "[", "exp", "]"}], " ", RowBox[{"NevInt", "[", RowBox[{"exp", ",", "mLLP", ",", "finv", ",", "prod", ",", "descr"}], "]"}]}], RowBox[{"NpotDefault", "[", "exp", "]"}]]}], RowBox[{"NevMinVal", "[", "exp", "]"}]]}], ";"}], ",", RowBox[{"{", RowBox[{"tbrem", ",", "uncchoices"}], "}"}], ",", RowBox[{"{", RowBox[{"tdrell", ",", "uncchoices"}], "}"}]}], "]"}], ";"}], ",", RowBox[{"{", RowBox[{"exp", ",", "SelectedExperimentList"}], "}"}]}], "]"}], "]"}], ";", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{RowBox[{"mergedSystem", "[", RowBox[{"tbrem", ",", "tdrell", ",", "descr", ",", "mLLP_", ",", "finv_"}], "]"}], "=", RowBox[{"{", RowBox[{RowBox[{"Max", "@@", RowBox[{RowBox[{"(", RowBox[{RowBox[{"NevSummed", "[", RowBox[{"#1", ",", "tbrem", ",", "tdrell", ",", "descr", ",", "mLLP", ",", "finv"}], "]"}], "&"}], ")"}], "/@", "SelectedExperimentList"}]}], "\[GreaterEqual]", "1"}], "}"}]}], ";"}], ",", RowBox[{"{", RowBox[{"tbrem", ",", "uncchoices"}], "}"}], ",", RowBox[{"{", RowBox[{"tdrell", ",", "uncchoices"}], "}"}]}], "]"}], ";"}], ",", RowBox[{"{", RowBox[{"descr", ",", "decaydescriptionsmerged"}], "}"}]}], "]"}], "]"}]}]}], "]"}]], "Input",
