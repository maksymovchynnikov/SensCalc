        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], ",", 
     "\"\<Select process\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"masssel", "=", 
  RowBox[{"selectionDialog", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"filenamepars", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", "fipsel"}], "&&", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "==", "procsel"}]}], "&"}]}], 
       "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "3"}], "]"}], "]"}], "//", "Sort"}], ",", 
    "\"\<Select masses:\>\""}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
