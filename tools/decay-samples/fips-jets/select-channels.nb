              RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "\"\<E\>\""}], 
           "]"}], "]"}], ",", "2", ",", "1", ",", "1"}], "]"}], "-", 
       RowBox[{"Threaded", "[", 
        RowBox[{"{", 
