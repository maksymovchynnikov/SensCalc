     RowBox[{
      RowBox[{"sel2", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}], "=", 
      RowBox[{"Length", "[", "sel", "]"}]}], ";", "\n", 
     RowBox[{"rangs", "=", "sel2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
