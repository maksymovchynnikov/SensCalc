 RowBox[{
  RowBox[{"procsel", "=", 
   RowBox[{"dropdownDialog", "[", 
    RowBox[{
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"filenamepars", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", "fipsel"}], "&"}]}], "]"}], 
