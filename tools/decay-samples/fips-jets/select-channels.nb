            RowBox[{"{", 
             RowBox[{"fip", ",", "process", ",", "mass"}], "}"}]}]}], "]"}]}],
         ",", "\"\<Table\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sel", "=", 
      RowBox[{"selection", "[", "file", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pdglist", "=", 
      RowBox[{"pdglistcomp", "[", 
       RowBox[{"sel", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<E\>\"", "->", "0"}], ",", 
          RowBox[{"\"\<P\>\"", "->", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Extracting", " ", "the", " ", "ranges", " ", "of", " ", "data", " ", 
       "rows", " ", "for", " ", "the", " ", "given", " ", "decay"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"sel2", "=", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"sel", "[", 
