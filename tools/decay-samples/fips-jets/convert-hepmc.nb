Cell[BoxData[
 RowBox[{
  RowBox[{"SelectingCommonestDecays1", "[", 
   RowBox[{"fip_", ",", "process_", ",", "mass_", ",", "nev_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"file", "=", 
      RowBox[{"Import", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], 
           ",", "\"\<Initial phase space\>\"", ",", 
           RowBox[{"ToString", "@", 
            RowBox[{"StringForm", "[", 
             RowBox[{"\"\<``_``_``.hepmc\>\"", ",", 
              RowBox[{"Sequence", "@@", 
               RowBox[{"{", 
                RowBox[{"fip", ",", "process", ",", "mass"}], "}"}]}]}], 
             "]"}]}]}], "}"}], "]"}], ",", "\"\<Table\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"filenameexport", "=", 
      RowBox[{"ToString", "@", 
       RowBox[{"StringForm", "[", 
        RowBox[{"\"\<Extracted phase space/``_``_``.wxf\>\"", ",", 
         RowBox[{"Sequence", "@@", 
          RowBox[{"{", 
           RowBox[{"fip", ",", "process", ",", "mass"}], "}"}]}]}], "]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"IfExists", "=", 
      RowBox[{"FileExistsQ", "[", "filenameexport", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", "IfExists"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"sel", "=", 
         RowBox[{"selection", "[", "file", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pdglist", "=", 
         RowBox[{"pdglistcomp", "[", 
          RowBox[{"sel", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<E\>\"", "->", "0"}], ",", 
             RowBox[{"\"\<P\>\"", "->", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Extracting", " ", "the", " ", "ranges", " ", "of", " ", "data", " ",
           "rows", " ", "for", " ", "the", " ", "given", " ", "decay"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"sel2", "=", 
         RowBox[{
          RowBox[{"Partition", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{"sel", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "\"\<E\>\""}], 
              "]"}], "]"}], ",", "2", ",", "1", ",", "1"}], "]"}], "-", 
          RowBox[{"Threaded", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], "]"}]}]}], ";", "\n", 
        RowBox[{
         RowBox[{"sel2", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}], "=", 
         RowBox[{"Length", "[", "sel", "]"}]}], ";", "\n", 
        RowBox[{"rangs", "=", "sel2"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "List", " ", "of", " ", "tables", " ", "with", " ", "decay", " ", 
          "products", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"data", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"sel", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"#1", "+", "1"}], ";;", "#2"}], "]"}], "]"}], "&"}],
               "@@", 
              RowBox[{"rangs", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "/.", 
             RowBox[{"{", 
              RowBox[{"\"\<E\>\"", "->", "i"}], "}"}]}], ")"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "rangs", "]"}], ",", "1"}], 
            "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Converting", " ", 
          RowBox[{"the", " ", ".", "hepmc"}], " ", "output", " ", "to", " ", 
          "SensCalc", " ", "input"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"outtemp", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"currentData", "=", 
               RowBox[{"data", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"px", "=", 
                  RowBox[{"currentData", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ",", 
                 RowBox[{"py", "=", 
                  RowBox[{"currentData", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "5"}], "]"}], "]"}]}], ",", 
                 RowBox[{"pz", "=", 
                  RowBox[{"currentData", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "6"}], "]"}], "]"}]}], ",", 
                 RowBox[{"ev", "=", 
                  RowBox[{"currentData", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "7"}], "]"}], "]"}]}], ",", 
                 RowBox[{"particleIds", "=", 
                  RowBox[{"IntegerPart", "[", 
                   RowBox[{"currentData", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}]}], "}"}],
                ",", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"px", ",", "py", ",", "pz", ",", "ev", ",", 
                  SqrtBox[
                   RowBox[{
                    SuperscriptBox["ev", "2"], "-", 
                    SuperscriptBox["px", "2"], "-", 
                    SuperscriptBox["py", "2"], "-", 
                    SuperscriptBox["pz", "2"]}]], ",", 
                  RowBox[{"N", "[", "particleIds", "]"}], ",", 
                  RowBox[{"N", "[", 
                   RowBox[{
                   "DecayProductElectricCharge", "/@", "particleIds"}], "]"}],
                   ",", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{"1.", ",", 
                    RowBox[{"Length", "[", "currentData", "]"}]}], "]"}]}], 
                 "}"}], "//", "Transpose"}]}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"outtemp", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Flatten", "/@", "outtemp"}], ")"}], "/.", " ", 
          RowBox[{
           RowBox[{"x_Complex", "/;", 
            RowBox[{
             RowBox[{"Im", "[", "x", "]"}], "!=", "0"}]}], "->", "0"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"out", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"PadRight", "[", 
            RowBox[{"outtemp", ",", "Automatic", ",", 
             RowBox[{"-", "999."}]}], "]"}], "//", "N"}], "//", 
          "Developer`ToPackedArray"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"out", "=", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"RandomSample", "[", "out", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"Min", "[", 
              RowBox[{"nev", ",", 
               RowBox[{"Length", "[", "out", "]"}]}], "]"}]}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"filenameexport", "=", 
         RowBox[{"ToString", "@", 
          RowBox[{"StringForm", "[", 
           RowBox[{"\"\<Extracted phase space/``_``_``.wxf\>\"", ",", 
            RowBox[{"Sequence", "@@", 
             RowBox[{"{", 
              RowBox[{"fip", ",", "process", ",", "mass"}], "}"}]}]}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"target", "=", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "filenameexport"}], "}"}], "]"}]}], ",", "temporary", ",", "stream", ",", "legacy"}], "}"}], ",", RowBox[{RowBox[{"temporary", "=", RowBox[{"target", "<>", "\".tmp\""}]}], ";", RowBox[{"stream", "=", RowBox[{"OpenWrite", "[", RowBox[{"temporary", ",", RowBox[{"BinaryFormat", "\[Rule]", "True"}]}], "]"}]}], ";", RowBox[{"BinaryWrite", "[", RowBox[{"stream", ",", RowBox[{"BinarySerialize", "[", RowBox[{"out", ",", RowBox[{"PerformanceGoal", "\[Rule]", "\"Size\""}]}], "]"}]}], "]"}], ";", RowBox[{"Close", "[", "stream", "]"}], ";", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"BinarySerialize", "[", RowBox[{RowBox[{"BinaryDeserialize", "[", RowBox[{"ReadByteArray", "[", "temporary", "]"}], "]"}], ",", RowBox[{"PerformanceGoal", "\[Rule]", "\"Speed\""}]}], "]"}], "=!=", RowBox[{"BinarySerialize", "[", RowBox[{"out", ",", RowBox[{"PerformanceGoal", "\[Rule]", "\"Speed\""}]}], "]"}]}], ",", RowBox[{RowBox[{"Print", "[", RowBox[{"\"ROUNDTRIP FAILED \"", ",", "target"}], "]"}], ";", RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"RenameFile", "[", RowBox[{"temporary", ",", "target", ",", RowBox[{"OverwriteTarget", "\[Rule]", "True"}]}], "]"}], "===", "$Failed"}], ",", RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", RowBox[{"legacy", "=", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"DirectoryName", "[", "target", "]"}], ",", RowBox[{RowBox[{"FileBaseName", "[", "target", "]"}], "<>", "\".m\""}]}], "}"}], "]"}]}], ";", RowBox[{"If", "[", RowBox[{RowBox[{"FileExistsQ", "[", "legacy", "]"}], ",", RowBox[{"DeleteFile", "[", "legacy", "]"}]}], "]"}], ";", "target"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
