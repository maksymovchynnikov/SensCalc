Cell[BoxData[
 RowBox[{
  RowBox[{"SelectingCommonestDecays", "[", 
   RowBox[{"fip_", ",", "process_", ",", "mass_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"file", "=", 
      RowBox[{"Import", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", 
           "\"\<Initial phase space\>\"", ",", 
           RowBox[{"ToString", "@", 
            RowBox[{"StringForm", "[", 
             RowBox[{"\"\<``_``_``.hepmc\>\"", ",", 
              RowBox[{"Sequence", "@@", 
               RowBox[{"{", 
                RowBox[{"fip", ",", "process", ",", "mass"}], "}"}]}]}], 
             "]"}]}]}], "}"}], "]"}], ",", "\"\<Table\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sel", "=", 
      RowBox[{"selection", "[", "file", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pdglist", "=", 
      RowBox[{"pdglistcomp", "[", 
       RowBox[{"sel", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<E\>\"", "->", "0"}], ",", 
          RowBox[{"\"\<P\>\"", "->", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Extracting", " ", "the", " ", "ranges", " ", "of", " ", "data", " ", 
       "rows", " ", "for", " ", "the", " ", "given", " ", "decay"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"sel2", "=", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"sel", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "\"\<E\>\""}], 
           "]"}], "]"}], ",", "2", ",", "1", ",", "1"}], "]"}], "-", 
       RowBox[{"Threaded", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], "]"}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"sel2", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}], "=", 
      RowBox[{"Length", "[", "sel", "]"}]}], ";", "\n", 
     RowBox[{"rangs", "=", "sel2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "List", " ", "of", " ", "tables", " ", "with", " ", "decay", " ", 
       "products", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"sel", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"#1", "+", "1"}], ";;", "#2"}], "]"}], "]"}], "&"}], "@@", 
           RowBox[{"rangs", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "/.", 
          RowBox[{"{", 
           RowBox[{"\"\<E\>\"", "->", "i"}], "}"}]}], ")"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "rangs", "]"}], ",", "1"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "list", " ", "with", " ", "pdg", " ", "ids", " ", "of", " ",
        "the", " ", "decay", " ", "products", " ", "for", " ", "decays"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"data1temp", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"data", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "3"}], "]"}], "]"}], "//", "Sort"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "data", "]"}], ",", "1"}], "}"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"data1", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"data1temp", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "//", "N"}], ",", 
           RowBox[{
            RowBox[{"#", "==", 
             RowBox[{"pdglist", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "&"}]}], "]"}], "//", 
         "Length"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "[", "data1temp", "]"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "pdglist", "]"}], ",", "1"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "7", " ", "commonest", " ", "decay", " ", "products", " ", 
       "sets"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"commonestdecay7", "=", 
      RowBox[{"Commonest", "[", 
       RowBox[{"data1", ",", "7"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"commonesttable", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"Count", "[", 
             RowBox[{"data1", ",", 
              RowBox[{"First", "@", "#"}]}], "]"}]}], "}"}], "&"}], "@", 
         RowBox[{"commonestdecay7", "[", 
          RowBox[{"[", 
           RowBox[{"{", "i", "}"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "commonestdecay7", "]"}], ",", "1"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"commonestdecaytemp", "=", 
      RowBox[{"selectionDialog", "[", 
       RowBox[{"commonesttable", ",", "pdglist"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"commonestdecay", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"commonestdecaytemp", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "commonestdecaytemp", "]"}], ",", "1"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"datacommonestdecaytemp", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Partition", "[", 
              RowBox[{"data1", ",", "1"}], "]"}], ",", 
             RowBox[{"Partition", "[", 
              RowBox[{"data", ",", "1"}], "]"}], ",", "2"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", 
             RowBox[{"commonestdecay", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "&"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "commonestdecay", "]"}], ",", "1"}], "}"}]}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"datacommonestdecay", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Length", "[", "datacommonestdecaytemp", "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"ratiosdecaysTemp", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"Length", "[", 
           RowBox[{"datacommonestdecaytemp", "[", 
            RowBox[{"[", "m", "]"}], "]"}], "]"}], 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"datacommonestdecaytemp", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"Length", "[", "datacommonestdecaytemp", "]"}], ",", 
              "1"}], "}"}]}], "]"}]], "//", "N"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", 
          RowBox[{"Length", "[", "datacommonestdecaytemp", "]"}], ",", "1"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ratiosdecays", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{"ratiosdecaysTemp", ",", 
          RowBox[{"-", "1"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"{", "1", "}"}], "-", 
         RowBox[{"Total", "[", 
          RowBox[{"Drop", "[", 
           RowBox[{"Drop", "[", 
            RowBox[{"ratiosdecaysTemp", ",", 
             RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"datacommonestdecay", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "4", "]"}], "]"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "5", "]"}], "]"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "6", "]"}], "]"}], ",", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"#", "[", 
                   RowBox[{"[", "4", "]"}], "]"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"#", "[", 
                   RowBox[{"[", "5", "]"}], "]"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"#", "[", 
                   RowBox[{"[", "6", "]"}], "]"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"mproduct", "[", 
                   RowBox[{"IntegerPart", "[", 
