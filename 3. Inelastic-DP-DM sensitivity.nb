Cell[CellGroupData[{

Cell["Sensitivity calculator block", "Subsection",
 CellChangeTimes->{{3.9344284768399067`*^9, 3.9344284803812065`*^9}, {
  3.9345997252424593`*^9, 3.934599726886627*^9}},
