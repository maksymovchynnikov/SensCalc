              RowBox[{"(", 
               RowBox[{"#", "//", "MinMax"}], ")"}], "&"}], "/@", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"mgrid", "[", 
                RowBox[{"exp", ",", "prod", ",", "decayDescr"}], "]"}], ",", 
               RowBox[{"couplinggrid", "[", 
                RowBox[{"exp", ",", "prod", ",", "decayDescr"}], "]"}]}], 
              "}"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"NevMax", "[", 
             RowBox[{"exp", ",", "prod", ",", "decayDescr"}], "]"}], "=", 
            RowBox[{
             RowBox[{
              RowBox[{"NeventsTabulated", "[", 
               RowBox[{"exp", ",", "prod", ",", "decayDescr"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "3"}], "]"}], "]"}], "//", "Max"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"NevInt", "[", 
             RowBox[{
             "exp", ",", "mLLP_", ",", "y_", ",", "prod", ",", "decayDescr"}],
              "]"}], "=", 
            RowBox[{
             RowBox[{"\[Epsilon]reco", "[", "mLLP", "]"}], "*", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"mminmax", "[", 
                   RowBox[{"exp", ",", "prod", ",", "decayDescr"}], "]"}], 
                  "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "\[LessEqual]", " ", "mLLP",
                  "\[LessEqual]", 
                 RowBox[{
                  RowBox[{"mminmax", "[", 
                   RowBox[{"exp", ",", "prod", ",", "decayDescr"}], "]"}], 
                  "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "&&", 
                RowBox[{
                 RowBox[{
                  RowBox[{"couplingminmax", "[", 
                   RowBox[{"exp", ",", "prod", ",", "decayDescr"}], "]"}], 
                  "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "\[LessEqual]", "y", 
                 "\[LessEqual]", 
                 RowBox[{
                  RowBox[{"couplingminmax", "[", 
                   RowBox[{"exp", ",", "prod", ",", "decayDescr"}], "]"}], 
                  "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
               RowBox[{"Evaluate", "[", 
                RowBox[{"10", "^", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Interpolation", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Log10", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                    RowBox[{"Log10", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
                    RowBox[{"Log10", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "+", 
                    SuperscriptBox["10", 
                    RowBox[{"-", "90"}]]}], "]"}]}], "}"}], "&"}], "/@", 
                    RowBox[{"NeventsTabulated", "[", 
                    RowBox[{"exp", ",", "prod", ",", "decayDescr"}], "]"}]}], 
                    ",", 
                    RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}], 
                   "[", 
                   RowBox[{
                    RowBox[{"Log10", "[", "mLLP", "]"}], ",", 
                    RowBox[{"Log10", "[", "y", "]"}]}], "]"}], ")"}]}], "]"}],
                ",", "0"}], "]"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "ProductionInfoList", "]"}], ",", "1"}], 
         "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mminmaxOverall", "[", "exp", "]"}], ",", 
         RowBox[{"couplingminmaxOverall", "[", "exp", "]"}]}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"MinMax", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"exp", ",", "prod", ",", "dec"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"prod", ",", 
               RowBox[{"ProductionChannelsList", "[", "exp", "]"}]}], "}"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"dec", ",", 
               RowBox[{"decaydescriptions", "[", "exp", "]"}]}], "}"}]}], 
            "]"}], "//", "Flatten"}], "]"}], "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{"mminmax", ",", "couplingminmax"}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"NevMaxOverall", "[", "exp", "]"}], "=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"NeventsTabulated", "[", 
              RowBox[{"exp", ",", "#", ",", "descr"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "3"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"descr", ",", 
              RowBox[{"decaydescriptions", "[", "exp", "]"}]}], "}"}]}], 
           "]"}], "&"}], "/@", 
         RowBox[{"ProductionChannelsList", "[", "exp", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"OutputName", "[", "exp", "]"}], "=", "exp"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"directoryOutput", "[", "exp", "]"}], "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"directory", "[", "\"\<Sensitivity-LLP\>\"", "]"}], ",", 
          RowBox[{"OutputName", "[", "exp", "]"}]}], "}"}], "]"}]}], ";"}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"exp", ",", "SelectedExperimentList"}], "}"}]}], "]"}]}], "//", 
  "AbsoluteTiming"}]}], "Input",
