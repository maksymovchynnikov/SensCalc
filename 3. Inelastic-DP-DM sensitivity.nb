Cell[BoxData[{RowBox[{RowBox[{RowBox[{"{", RowBox[{"sens", ",", "sensregions", ",", "descriptors", ",", "NpotVal", ",", "NevMinVal", ",", "SelectedProduction"}], "}"}], "//", "Clear"}], ";"}], "\[IndentingNewLine]", RowBox[{"Do", "[", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"productionlist", "=", RowBox[{"Join", "[", RowBox[{RowBox[{"{", "\"All\"", "}"}], ",", RowBox[{"ProductionChannelsListUnified", "[", "exp", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"DynamicModule", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"input1", "=", RowBox[{"NpotDefault", "[", "exp", "]"}]}], ",", RowBox[{"input2", "=", "2.3"}], ",", RowBox[{"choice", "=", RowBox[{"{", "\"All\"", "}"}]}], ",", "list", ",", "phrase"}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"DialogInput", "[", RowBox[{"Column", "[", RowBox[{"{", RowBox[{RowBox[{"Style", "[", RowBox[{"exp", ",", "Bold"}], "]"}], ",", RowBox[{"TextCell", "[", "\"Enter the number of proton collisions:\"", "]"}], ",", RowBox[{"InputField", "[", RowBox[{RowBox[{"Dynamic", "[", "input1", "]"}], ",", "Expression"}], "]"}], ",", RowBox[{"TextCell", "[", "\"Enter the value of N_ev,min for which the sensitivity will be computed:\"", "]"}], ",", RowBox[{"InputField", "[", RowBox[{RowBox[{"Dynamic", "[", "input2", "]"}], ",", "Expression"}], "]"}], ",", RowBox[{"Row", "[", RowBox[{"{", "\"Select the production channels to be used for the sensitivity calculation:\"", "}"}], "]"}], ",", RowBox[{"Pane", "[", RowBox[{RowBox[{"TogglerBar", "[", RowBox[{RowBox[{"Dynamic", "[", "choice", "]"}], ",", "productionlist", ",", RowBox[{"Appearance", "->", RowBox[{"\"Vertical\"", "->", RowBox[{"{", RowBox[{"Automatic", ",", "1"}], "}"}]}]}]}], "]"}], ",", RowBox[{"ImageSize", "->", RowBox[{"{", RowBox[{"Automatic", ",", "Automatic"}], "}"}]}], ",", RowBox[{"Scrollbars", "->", RowBox[{"{", RowBox[{"False", ",", "True"}], "}"}]}]}], "]"}], ",", RowBox[{"Button", "[", RowBox[{"\"Submit\"", ",", RowBox[{"DialogReturn", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"NpotVal", "[", "exp", "]"}], ",", RowBox[{"NevMinVal", "[", "exp", "]"}], ",", RowBox[{"SelectedProduction", "[", "exp", "]"}]}], "}"}], "=", RowBox[{RowBox[{"{", RowBox[{"input1", ",", "input2", ",", "choice"}], "}"}], "//", "N"}]}], "]"}], ",", RowBox[{"ImageSize", "->", "Automatic"}]}], "]"}]}], "}"}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{"MemberQ", "[", RowBox[{RowBox[{"SelectedProduction", "[", "exp", "]"}], ",", "\"All\""}], "]"}], ",", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"SelectedProduction", "[", "exp", "]"}], "=", RowBox[{"ProductionChannelsListUnified", "[", "exp", "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", RowBox[{"{", RowBox[{"exp", ",", "SelectedExperimentList"}], "}"}]}], "]"}], "\[IndentingNewLine]", RowBox[{RowBox[{"Print", "[", RowBox[{RowBox[{"Join", "[", RowBox[{RowBox[{"{", RowBox[{"{", RowBox[{"\"Experiment\"", ",", "\"\!\(\*SubscriptBox[\(N\), \(PoT\)]\) for computation\"", ",", "\"\!\(\*SubscriptBox[\(N\), \(ev, min\)]\)\"", ",", "\"Selected production modes\"", ",", "\"Decay descriptions\""}], "}"}], "}"}], ",", RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{"exp", ",", RowBox[{"NpotVal", "[", "exp", "]"}], ",", RowBox[{"NevMinVal", "[", "exp", "]"}], ",", RowBox[{"SelectedProduction", "[", "exp", "]"}], ",", RowBox[{"decaydescriptions", "[", "exp", "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"exp", ",", "SelectedExperimentList"}], "}"}]}], "]"}]}], "]"}], "//", "TableForm"}], "]"}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"exclRes", "[", "mLLP_", "]"}], "=", RowBox[{"Boole", "[", RowBox[{"!", RowBox[{"(", RowBox[{RowBox[{"0.125", "<", "mLLP", "<", "0.14"}], "||", RowBox[{"0.538", "<", "mLLP", "<", "0.555"}], "||", RowBox[{"0.94", "<", "mLLP", "<", "0.974"}]}], ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "Input",
