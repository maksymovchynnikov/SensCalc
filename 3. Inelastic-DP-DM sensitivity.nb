Cell[BoxData[{
 RowBox[{
  RowBox[{"npts", "=", "300"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SensitivityExtractor", "[", 
   RowBox[{
   "exp_", ",", "SelectedProduction_", ",", "Npot_", ",", "NevMin_", ",", 
    "decayDescr_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"RegSens", ",", "SensTemp"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"NevTot", "[", 
       RowBox[{"mLLP_", ",", "\[Epsilon]2_"}], "]"}], "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"NevInt", "[", 
         RowBox[{
         "exp", ",", "mLLP", ",", "\[Epsilon]2", ",", "prod", ",", 
          "decayDescr"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"prod", ",", "SelectedProduction"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"RegSens", "=", 
      RowBox[{"RegionPlot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox["Npot", 
           RowBox[{"NpotDefault", "[", "exp", "]"}]], 
          RowBox[{"NevTot", "[", 
           RowBox[{
            SuperscriptBox["10", "mLLP"], ",", 
            SuperscriptBox["10", "\[Epsilon]2"]}], "]"}]}], "\[GreaterEqual]",
          "NevMin"}], ",", 
        RowBox[{"{", 
         RowBox[{"mLLP", ",", 
          RowBox[{"Log10", "[", 
           RowBox[{
            RowBox[{"mminmaxOverall", "[", "exp", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Log10", "[", 
           RowBox[{
            RowBox[{"mminmaxOverall", "[", "exp", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Epsilon]2", ",", 
          RowBox[{"Log10", "[", 
           RowBox[{
            RowBox[{"couplingminmaxOverall", "[", "exp", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Log10", "[", 
           RowBox[{
            RowBox[{"couplingminmaxOverall", "[", "exp", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"PlotPoints", "->", "npts"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"SensTemp", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Normal", "@", "RegSens"}], ",", 
        RowBox[{
         RowBox[{"Line", "[", "x_", "]"}], "\[RuleDelayed]", "x"}], ",", 
        "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"m\[Chi]1valm\[Chi]2", "[", 
            RowBox[{"10", "^", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"10", "^", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "&"}], "/@", 
        RowBox[{"SensTemp", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "SensTemp", "]"}], ",", "1"}], "}"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SensitivityExtractorOverall", "[", 
   RowBox[{"exp_", ",", "Npot_", ",", "NevMin_", ",", "decayDescr_"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bremch", ",", "selprod", ",", "drellyanch", ",", "bremdescr", ",", 
      "drelyandescr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tabsens", "=", 
      RowBox[{"{", 
       RowBox[{"{", "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], "@", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"prodch", "=", 
          RowBox[{"{", 
           RowBox[{"\"\<Total-\>\"", "<>", "descr"}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tabsens", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"tabsens", ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"prodch", ",", "descr", ",", "decayDescr", ",", 
               RowBox[{"SensitivityExtractor", "[", 
                RowBox[{
                "exp", ",", "prodch", ",", "Npot", ",", "NevMin", ",", 
                 "decayDescr"}], "]"}]}], "}"}], "}"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"descr", ",", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Central\>\"", ",", "\"\<Lower\>\"", ",", "\"\<Upper\>\""}], 
           "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tabsens", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{"tabsens", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "tabsens"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SensitivityBlock", "[", 
   RowBox[{"exp_", ",", "NevMin_", ",", "Npot_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TabSens", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"SensitivityExtractorOverall", "[", 
           RowBox[{"exp", ",", "Npot", ",", "NevMin", ",", "decayDescr"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"decayDescr", ",", 
            RowBox[{"decaydescriptions", "[", "exp", "]"}]}], "}"}]}], "]"}], 
        ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"filenameexport", "=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"stem", "=", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"directory", "[", "\"Sensitivity-LLP\"", "]"}], ",", RowBox[{"ExperimentFolder", "[", "exp", "]"}], ",", RowBox[{"ToString", "[", RowBox[{"StringForm", "[", RowBox[{"\"Sensitivity_``_at_``_Nev=``_Npot=``.\"", ",", RowBox[{"Sequence", "@@", RowBox[{"{", RowBox[{"LLPdirName", ",", RowBox[{"ExperimentFolder", "[", "exp", "]"}], ",", RowBox[{"ToString", "[", "NevMin", "]"}], ",", RowBox[{"ToString", "[", RowBox[{"CForm", "[", RowBox[{"SetPrecision", "[", RowBox[{RowBox[{"N", "[", "Npot", "]"}], ",", "3"}], "]"}], "]"}], "]"}]}], "}"}]}]}], "]"}], "]"}]}], "}"}], "]"}]}], ",", RowBox[{"configuration", "=", RowBox[{"Association", "[", RowBox[{RowBox[{"\"Model\"", "\[Rule]", "LLPdirName"}], ",", RowBox[{"\"Experiment\"", "\[Rule]", RowBox[{"ExperimentFolder", "[", "exp", "]"}]}], ",", RowBox[{"\"Exposure\"", "\[Rule]", "Npot"}], ",", RowBox[{"\"Event threshold\"", "\[Rule]", "NevMin"}], ",", RowBox[{"\"Selected production\"", "\[Rule]", RowBox[{"Sort", "[", RowBox[{"DeleteDuplicates", "[", "SelectedProduction", "]"}], "]"}]}], ",", RowBox[{"\"Decay descriptions\"", "\[Rule]", RowBox[{"DeleteDuplicates", "[", RowBox[{"TabSens", "\[LeftDoubleBracket]", RowBox[{"All", ",", RowBox[{"-", "2"}]}], "\[RightDoubleBracket]"}], "]"}]}]}], "]"}]}]}], "}"}], ",", RowBox[{RowBox[{"Export", "[", RowBox[{RowBox[{"stem", "<>", "\"metadata.json\""}], ",", "configuration", ",", "\"RawJSON\""}], "]"}], ";", "stem"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"assocData", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Association", "[", 
          RowBox[{
           RowBox[{"\"\<Production modes\>\"", "->", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Production uncertainty\>\"", "->", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Decay description\>\"", "->", 
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Sensitivity domains\>\"", "->", 
            RowBox[{"#", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}]}], "]"}], "&"}], ",", 
        "TabSens"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"filenameexport", "<>", "\"\<mx\>\""}], ",", "TabSens", ",", 
       "\"\<MX\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"filenameexport", "<>", "\"\<json\>\""}], ",", "assocData", 
       ",", "\"\<JSON\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", "TabSens", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Import", "[", 
      RowBox[{
       RowBox[{"filenameexport", "<>", "\"\<mx\>\""}], ",", "\"\<MX\>\""}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SensitivityExtractorUnc", "[", 
   RowBox[{"exp_", ",", "Npot_", ",", "NevMin_", ",", "decayDescr_"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"RegSens", ",", "SensTemp"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"NevTotLower", "[", 
       RowBox[{"mLLP_", ",", "\[Epsilon]2_"}], "]"}], "=", 
      RowBox[{
       FractionBox["Npot", 
        RowBox[{"NpotDefault", "[", "exp", "]"}]], 
       RowBox[{"NevInt", "[", 
        RowBox[{
        "exp", ",", "mLLP", ",", "\[Epsilon]2", ",", "\"\<Total-Lower\>\"", 
         ",", "decayDescr"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"NevTotUpper", "[", 
       RowBox[{"mLLP_", ",", "\[Epsilon]2_"}], "]"}], "=", 
      RowBox[{
       FractionBox["Npot", 
        RowBox[{"NpotDefault", "[", "exp", "]"}]], 
       RowBox[{"NevInt", "[", 
        RowBox[{
        "exp", ",", "mLLP", ",", "\[Epsilon]2", ",", "\"\<Total-Upper\>\"", 
         ",", "decayDescr"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"RegSens", "=", 
      RowBox[{"RegionPlot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"NevTotLower", "[", 
           RowBox[{
            SuperscriptBox["10", "mLLP"], ",", 
            SuperscriptBox["10", "\[Epsilon]2"]}], "]"}], "<=", "NevMin"}], "&&", 
         RowBox[{
          RowBox[{"NevTotUpper", "[", 
           RowBox[{
            SuperscriptBox["10", "mLLP"], ",", 
            SuperscriptBox["10", "\[Epsilon]2"]}], "]"}], ">=", "NevMin"}]}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"mLLP", ",", 
          RowBox[{"Log10", "[", 
           RowBox[{
            RowBox[{"mminmaxOverall", "[", "exp", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Log10", "[", 
           RowBox[{
            RowBox[{"mminmaxOverall", "[", "exp", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Epsilon]2", ",", 
          RowBox[{"Log10", "[", 
           RowBox[{
            RowBox[{"couplingminmaxOverall", "[", "exp", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Log10", "[", 
           RowBox[{
            RowBox[{"couplingminmaxOverall", "[", "exp", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"PlotPoints", "->", "npts"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"SensTemp", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Normal", "@", "RegSens"}], ",", 
        RowBox[{
         RowBox[{"Line", "[", "x_", "]"}], "\[RuleDelayed]", "x"}], ",", 
        "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"m\[Chi]1valm\[Chi]2", "[", 
            RowBox[{"10", "^", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"10", "^", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "&"}], "/@", 
        RowBox[{"SensTemp", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "SensTemp", "]"}], ",", "1"}], "}"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
