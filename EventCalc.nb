Cell[BoxData[
 RowBox[{
  RowBox[{"NeventsBlock", "[", 
   RowBox[{"mass_", ",", "coupling1_", ",", "coupling2_", ",", "Nevents_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", RowBox[{"c1", ",", "c2", ",", "m1", ",", "eventRunDirectory"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"llpinfodata", ",", "decayproductsdata"}], "}"}], "=", 
      RowBox[{"SimulateFullEvent", "[", 
       RowBox[{"mass", ",", "coupling1", ",", "coupling2", ",", "Nevents"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Computing", " ", "the", " ", "number", " ", "of", " ", "events", " ", 
       "with", " ", "decays", " ", "of", " ", "LLPs"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"NeventsVal", "=", 
      RowBox[{"NeventsLLP", "[", "llpinfodata", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Converting", " ", "the", " ", "parameters", " ", "to", " ", 
       "strings"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c1", ",", "c2"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ToString", "[", 
         RowBox[{"ScientificForm", "[", 
          RowBox[{
           RowBox[{"N", "[", "#", "]"}], ",", 
           RowBox[{"NumberFormat", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"#1", ",", "\"\<e\>\"", ",", "#3"}], "}"}], "]"}], 
              "&"}], ")"}]}]}], "]"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"coupling1", ",", "coupling2"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{RowBox[{"m1", "=", RowBox[{"ToString", "[", "mass", "]"}]}], ";", RowBox[{"eventRunDirectory", "=", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"Sampled Nevents\"", ",", "GivenExperiment", ",", "LLPdirName", ",", RowBox[{"\"run-\"", "<>", RowBox[{"CreateUUID", "[", "]"}]}]}], "}"}], "]"}]}], ";", RowBox[{"Export", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"eventRunDirectory", ",", "\"metadata.json\""}], "}"}], "]"}], ",", RowBox[{"Association", "[", RowBox[{RowBox[{"\"Model\"", "\[Rule]", "LLPdirName"}], ",", RowBox[{"\"Experiment\"", "\[Rule]", "GivenExperiment"}], ",", RowBox[{"\"Facility\"", "\[Rule]", "FacilitySelected"}], ",", RowBox[{"\"Mass (GeV)\"", "\[Rule]", "mass"}], ",", RowBox[{"\"Coupling 1\"", "\[Rule]", "coupling1"}], ",", RowBox[{"\"Coupling 2\"", "\[Rule]", "coupling2"}], ",", RowBox[{"\"Sample count\"", "\[Rule]", "Nevents"}], ",", RowBox[{"\"Production channels\"", "\[Rule]", RowBox[{"Sort", "[", "ProdChannelsSelected", "]"}]}], ",", RowBox[{"\"Decay channels\"", "\[Rule]", RowBox[{"Sort", "[", "ListDecaysLLPselected", "]"}]}], ",", RowBox[{"\"Decay description\"", "\[Rule]", "decayDescrSelected"}], ",", RowBox[{"\"HNL mixing pattern\"", "\[Rule]", RowBox[{"If", "[", RowBox[{RowBox[{"LLPdirName", "\[Equal]", "\"HNL\""}], ",", "MixingPattern", ",", RowBox[{"{", "}"}]}], "]"}]}], ",", RowBox[{"\"LLP columns\"", "\[Rule]", "14"}], ",", RowBox[{"\"Daughter columns per particle\"", "\[Rule]", "8"}], ",", RowBox[{"\"Length unit\"", "\[Rule]", "\"m\""}], ",", RowBox[{"\"Energy unit\"", "\[Rule]", "\"GeV\""}]}], "]"}], ",", "\"RawJSON\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"eventRunDirectory", ",", RowBox[{"\"DecayEvents_mass=\"", "<>", "m1", "<>", "\"_coupling1=\"", "<>", "c1", "<>", "\"_coupling2=\"", "<>", "c2", "<>", "\".mx\""}]}], "}"}], "]"}], ",", "decayproductsdata", ",", "\"\<MX\>\""}], "]"}], ";",
      "\[IndentingNewLine]", 
