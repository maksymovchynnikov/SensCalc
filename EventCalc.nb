     RowBox[{"IfCondDistrToWeights", "=", 
      RowBox[{
       RowBox[{"Sort", "[", "ProdChannelsSelected", "]"}], "==", 
       RowBox[{"Sort", "[", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"DeleteDuplicates", "[", 
