       SubscriptBox[">", 
        SubscriptBox["\[Phi]", "LLP"]]}]}], "}"}], " ", "for", " ", "the", 
    " ", "given", " ", "LLP", " ", "and", " ", 
    RowBox[{"mass", ".", " ", "It"}], " ", "averages", " ", "over", " ", 
    "dominant", " ", 
    RowBox[{"LLP", "'"}], "s", " ", 
    RowBox[{"decays", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"DecayAcceptanceBlock", "[", 
