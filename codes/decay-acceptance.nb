         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "pTsquaredCutLow1", ",", "pTsquaredCutLow2", ",", 
             "pTsquaredCutUpp1", ",", "pTsquaredCutUpp2", ",", 
             "pT1squaredlab", ",", "pT2squaredlab"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"pTsquaredCutLow1", "=", 
             SuperscriptBox[
              RowBox[{"pTcutLowerid", "[", 
               RowBox[{"pdg1", ",", "charge1"}], "]"}], "2"]}], ";", 
            "\[IndentingNewLine]", 
