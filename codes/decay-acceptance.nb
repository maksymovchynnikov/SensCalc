                    RowBox[{"Boole", "[", RowBox[{SuperscriptBox[RowBox[{"pTcutLowerid", "[", RowBox[{"pdgProd", ",", "chargeProd"}], "]"}], "2"], "\[LessEqual]", RowBox[{SuperscriptBox["pxLabProd", "2"], "+", SuperscriptBox["pyLabProd", "2"]}], "\[LessEqual]", SuperscriptBox[RowBox[{"pTcutUpperid", "[", RowBox[{"pdgProd", ",", "chargeProd"}], "]"}], "2"]}], "]"}]}]}]}], "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"cond", "==", "0."}], ",", 
                    RowBox[{
                    RowBox[{"allPoint", "=", "0."}], ";", 
                    RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"fProd", ",", "0", ",", 
                    RowBox[{"nproducts", "-", "1"}]}], "}"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"count", "+=", "allPoint"}], ";"}], 
                   "\[IndentingNewLine]", ",", 
