      RowBox[{"pdglists", "=", 
       RowBox[{"pss0", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{
           RowBox[{"-", "LengthDataProduct"}], "+", "indexpdg1", "+", 
