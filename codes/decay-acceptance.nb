                    "\[IndentingNewLine]", 
                    RowBox[{"ElabProd", "=", 
                    RowBox[{"EproductLabCart", "[", 
                    RowBox[{
                    "pxfip", ",", "pyfip", ",", "pzfip", ",", "efip", ",", 
                    "mLLP", ",", "pxRestProd", ",", "pyRestProd", ",", 
                    "pzRestProd", ",", "ErestProd"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"cond", "=", 
                    RowBox[{"CondGeom", "[", 
                    RowBox[{
                    "chargeProd", ",", "pdgProd", ",", "xdecayfip", ",", 
                    "ydecayfip", ",", "zfip", ",", "pxLabProd", ",", 
