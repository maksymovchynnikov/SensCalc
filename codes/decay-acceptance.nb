Cell[BoxData[{
 RowBox[{
  RowBox[{"conditionpTcuts", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pTcutLowerid", "=", "pTcutLowerID"}], ",", 
       RowBox[{"pTcutUpperid", "=", "pTcutUpperID"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Hold", "@", 
