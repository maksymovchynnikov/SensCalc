                    RowBox[{"abspdg", "=", 
                    RowBox[{"Abs", "[", "pdgProd", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Do", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"abspdg", "==", 
