               RowBox[{"Coord2FinProd", "=", "0."}], ",", 
               RowBox[{"\[Epsilon]azfip", "=", "0."}]}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"count", "=", " ", "0."}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"Values", " ", "of", " ", "the", " ", "LLP", " ", 
