                    RowBox[{"Sin", "[", "\[Phi]fip", "]"}], 
                    RowBox[{"Cos", "[", "\[Phi]fip", "]"}]]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"pzfip", "=", 
                  RowBox[{"pfip", "*", 
                   RowBox[{"Cos", "[", "\[Theta]fip", "]"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                  "Distance", " ", "between", " ", "the", " ", "end", " ", 
