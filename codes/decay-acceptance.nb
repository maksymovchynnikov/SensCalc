Cell["Kinematic variables used for imposing cuts", "Subsection",
 CellChangeTimes->{{3.8931702432138014`*^9, 3.8931702435906425`*^9}, {
  3.8934366714771786`*^9, 3.8934366726381407`*^9}, {3.9161264470186653`*^9, 
