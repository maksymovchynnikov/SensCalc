     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Averaging", " ", "over", " ", "distinct", " ", "decay", " ", 
       "products", " ", "set", " ", "for", " ", "the", " ", "given", " ", 
       "phase", " ", "space"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Computing", " ", "the", " ", "decay", " ", "products", " ", 
        RowBox[{"acceptance", ":", " ", 
