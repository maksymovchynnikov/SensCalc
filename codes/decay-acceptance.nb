                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"WhetherCuts", "==", "1"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"IfEcuts", "==", "1"}], ",", 
                    RowBox[{"cond", "=", 
                    RowBox[{"Boole", "[", RowBox[{RowBox[{"ecutLowerid", "[", RowBox[{"pdgProd", ",", "chargeProd"}], "]"}], "\[LessEqual]", "ElabProd", "\[LessEqual]", RowBox[{"ecutUpperid", "[", RowBox[{"pdgProd", ",", "chargeProd"}], "]"}]}], "]"}]}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{"The", " ", 
                    SubscriptBox["p", "T"], " ", 
