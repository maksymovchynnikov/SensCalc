           RowBox[{"DecayAcceptanceComp", "[", 
            RowBox[{
            "gridNonZero", ",", "PhaseSpaceGiven", ",", "mLLP", ",", 
             "eventslengths"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
