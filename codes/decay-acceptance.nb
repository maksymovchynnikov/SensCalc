   3.906801176497629*^9, 3.906801179548951*^9}, {3.910176120818011*^9, 
   3.9101761480327454`*^9}, {3.9121512857627974`*^9, 3.9121512904114666`*^9}, 
   3.9125011083554907`*^9, {3.9125011862782507`*^9, 3.9125011997184687`*^9}, {
