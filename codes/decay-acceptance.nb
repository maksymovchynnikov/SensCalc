  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"explanationDecayAcceptance", "[", "option", "]"}], "=", 
   "\"\<All the visible particles must point to the detector and satisfy \
kinematics cuts; specific particles must not be present in the decay mode \
(leave the list empty if all particles may be present)\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DecayAcceptanceAllProductsComp", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", RowBox[{RowBox[{"CondGeom", "=", "conditionDecayAcceptanceGeometric"}], ",", RowBox[{"CondMinv", "=", "conditionminvCuts"}], ",", RowBox[{"CondAS", "=", "conditionAngSepCuts"}], ",", RowBox[{"CondSS", "=", "conditionSScuts"}], ",", RowBox[{"CondIP", "=", "conditionIPcuts"}], ",", RowBox[{"CondPT", "=", "conditionpTcuts"}], ",", RowBox[{"CondE", "=", "conditionEnergyCuts"}], ",", RowBox[{"ecutLowerid", "=", "ecutLowerID"}], ",", RowBox[{"ecutUpperid", "=", "ecutUpperID"}], ",", RowBox[{"pTcutLowerid", "=", "pTcutLowerID"}], ",", RowBox[{"pTcutUpperid", "=", "pTcutUpperID"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Hold", "@", 
