                    RowBox[{"Sin", "[", "\[Phi]fip", "]"}], 
                    RowBox[{"Cos", "[", "\[Phi]fip", "]"}]]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"pzfip", "=", 
                  RowBox[{"pfip", "*", 
                   RowBox[{"Cos", "[", "\[Theta]fip", "]"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                  "Distance", " ", "between", " ", "the", " ", "end", " ", 
                   "of", " ", "the", " ", "dipole", " ", "magnet", " ", "and",
                    " ", "the", " ", "LLP", " ", "decay", " ", "point"}], 
                  "*)"}], "\[IndentingNewLine]", 
                 RowBox[{"zmagnMzfip", "=", 
