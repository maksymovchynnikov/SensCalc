                 "\[IndentingNewLine]", 
                 RowBox[{"pxfip", "=", 
                  RowBox[{"pfip", "*", 
                   RowBox[{"Cos", "[", "\[Phi]fip", "]"}], "*", 
                   RowBox[{"Sin", "[", "\[Theta]fip", "]"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"pyfip", "=", 
                  RowBox[{"pxfip", "*", 
