Cell[BoxData[
 RowBox[{RowBox[{"coordsAtDetectorEndMagnetComp", "=", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"kappa", "=", FractionBox["Bval", FractionBox[RowBox[{"cval", " ", "GeVTokgVal"}], "qValSI"]]}], ",", RowBox[{"zMin", "=", "zMagnetMinGivenExperiment"}], ",", RowBox[{"zMax", "=", "zMagnetMaxGivenExperiment"}]}], "}"}], ",", RowBox[{"Compile", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"z0", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"x0", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"y0", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"px", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"py", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"pz", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"q", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"zDet", ",", "_Real"}], "}"}]}], "}"}], ",", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"xDet", "=", "99999.`"}], ",", RowBox[{"yDet", "=", "99999.`"}], ",", RowBox[{"zEnter", "=", "0.`"}], ",", RowBox[{"zExit", "=", "0.`"}], ",", RowBox[{"dz", "=", "0.`"}], ",", RowBox[{"k", "=", "0.`"}], ",", RowBox[{"pxExit", "=", "0.`"}], ",", RowBox[{"pzExit", "=", "0.`"}], ",", RowBox[{"pzSquared", "=", "0.`"}], ",", RowBox[{"xExit", "=", "0.`"}], ",", RowBox[{"yExit", "=", "0.`"}], ",", RowBox[{"angle", "=", "0.`"}]}], "}"}], ",", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"pz", ">", "0.`"}], "&&", RowBox[{"zDet", "\[GreaterEqual]", "z0"}]}], ",", RowBox[{RowBox[{"zEnter", "=", RowBox[{"Min", "[", RowBox[{"zDet", ",", RowBox[{"Max", "[", RowBox[{"z0", ",", "zMin"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"zExit", "=", RowBox[{"Max", "[", RowBox[{"zEnter", ",", RowBox[{"Min", "[", RowBox[{"zDet", ",", "zMax"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"dz", "=", RowBox[{"zExit", "-", "zEnter"}]}], ";", "\[IndentingNewLine]", RowBox[{"k", "=", RowBox[{"kappa", " ", "q"}]}], ";", "\[IndentingNewLine]", RowBox[{"xExit", "=", RowBox[{"x0", "+", FractionBox[RowBox[{RowBox[{"(", RowBox[{"zEnter", "-", "z0"}], ")"}], " ", "px"}], "pz"]}]}], ";", "\[IndentingNewLine]", RowBox[{"yExit", "=", RowBox[{"y0", "+", FractionBox[RowBox[{RowBox[{"(", RowBox[{"zEnter", "-", "z0"}], ")"}], " ", "py"}], "pz"]}]}], ";", "\[IndentingNewLine]", RowBox[{"pxExit", "=", RowBox[{"px", "-", RowBox[{"k", " ", "dz"}]}]}], ";", "\[IndentingNewLine]", RowBox[{"pzSquared", "=", RowBox[{SuperscriptBox["pz", "2"], "+", RowBox[{RowBox[{"(", RowBox[{"px", "-", "pxExit"}], ")"}], " ", RowBox[{"(", RowBox[{"px", "+", "pxExit"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{"pzSquared", ">", "0.`"}], ",", RowBox[{RowBox[{"pzExit", "=", SqrtBox["pzSquared"]}], ";", "\[IndentingNewLine]", RowBox[{"xExit", "+=", FractionBox[RowBox[{"dz", " ", RowBox[{"(", RowBox[{"px", "+", "pxExit"}], ")"}]}], RowBox[{"pz", "+", "pzExit"}]]}], ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Abs", "[", RowBox[{"k", " ", "dz"}], "]"}], "<", FractionBox[RowBox[{"Abs", "[", "pz", "]"}], SuperscriptBox["10", "8"]]}], ",", RowBox[{"yExit", "+=", RowBox[{FractionBox[RowBox[{"py", " ", "dz"}], "pz"], "-", FractionBox[RowBox[{"py", " ", "px", " ", "k", " ", SuperscriptBox["dz", "2"]}], RowBox[{"2", " ", SuperscriptBox["pz", "3"]}]]}]}], ",", RowBox[{RowBox[{"angle", "=", RowBox[{"ArcTan", "[", RowBox[{RowBox[{RowBox[{"px", " ", "pxExit"}], "+", RowBox[{"pz", " ", "pzExit"}]}], ",", RowBox[{RowBox[{"px", " ", "pzExit"}], "-", RowBox[{"pxExit", " ", "pz"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"yExit", "+=", FractionBox[RowBox[{"py", " ", "angle"}], "k"]}]}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"xDet", "=", RowBox[{"xExit", "+", FractionBox[RowBox[{RowBox[{"(", RowBox[{"zDet", "-", "zExit"}], ")"}], " ", "pxExit"}], "pzExit"]}]}], ";", "\[IndentingNewLine]", RowBox[{"yDet", "=", RowBox[{"yExit", "+", FractionBox[RowBox[{RowBox[{"(", RowBox[{"zDet", "-", "zExit"}], ")"}], " ", "py"}], "pzExit"]}]}]}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"xDet", ",", "yDet"}], "}"}]}]}], "]"}], ",", RowBox[{"CompilationTarget", "\[Rule]", "\"C\""}], ",", RowBox[{"RuntimeOptions", "\[Rule]", "\"Speed\""}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"conditionDecayAcceptanceGeometric", "=", RowBox[{"ReleaseHold", "[", RowBox[{RowBox[{RowBox[{"Hold", "[", RowBox[{"Compile", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"charge1", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"pdg1", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"xdecayfip", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"ydecayfip", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"zfip", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"px1lab", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"py1lab", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"pz1lab", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"E1lab", ",", "_Real"}], "}"}], ",", RowBox[{"{", RowBox[{"zmagnMzfip", ",", "_Real"}], "}"}]}], "}"}], ",", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"xFinal", "=", "99999.`"}], ",", RowBox[{"yFinal", "=", "99999.`"}], ",", RowBox[{"plane", "=", "0.`"}], ",", RowBox[{"zEnter", "=", "0.`"}], ",", RowBox[{"zExit", "=", "0.`"}], ",", RowBox[{"dz", "=", "0.`"}], ",", RowBox[{"k", "=", "0.`"}], ",", RowBox[{"pxExit", "=", "0.`"}], ",", RowBox[{"pzExit", "=", "0.`"}], ",", RowBox[{"pzSquared", "=", "0.`"}], ",", RowBox[{"driftBefore", "=", "0.`"}], ",", RowBox[{"driftAfter", "=", "0.`"}], ",", RowBox[{"bendTime", "=", "0.`"}]}], "}"}], ",", RowBox[{RowBox[{"plane", "=", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Abs", "[", "pdg1", "]"}], "\[Equal]", "13.`"}], ",", "xLongMuonPlaneGivenExperiment", ",", "xLongNonMuonPlaneGivenExperiment"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Bval", "\[Equal]", "0.`"}], "||", RowBox[{"charge1", "\[Equal]", "0.`"}], "||", RowBox[{"zfip", "\[GreaterEqual]", "zMagnetMaxGivenExperiment"}], "||", RowBox[{"plane", "\[LessEqual]", "zMagnetMinGivenExperiment"}]}], ",", RowBox[{RowBox[{"xFinal", "=", RowBox[{"DaughterTrajectoryCoord1", "[", RowBox[{"xdecayfip", ",", "ydecayfip", ",", "zfip", ",", "plane", ",", "px1lab", ",", "py1lab", ",", "pz1lab"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"yFinal", "=", RowBox[{"DaughterTrajectoryCoord2", "[", RowBox[{"xdecayfip", ",", "ydecayfip", ",", "zfip", ",", "plane", ",", "px1lab", ",", "py1lab", ",", "pz1lab"}], "]"}]}]}], ",", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"pz1lab", ">", "0.`"}], "&&", RowBox[{"plane", "\[GreaterEqual]", "zfip"}]}], ",", RowBox[{RowBox[{"zEnter", "=", RowBox[{"If", "[", RowBox[{RowBox[{"zfip", ">", "zMagnetMinGivenExperiment"}], ",", "zfip", ",", "zMagnetMinGivenExperiment"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"zExit", "=", RowBox[{"If", "[", RowBox[{RowBox[{"plane", "<", "zMagnetMaxGivenExperiment"}], ",", "plane", ",", "zMagnetMaxGivenExperiment"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"dz", "=", RowBox[{"zExit", "-", "zEnter"}]}], ";", "\[IndentingNewLine]", RowBox[{"k", "=", FractionBox[RowBox[{"Bval", " ", "charge1"}], FractionBox[RowBox[{"cval", " ", "GeVTokgVal"}], "qValSI"]]}], ";", "\[IndentingNewLine]", RowBox[{"pxExit", "=", RowBox[{"px1lab", "-", RowBox[{"k", " ", "dz"}]}]}], ";", "\[IndentingNewLine]", RowBox[{"pzSquared", "=", RowBox[{SuperscriptBox["pz1lab", "2"], "+", RowBox[{RowBox[{"(", RowBox[{"px1lab", "-", "pxExit"}], ")"}], " ", RowBox[{"(", RowBox[{"px1lab", "+", "pxExit"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{"pzSquared", ">", "0.`"}], ",", RowBox[{RowBox[{"pzExit", "=", SqrtBox["pzSquared"]}], ";", "\[IndentingNewLine]", RowBox[{"driftBefore", "=", FractionBox[RowBox[{"zEnter", "-", "zfip"}], "pz1lab"]}], ";", "\[IndentingNewLine]", RowBox[{"driftAfter", "=", FractionBox[RowBox[{"plane", "-", "zExit"}], "pzExit"]}], ";", "\[IndentingNewLine]", RowBox[{"xFinal", "=", RowBox[{"xdecayfip", "+", RowBox[{"driftBefore", " ", "px1lab"}], "+", FractionBox[RowBox[{"dz", " ", RowBox[{"(", RowBox[{"px1lab", "+", "pxExit"}], ")"}]}], RowBox[{"pz1lab", "+", "pzExit"}]], "+", RowBox[{"driftAfter", " ", "pxExit"}]}]}], ";", "\[IndentingNewLine]", RowBox[{"bendTime", "=", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Abs", "[", RowBox[{"k", " ", "dz"}], "]"}], "<", FractionBox[RowBox[{"Abs", "[", "pz1lab", "]"}], SuperscriptBox["10", "8"]]}], ",", RowBox[{FractionBox["dz", "pz1lab"], "-", FractionBox[RowBox[{"px1lab", " ", "k", " ", SuperscriptBox["dz", "2"]}], RowBox[{"2", " ", SuperscriptBox["pz1lab", "3"]}]]}], ",", FractionBox[RowBox[{"2.`", " ", RowBox[{"ArcTan", "[", FractionBox[RowBox[{"px1lab", "-", "pxExit"}], RowBox[{"pz1lab", "+", "pzExit"}]], "]"}]}], "k"]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"yFinal", "=", RowBox[{"ydecayfip", "+", RowBox[{"py1lab", " ", RowBox[{"(", RowBox[{"driftBefore", "+", "bendTime", "+", "driftAfter"}], ")"}]}]}]}]}]}], "]"}]}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"xFinal", "\[Equal]", "99999.`"}], "||", RowBox[{"yFinal", "\[Equal]", "99999.`"}]}], ",", "0.`", ",", RowBox[{"N", "[", RowBox[{"DecayAcceptanceGeometry", "[", RowBox[{"xFinal", ",", "yFinal", ",", "plane"}], "]"}], "]"}]}], "]"}]}]}], "]"}], ",", RowBox[{"CompilationTarget", "\[Rule]", "\"C\""}], ",", RowBox[{"RuntimeOptions", "\[Rule]", "\"Speed\""}], ",", RowBox[{"RuntimeAttributes", "\[Rule]", RowBox[{"{", "Listable", "}"}]}], ",", RowBox[{"Parallelization", "\[Rule]", "True"}], ",", RowBox[{"CompilationOptions", "\[Rule]", RowBox[{"{", RowBox[{"\"InlineCompiledFunctions\"", "\[Rule]", "True"}], "}"}]}]}], "]"}], "]"}], "/.", "\[VeryThinSpace]", RowBox[{"ruleDown", "[", RowBox[{"{", RowBox[{"DaughterTrajectoryCoord1", ",", "DaughterTrajectoryCoord2", ",", "DecayAcceptanceGeometry"}], "}"}], "]"}]}], "/.", "\[VeryThinSpace]", RowBox[{"ruleOwn", "[", RowBox[{"{", RowBox[{"cval", ","