                  "*)"}], "\[IndentingNewLine]", 
                 RowBox[{"Do", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"cond", "=", "0."}], ";", "\[IndentingNewLine]", 
                    RowBox[{"min", "=", 
                    RowBox[{"Compile`GetElement", "[", 
                    RowBox[{"eventslengths", ",", "j", ",", "1"}], "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"nproducts", "=", 
                    RowBox[{"Compile`GetElement", "[", 
                    RowBox[{"eventslengths", ",", "j", ",", "2"}], "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{
                    "(*", "*********************************************************)"}\
], "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{"NEW", " ", "SINGLE", " ", 
                    RowBox[{"LOOP", ":", 
                    RowBox[{
                    "Check", " ", "if", " ", "all", " ", "decay", " ", 
                    "products", " ", "point", " ", "to"}]}]}], "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{"the", " ", 
                    RowBox[{"detector", ".", "We"}], " ", "ONLY", " ", "use", 
                    " ", "CondGeom", " ", "here", " ", 
                    RowBox[{"(", 
                    RowBox[{"no", " ", "other", " ", "cuts"}], ")"}]}], 
                    "*)"}], "\[IndentingNewLine]", 
                    RowBox[{
                    "(*", "*********************************************************)"}\
], "\[IndentingNewLine]", 
                    RowBox[{"allPoint", "=", "1."}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Do", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "inProd", ",", "chargeProd", ",", "pdgProd", ",", 
                    "pxRestProd", ",", "pyRestProd", ",", "pzRestProd", ",", 
                    "ErestProd", ",", "pxLabProd", ",", "pyLabProd", ",", 
                    "pzLabProd", ",", "ElabProd", ",", "condGeomProd"}], 
                    "}"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"inProd", "=", 
