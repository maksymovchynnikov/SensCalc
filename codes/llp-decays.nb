Cell[BoxData[{
 RowBox[{
  RowBox[{"HNLsList", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<HNL-mixing-e\>\"", ",", "\"\<HNL-mixing-mu\>\"", ",", 
     "\"\<HNL-mixing-tau\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"DecayDescriptionExplanation", "[", 
      RowBox[{"LLP", ",", "\"\<Default\>\""}], "]"}], "=", 
     "\"\<Description from 1805.08567, but with improved matching between \
hadronic decays described using pQCD and exclusively (dedicated merging for \
each mixing and charged/neutral current)\>\""}], ";"}], "\[IndentingNewLine]",
    ",", 
   RowBox[{"{", 
    RowBox[{"LLP", ",", "HNLsList"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalGamma]table", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], 
        ",", "\"\<phenomenology\>\"", ",", "\"\<HNL\>\"", ",", 
        "\"\<decay widths\>\"", ",", "\"\<HNLdecayWidth.dat\>\""}], "}"}], 
      "]"}], ",", "\"\<Table\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DecayWidth", "[", 
      RowBox[{"mLLP_", ",", "U2_", ",", 
       RowBox[{"HNLsList", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"DecayWidth", "[", 
      RowBox[{"mLLP_", ",", "U2_", ",", 
       RowBox[{"HNLsList", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"DecayWidth", "[", 
      RowBox[{"mLLP_", ",", "U2_", ",", 
       RowBox[{"HNLsList", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "}"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"U2", 
      RowBox[{"(", 
       RowBox[{"10", "^", 
        RowBox[{
         RowBox[{"Interpolation", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"Log10", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "+", 
                 SuperscriptBox["10", 
                  RowBox[{"-", "99"}]]}], "]"}]}], "}"}], "&"}], "/@", 
            RowBox[{"\[CapitalGamma]table", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "#"}], "}"}]}], "]"}], "]"}]}], ",", 
           RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}], "[", 
         "mLLP", "]"}]}], ")"}]}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3", ",", "4"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"c\[Tau]LLP", "[", 
      RowBox[{"HNL", ",", "\"\<Default\>\"", ",", "mLLP_", ",", "U2_"}], 
      "]"}], "=", 
     FractionBox["chbar", 
      RowBox[{"DecayWidth", "[", 
       RowBox[{"mLLP", ",", "U2", ",", "HNL"}], "]"}]]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"couplingSymbol", "[", "HNL", "]"}], "=", "U2"}], ";"}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"HNL", ",", "HNLsList"}], "}"}]}], "]"}]}], "Input",
