    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PhaseSpaceDecaysRestJets", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"filenamesparametersPS", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"filenamesparametersPS", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"filenamesparametersPS", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], "//", "ToExpression"}], "//", 
        "N"}]}], "]"}], "=", 
     RowBox[{"If", "[", RowBox[{
      RowBox[{RowBox[{"FileExtension", "[", RowBox[{"filespathsPS", "[", RowBox[{"[", "i", "]"}], "]"}], "]"}], "===", "\"wxf\""}], ",",
      RowBox[{"BinaryDeserialize", "[", RowBox[{"ReadByteArray", "[", RowBox[{"filespathsPS", "[", RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",",
      RowBox[{"Import", "[", RowBox[{RowBox[{"filespathsPS", "[", RowBox[{"[", "i", "]"}], "]"}], ",", "\"MX\""}], "]"}]}], "]"}]}], ",", 
