            RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "]"}], ",", "1"}], 
         "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Artificially", " ", "setting", " ", "the", " ", "br", " ", "ratios", 
        " ", "into", " ", "jets", " ", "to", " ", "zero", " ", "in", " ", 
