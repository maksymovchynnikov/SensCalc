        RowBox[{"Length", "[", "DataUnstableAtLLPrestFrame", "]"}], ",", 
        "\[Omega]list"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"UnstableDecayProductSplitted", "=", 
