Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"BrRatiosBLdata", "[", 
      RowBox[{"mLLP_", ",", "E1_", ",", "E3_"}], "]"}], "=", 
     RowBox[{"Import", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}],
           ",", "\"\<phenomenology\>\"", ",", "model", ",", 
          RowBox[{
          "\"\<decay widths/BrRatios-\>\"", "<>", "model", "<>", 
           "\"\<.mx\>\""}]}], "}"}], "]"}], ",", "\"\<MX\>\""}], "]"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "List", " ", "of", " ", "all", " ", "representative", " ", "processes"}],
      "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ProcessesList", "[", 
      RowBox[{"model", ",", "\"\<True\>\""}], "]"}], "=", 
     RowBox[{
      RowBox[{"BrRatiosBLdata", "[", 
       RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "proc", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"proc", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"BrRatiosBLdata", "[", 
             RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ListDecayProducts", "[", 
           RowBox[{"model", ",", "proc"}], "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"BrRatiosBLdata", "[", 
             RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"JetsPresence", "[", 
           RowBox[{"model", ",", "proc"}], "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"StringContainsQ", "[", 
             RowBox[{"proc", ",", "\"\<Jets\>\""}], "]"}], ",", "\"\<Yes\>\"",
             ",", "\"\<No\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ListBrRatios", "[", 
           RowBox[{
           "model", ",", "mLLP_", ",", "proc", ",", "\"\<Default\>\""}], 
           "]"}], "=", 
          RowBox[{
           RowBox[{"ListBrRatiosTemp", "[", 
            RowBox[{
            "model", ",", "mLLP_", ",", "proc", ",", "\"\<Default\>\""}], 
            "]"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"BrRatiosBLdata", "[", 
              RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"ListDecayProducts", "[", 
                RowBox[{"model", ",", "proc"}], "]"}], ",", 
               RowBox[{
                RowBox[{"#", "!=", "\"\<Null\>\""}], "&"}]}], "]"}], "]"}], "==",
             "3"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Msquared3BodyLLP", "[", 
              RowBox[{
              "model", ",", "proc", ",", "E1_", ",", "E3_", ",", "mLLP_", 
               ",", "\"\<Default\>\""}], "]"}], "=", 
             RowBox[{
              RowBox[{
               RowBox[{"BrRatiosBLdata", "[", 
                RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "4", "]"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
       "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"BrRatiosBLdata", "[", 
          RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "]"}], ",", "1"}], 
       "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ListBrRatios", "[", 
         RowBox[{"model", ",", "mLLP_", ",", "proc", ",", "\"\<Default\>\""}],
          "]"}], "=", 
        FractionBox[
         RowBox[{"ListBrRatiosTemp", "[", 
          RowBox[{"model", ",", "mLLP", ",", "proc", ",", "\"\<Default\>\""}],
           "]"}], 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"ListBrRatiosTemp", "[", 
            RowBox[{"model", ",", "mLLP", ",", "pr", ",", "\"\<Default\>\""}],
             "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"pr", ",", 
             RowBox[{"ProcessesList", "[", 
              RowBox[{"model", ",", "\"\<True\>\""}], "]"}]}], "}"}]}], 
          "]"}]]}], ";"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"proc", ",", 
        RowBox[{"ProcessesList", "[", 
         RowBox[{"model", ",", "\"\<True\>\""}], "]"}]}], "}"}]}], "]"}], ";",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ProcessesList", "[", 
      RowBox[{"model", ",", "\"\<False\>\""}], "]"}], "=", 
     RowBox[{"procListnoecal", "[", "model", "]"}]}]}], "\[IndentingNewLine]",
    ",", 
   RowBox[{"{", 
    RowBox[{"model", ",", "modelsBL"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  "\"\<All processes with at least two charged particles for B-L:\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"ProcessesList", "[", 
  RowBox[{"\"\<B-L\>\"", ",", "\"\<False\>\""}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Processes with jets:\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{"ProcessesList", "[", 
    RowBox[{"\"\<B-L\>\"", ",", "\"\<True\>\""}], "]"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"JetsPresence", "[", 
      RowBox[{"\"\<B-L\>\"", ",", "#"}], "]"}], "==", "\"\<Yes\>\""}], 
    "&"}]}], "]"}]}], "Input",
