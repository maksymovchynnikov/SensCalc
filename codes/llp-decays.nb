               RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"JetsPresence", "[", 
             RowBox[{"LLPsel", ",", "proc"}], "]"}], "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"StringContainsQ", "[", 
               RowBox[{"proc", ",", "\"\<Jets\>\""}], "]"}], ",", 
              "\"\<Yes\>\"", ",", "\"\<No\>\""}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ListBrRatios", "[", 
             RowBox[{"LLPsel", ",", "mLLP_", ",", "proc", ",", "descr"}], 
             "]"}], "=", 
            RowBox[{
             RowBox[{"ListBrRatiosTemp", "[", 
