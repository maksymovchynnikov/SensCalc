   "\"\<B\>\"", ",", "\"\<B-L\>\"", ",", "\"\<B-3Le-Lmu+Ltau\>\"", ",", 
    "\"\<B-Le-3Lmu+Ltau\>\"", ",", "\"\<B-3Lmu\>\""}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalGamma]LLP", "[", 
      RowBox[{"mLLP_", ",", "\[Alpha]B_"}], "]"}], "=", 
