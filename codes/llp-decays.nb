\(*\(0\)\)]\)\>\"", "]"}], "=", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "OnlyUnch", "[", "\"\<\!\(\*SubscriptBox[\(a\), \(1\)]\)\>\"", "]"}], "=", 
