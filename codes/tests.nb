Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ff1", "=", 
     RowBox[{
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"NotebookDirectory", "[", "]"}], "//", 
              "ParentDirectory"}], ",", 
             "\"\<temp1/EventCalc-python-data/unboosted_products.txt\>\""}], 
            "}"}], "]"}], ",", "\"\<Table\>\""}], "]"}], ",", "1"}], "]"}], "//",
       "Developer`ToPackedArray"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ff1", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"ff1", ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], "==", 
          RowBox[{"-", "999."}]}], "&&", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"-", "7"}], "]"}], "]"}], "==", 
          RowBox[{"-", "999."}]}]}], "&"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ff2", "=", 
     RowBox[{"PhaseSpaceDecaysRest", "[", 
      RowBox[{
      "\"\<DP\>\"", ",", "1.", ",", 
       "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\!\(\*SuperscriptBox[\(\
\[Pi]\), \(-\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\"", ",", 
       SuperscriptBox["10", "5"], ",", "\"\<Default\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"e\[Pi]josue", "=", 
     RowBox[{"ff1", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"6", "+", "4"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"e\[Pi]my", "=", 
     RowBox[{"ff2", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"8", "+", "4"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Histogram", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"e\[Pi]josue", ",", "Blue"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"e\[Pi]my", ",", "Red"}], "]"}]}], "*)"}], 
       RowBox[{"e\[Pi]my", ",", "e\[Pi]josue"}], "}"}], ",", "60", ",", 
      "\"\<ProbabilityDensity\>\"", ",", 
      RowBox[{"ImageSize", "->", "Large"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Thick", ",", "Black", ",", "18"}], "]"}]}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
        "\"\<\!\(\*SubscriptBox[\(E\), SuperscriptBox[\(\[Pi]\), \(+\)]]\) \
[GeV]\>\"", ",", "\"\<\!\(\*SubscriptBox[\(N\), \(entries\)]\)\>\""}], 
        "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{
          "{", "\"\<Decay DP\[Rule]\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\!\
\(\*SuperscriptBox[\(\[Pi]\), \(-\)]\)\!\(\*SuperscriptBox[\(\[Pi]\), \
\(0\)]\)\>\"", "}"}], "]"}], ",", "18", ",", "Thick", ",", "Black"}], "]"}]}],
       ",", 
      RowBox[{"ChartLegends", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"#", ",", "18", ",", "Thick"}], "]"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{"\"\<SensCalc\>\"", ",", "\"\<EventCalc\>\""}], "}"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"0.12", ",", "0.8"}], "}"}]}], "]"}]}]}], "]"}]}], "*)"}], 
