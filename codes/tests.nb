              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"massesProd", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"massesProd", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"E1domain", "[", 
            RowBox[{"mass", ",", 
             RowBox[{"massesProd", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"massesProd", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"massesProd", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"Histogram", "[", 
       RowBox[{
        RowBox[{"phasespace", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "indexE1"}], "]"}], "]"}], ",", "100", ",", 
        "\"\<ProbabilityDensity\>\"", ",", 
