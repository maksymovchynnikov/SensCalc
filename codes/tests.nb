          RowBox[{"All", ",", 
           RowBox[{
            RowBox[{"2", "*", "LengthDataProduct"}], "+", "indexE1"}]}], 
          "]"}], "]"}], ",", "100", ",", "\"\<ProbabilityDensity\>\"", ",", 
        RowBox[{"ScalingFunctions", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Log\>\"", ",", "\"\<Log\>\""}], "}"}]}]}], "]"}]}], 
     "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"Style", "[", 
