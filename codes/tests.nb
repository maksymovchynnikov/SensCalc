Cell["\<\
Primakov fluxes - collinear approximation vs exact kinematics\
\>", "Section",
 CellChangeTimes->{{3.989166775263475*^9, 
  3.989166789732205*^9}},ExpressionUUID->"296c1d0e-1175-4a02-806e-\
a69012b716f3"],

Cell[CellGroupData[{

Cell["Defs", "Section",
 CellChangeTimes->{{3.9891639667690496`*^9, 
  3.9891639673367147`*^9}},ExpressionUUID->"4ad874c3-8ac3-4f9c-afc8-\
d810893bef0c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"BlockTabulatedPDFsFromPrimakovTest", "[", 
   RowBox[{
   "Facility_", ",", "proc_", ",", "Nucleus_", ",", "mass_", ",", 
    "\[Theta]list_", ",", "Elist_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Theta]min", ",", "\[Theta]max", ",", "mlist", ",", "filename1", ",", 
      "filename2", ",", "fipn", ",", "mother"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mother", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"proc", "==", "\"\<Primakov-primary\>\""}], 
        ",", "\"\<photon\>\"", ",", "\"\<photon-cascade\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fipn", "=", "\"\<ALP-photon\>\""}], ";", "\[IndentingNewLine]", 
     RowBox[{"ProbPrimakovTab", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"E\[Gamma]", ",", 
            RowBox[{"Max", "[", 
             RowBox[{
              SuperscriptBox["10", 
               RowBox[{"-", "90."}]], ",", 
              RowBox[{
               FractionBox["1", 
                RowBox[{"\[Sigma]\[Gamma]Abs", "[", "Nucleus", "]"}]], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Quiet", "[", 
                  RowBox[{"\[Sigma]PrimakovNucleus", "[", 
                   RowBox[{"mass", ",", "E\[Gamma]", ",", 
                    RowBox[{"mnucleus", "[", "Nucleus", "]"}], ",", 
                    RowBox[{"anucleus", "[", "Nucleus", "]"}], ",", 
                    RowBox[{"znucleus", "[", "Nucleus", "]"}]}], "]"}], "]"}],
                  "+", 
                 RowBox[{"Quiet", "[", 
                  RowBox[{"\[Sigma]PrimakovNucleons", "[", 
                   RowBox[{"mass", ",", "E\[Gamma]", ",", 
                    RowBox[{"znucleus", "[", "Nucleus", "]"}]}], "]"}], 
                  "]"}]}], ")"}]}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"E\[Gamma]", ",", 
            RowBox[{"ENlist", "[", "Facility", "]"}]}], "}"}]}], "]"}], "//", 
        "N"}], "//", "Developer`ToPackedArray"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"Approximation", ":", " ", 
         SubscriptBox["E", "a"]}], " ", "=", " ", 
        SubscriptBox["E", "\[Gamma]"]}], ",", " ", 
       RowBox[{
        SubscriptBox["\[Theta]", "a"], " ", "=", " ", 
        SubscriptBox["\[Theta]", "\[Gamma]"]}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ProbPrimakov", "[", "Ea_", "]"}], "=", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{"Log", "[", "ProbPrimakovTab", "]"}], ",", 
          RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
        RowBox[{"Log", "[", "Ea", "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MotherInterpolation", "[", 
      RowBox[{"Facility", ",", "mother"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ALPdoubleFlux", "[", 
       RowBox[{"\[Theta]a_", ",", "Ea_"}], "]"}], "=", 
      RowBox[{
       RowBox[{"DoubleDistrMotherInt", "[", 
        RowBox[{"\[Theta]a", ",", "Ea", ",", "Facility", ",", "mother"}], 
        "]"}], "*", 
       RowBox[{"ProbPrimakov", "[", "Ea", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]min", ",", "\[Theta]max"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]MinMax", "[", 
          RowBox[{"Facility", ",", "mother"}], "]"}], "[", 
         RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"NormalizationALP1", "=", 
      RowBox[{"Quiet", "[", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ALPdoubleFlux", "[", 
           RowBox[{
            RowBox[{"Exp", "[", "t", "]"}], ",", 
            RowBox[{"Exp", "[", "e", "]"}]}], "]"}], 
          RowBox[{"Exp", "[", 
           RowBox[{"t", "+", "e"}], "]"}]}], ",", 
         RowBox[{"{", 
