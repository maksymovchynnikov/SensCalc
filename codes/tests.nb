           RowBox[{"massesProd", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"pt1", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"LogLogPlot", "[", 
       RowBox[{
        RowBox[{"1.02", 
         FractionBox[
          RowBox[{"endistr1", "[", 
           RowBox[{"mass", ",", "E1"}], "]"}], "norm"]}], ",", 
        RowBox[{"{", 
         RowBox[{"E1", ",", 
          RowBox[{
           RowBox[{"E1domain", "[", 
            RowBox[{"mass", ",", 
