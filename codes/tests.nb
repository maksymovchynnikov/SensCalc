          RowBox[{"\"\<Log\>\"", ",", "\"\<Log\>\""}], "}"}]}]}], "]"}]}], 
     "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"pt2", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"LogLogPlot", "[", 
       RowBox[{
        RowBox[{"1.02", 
         FractionBox[
          RowBox[{"endistr3", "[", 
           RowBox[{"mass", ",", "E3"}], "]"}], "norm"]}], ",", 
        RowBox[{"{", 
         RowBox[{"E3", ",", 
          RowBox[{
           RowBox[{"E3domain1", "[", 
            RowBox[{"mass", ",", 
             RowBox[{"massesProd", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"massesProd", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"massesProd", "[", 
