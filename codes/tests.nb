Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"listLLPs", "=", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Scalar\>\"", ",", "\"\<HNL-mixing-e\>\"", ",", 
      "\"\<HNL-mixing-mu\>\"", ",", "\"\<HNL-mixing-tau\>\"", ",", 
      "\"\<ALP-fermion\>\"", ",", "\"\<ALP-gluon\>\"", ",", "\"\<DP\>\""}], 
     "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "listdescr", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"listdescr", "=", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"DeleteDuplicates", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Keys", "[", 
                    RowBox[{"DownValues", "@", "ListBrRatios"}], "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "1", ",", "#"}], "]"}], "]"}], "&"}], 
                 "/@", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", 
                   RowBox[{"-", "1"}]}], "}"}]}], "//", "Transpose"}], "]"}], 
              ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "==", "LLP"}], "&"}]}], 
             "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
