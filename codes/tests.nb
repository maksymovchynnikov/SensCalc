Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fiptest", "=", "\"\<HNL-mixing-tau\>\""}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"proctest", "=", "\"\<Jets-udtau\>\""}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"masstest", "=", "2.3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pd", "=", 
      RowBox[{"PhaseSpaceDecaysRest", "[", 
       RowBox[{
       "fiptest", ",", "masstest", ",", "proctest", ",", "10", ",", 
        "\"\<Default\>\""}], "]"}]}], ";"}], "//", 
    RowBox[{"AbsoluteTiming", "\[IndentingNewLine]", 
     RowBox[{"fourcheck", "[", "j_", "]"}]}]}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"pd", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"LengthDataProduct", "*", 
               RowBox[{"(", 
                RowBox[{"i", "-", "1"}], ")"}]}], "+", "indexpdg1"}], "]"}], 
            "]"}], "!=", 
           RowBox[{"-", "999."}]}], ",", 
          RowBox[{
           RowBox[{"pd", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"LengthDataProduct", "*", 
              RowBox[{"(", 
               RowBox[{"i", "-", "1"}], ")"}]}], "+", "#"}], "]"}], "]"}], 
          ",", "0."}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          FractionBox[
           RowBox[{"Length", "[", 
            RowBox[{"pd", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "LengthDataProduct"], ",",
           "1"}], "}"}]}], "]"}], "&"}], "/@", 
     RowBox[{"{", 
      RowBox[{"indexpx1", ",", "indexpy1", ",", "indexpz1", ",", "indexE1"}], 
      "}"}]}], "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"fourcheck", "[", "j", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", 
        RowBox[{"Length", "[", "pd", "]"}], ",", "1"}], "}"}]}], "]"}]}]}], 
