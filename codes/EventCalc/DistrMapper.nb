           RowBox[{"[", 
            RowBox[{"1", ",", "All", ",", 
             RowBox[{"1", ";;", "3"}]}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
