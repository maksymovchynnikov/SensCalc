Cell[CellGroupData[{

Cell["New", "Subsection",
 CellChangeTimes->{{3.988567808783267*^9, 
  3.988567819700878*^9}},ExpressionUUID->"c7ad3a43-ed81-4693-bf9a-\
efd038079cfb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FindingMaxEnergy", "[", 
     RowBox[{"tab_", ",", " ", "order_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "g", "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"tab", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"Return", "[", "0.", "]"}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"GatherBy", "[", 
         RowBox[{
          RowBox[{"SortBy", "[", 
           RowBox[{"tab", ",", " ", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "&"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "&"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"emaxSpectrum", "[", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1", ",", " ", "2"}], "]"}], "]"}], ",", 
         " ", 
         RowBox[{"Total", " ", "/@", " ", 
          RowBox[{"g", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "All", ",", " ", "3"}], "]"}], "]"}]}], ",",
          " ", "order"}], "]"}]}]}], "\n", "  ", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"emaxSpectrum", "[", 
     RowBox[{"energies_", ",", " ", "values_", ",", " ", "order_"}], "]"}], 
    " ", ":=", "\n", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "e", ",", " ", "y", ",", " ", "pairs", ",", " ", "areas", ",", " ", 
        "tail", ",", " ", "total", ",", " ", "target", ",", " ", "pos"}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"pairs", " ", "=", " ", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"N", "[", "energies", "]"}], ",", " ", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"N", "[", "values", "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "Infinity"}], "}"}]}], "]"}]}], "}"}], 
           "]"}], ",", "\n", "    ", "First"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"pairs", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"Return", "[", "0.", "]"}]}], "]"}], ";", "\n", "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"e", ",", " ", "y"}], "}"}], " ", "=", " ", 
        RowBox[{"Transpose", "[", "pairs", "]"}]}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "e", "]"}], " ", "<", " ", "2"}], " ", "||",
           " ", 
          RowBox[{
           RowBox[{"Max", "[", "y", "]"}], " ", "<=", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "30."}]}]}]}], ",", " ", 
         RowBox[{"Return", "[", 
          RowBox[{"e", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"areas", " ", "=", " ", 
        RowBox[{"0.5", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Most", "[", "y", "]"}], " ", "+", " ", 
           RowBox[{"Rest", "[", "y", "]"}]}], ")"}], " ", 
         RowBox[{"Differences", "[", "e", "]"}]}]}], ";", "\n", "  ", 
       RowBox[{"tail", " ", "=", " ", 
        RowBox[{"Reverse", "[", 
