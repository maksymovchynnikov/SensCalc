          RowBox[{"Max", "[", 
           RowBox[{"mLLPlist", "[", "\"\<Total\>\"", "]"}], "]"}]}]}], "}"}], 
       ",", 
       RowBox[{"Table", "[", 
        RowBox[{"m", ",", 
