Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]ErandGeneratorOld", "[", 
    RowBox[{
    "mLLP_", ",", "type_", ",", "\[Theta]minmax_", ",", "logemindat_", ",", 
     "NevSampl_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Computing", " ", "tabulated", " ", "data", " ", 
