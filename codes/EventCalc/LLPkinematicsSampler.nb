         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
        "index\[Theta]Emaxlog", ",", "log\[Theta]emaxdata"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"logerand", "=", 
