       RowBox[{"RandomReal", "[", 
        RowBox[{"\[Theta]minmaxreduced", ",", "NevSampl"}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"For", " ", "each", " ", "\[Theta]"}], ",", " ", 
       RowBox[{
        RowBox[{"generaring", " ", "random", " ", 
