      RowBox[{"Nearest", "[", 
       RowBox[{
        RowBox[{"log\[Theta]emaxdata", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "->", "\"\<Index\>\""}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Generating", " ", "random", " ", "\[Theta]", " ", "values", " ", "and",
        " ", "logarithmying", " ", "them"}], "*)"}], "\[IndentingNewLine]", 
