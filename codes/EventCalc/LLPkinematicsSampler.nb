                 "\[Theta]maxYield", ",", "#", ",", 
                 RowBox[{"ELLPmaxData", "[", "\"\<Total\>\"", "]"}]}], 
                "]"}]}], "}"}], "&"}], "/@", "mLLPlistYield"}], ",", 
           RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "mLLP", 
         "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"MemberQ", "[", 
