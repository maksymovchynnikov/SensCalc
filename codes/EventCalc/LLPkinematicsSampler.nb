 RowBox[{"If", "[", RowBox[{RowBox[{"MemberQ", "[", RowBox[{RowBox[{"{", "\"Scalar\"", "}"}], ",", "LLPdirName"}], "]"}], ",", RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{", "weightKinematics1", "}"}], ",", RowBox[{RowBox[{RowBox[{"{", RowBox[{RowBox[{"weightKinematics1", "[", RowBox[{"mLLP_", ",", "coupling1_", ",", "coupling2_", ",", RowBox[{"keysMergedDistr", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "]"}], ",", RowBox[{"weightKinematics1", "[", RowBox[{"mLLP_", ",", "coupling1_", ",", "coupling2_", ",", RowBox[{"keysMergedDistr", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "]"}]}], "}"}], "=", RowBox[{RowBox[{"(", RowBox[{RowBox[{UnderoverscriptBox["\[Sum]", "prod", "#1"], RowBox[{"ProbabilityProcess", "[", RowBox[{"mLLP", ",", "coupling1", ",", "coupling2", ",", "prod"}], "]"}]}], "&"}], ")"}], "/@", RowBox[{"{", RowBox[{"ProdChannelsMixing", ",", "ProdChannelsQuartic"}], "}"}]}]}], ";", RowBox[{"Do", "[", RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"keyValue", "=", "key"}], "}"}], ",", RowBox[{RowBox[{"weightKinematics", "[", RowBox[{"mLLP_", ",", "coupling1_", ",", "coupling2_", ",", "keyValue"}], "]"}], "=", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"total", "=", RowBox[{UnderoverscriptBox["\[Sum]", "k", "keysMergedDistr"], RowBox[{"weightKinematics1", "[", RowBox[{"mLLP", ",", "coupling1", ",", "coupling2", ",", "k"}], "]"}]}]}], "}"}], ",", RowBox[{"If", "[", RowBox[{RowBox[{"total", ">", "0"}], ",", FractionBox[RowBox[{"weightKinematics1", "[", RowBox[{"mLLP", ",", "coupling1", ",", "coupling2", ",", "keyValue"}], "]"}], "total"], ",", "0.`"}], "]"}]}], "]"}]}]}], "]"}], ",", RowBox[{"{", RowBox[{"key", ",", "keysMergedDistr"}], "}"}]}], "]"}]}]}], "]"}], ";", RowBox[{RowBox[{"KinematicsFromTabulatedDistribution", "[", RowBox[{"mLLP_", ",", "coupling1_", ",", "coupling2_", ",", "Nevents_", ",", "c\[Tau]LLP_"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"rates", ",", "domainFra