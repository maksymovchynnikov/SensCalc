          RowBox[{"m", ",", "min", ",", "max", ",", 
           FractionBox[
            RowBox[{"(", 
             RowBox[{"max", "-", "min"}], ")"}], "100"]}], "}"}]}], "]"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
