   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"mval", "=", "0.2"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Nev", "=", 
       SuperscriptBox["10", "6"]}], ";", "\[IndentingNewLine]", 
      RowBox[{"datt", "=", 
       RowBox[{"KinematicsFromTabulatedDistribution", "[", 
        RowBox[{
        "mval", ",", "\[Theta]2val", ",", "BrhToSSval", ",", "Nev", ",", 
