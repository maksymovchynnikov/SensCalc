, "\[RightDoubleBracket]"}], "]"}], ",", "0", ",", "c\[Tau]LLP"}], "]"}], "\[LeftDoubleBracket]", RowBox[{"4", ";;", "7"}], "\[RightDoubleBracket]"}], ",", RowBox[{"{", RowBox[{"0.`", ",", "0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "]"}]}], ",", RowBox[{"{", RowBox[{"0.`", ",", "0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", "keysMergedDistr", "]"}]}], "}"}]}], "]"}]}], ";", RowBox[{"domainFractions", "=", RowBox[{"Table", "[", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{RowBox[{"rates", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ">", "0"}], "&&", RowBox[{RowBox[{"domains", "\[LeftDoubleBracket]", RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "<", RowBox[{"domains", "\[LeftDoubleBracket]", RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}]}], "&&", RowBox[{RowBox[{"domains", "\[LeftDoubleBracket]", RowBox[{"i", ",", "3"}], "\[RightDoubleBracket]"}], "<", RowBox[{"domains", "\[LeftDoubleBracket]", RowBox[{"i", ",", "4"}], "\[RightDoubleBracket]"}]}]}], ",", RowBox[{"LLPyield\[Theta]temp", "[", RowBox[{"mLLP", ",", RowBox[{"keysMergedDistr", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", RowBox[{"domains", "\[LeftDoubleBracket]", RowBox[{"i", ",", "3"}], "\[RightDoubleBracket]"}], ",", RowBox[{"domains", "\[LeftDoubleBracket]", RowBox[{"i", ",", "4"}], "\[RightDoubleBracket]"}], ",", RowBox[{"domains", "\[LeftDoubleBracket]", RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], ",", RowBox[{"domains", "\[LeftDoubleBracket]", RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}]}], "]"}], ",", "0.`"}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", "keysMergedDistr", "]"}]}], "}"}]}], "]"}]}], ";", RowBox[{"sampledDomainYield", "=", RowBox[{"rates", ".", "domainFractions"}]}], ";", RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"TrueQ", "[", RowBox[{"sampledDomainYield", ">", "0"}], "]"}]}], ",", RowBox[{RowBox[{"Print", "[", "\"No scalar production in the