           "dPdEdzEminElectrons", ",", "dPdEdzEminProtons", ",", 
            "cos\[Theta]scatt"}], "}"}], "]"}]}], "//", "ReleaseHold"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
