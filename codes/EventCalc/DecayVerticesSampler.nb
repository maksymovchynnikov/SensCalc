Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"StringContainsQ", "[", RowBox[{"LLPdirName", ",", "\"LDM\""}], "]"}]}], ",", RowBox[{RowBox[{RowBox[{"EventBlockFinal", "[", RowBox[{"mLLP_", ",", "coupling1_", ",", "coupling2_", ",", "Nev_"}], "]"}], ":=", RowBox[{"Block", "[", RowBox[{RowBox[{"{", RowBox[{"sampledDomainYield", "=", "0.`"}], "}"}], ",", RowBox[{RowBox[{"c\[Tau]LLPval", "=", RowBox[{"c\[Tau]LLP", "[", RowBox[{"mLLP", ",", "coupling1"}], "]"}]}], ";", RowBox[{"Nprodtot", "=", RowBox[{"NpotGivenExperiment", " ", RowBox[{"ProbabilityLLPprodTot", "[", RowBox[{"mLLP", ",", "coupling1", ",", "coupling2"}], "]"}]}]}], ";", RowBox[{"EventsProd", "=", RowBox[{"KinematicsFromTabulatedDistribution", "[", RowBox[{"mLLP", ",", "coupling1", ",", "coupling2", ",", "Nev", ",", "c\[Tau]LLPval"}], "]"}]}], ";", RowBox[{"yield", "=", RowBox[{"If", "[", RowBox[{RowBox[{"LLPdirName", "\[Equal]", "\"Scalar\""}], ",", "sampledDomainYield", ",", RowBox[{"LLPyield\[Theta]", "[", RowBox[{"mLLP", ",", "coupling1", ",", "coupling2", ",", "\[Theta]minreduced", ",", "\[Theta]maxreduced", ",", "EminReduced", ",", "EmaxReduced"}], "]"}]}], "]"}]}], ";", RowBox[{"momenta", "=", RowBox[{"Momenta", "[", RowBox[{"EventsProd", ",", RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "]"}]}], ";", RowBox[{"indexlist", "=", RowBox[{"Flatten", "[", RowBox[{"nfzvals", "[", RowBox[{"momenta", "\[LeftDoubleBracket]", RowBox[{"All", ",", RowBox[{"-", "1"}]}], "\[RightDoubleBracket]"}], "]"}], "]"}]}], ";", RowBox[{"EventsProdDecay\[Phi]Unweighted", "=", RowBox[{"SampledDecays", "[", RowBox[{"c\[Tau]LLPval", ",", "momenta", ",", "zvals", ",", "indexlist"}], "]"}]}], ";", RowBox[{"AzAccs", "=", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"bounds", "=", RowBox[{"zminmaxVals", "[", RowBox[{"momenta", ",", "zvals", ",", "indexlist"}], "]"}]}], "}"}], ",", RowBox[{"MapThread", "[", RowBox[{RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"#2", ">", "#1"}], ",", FractionBox["#3", RowBox[{"#2", "-", "#1"}]], ",