517670b1cd9a"],

Cell[CellGroupData[{

Cell["\<\
Generating vertices prior to the decay/scattering probability\
\>", "Subsection",
 CellChangeTimes->{{3.917601054940011*^9, 3.9176010612944117`*^9}, {
  3.9382426379763412`*^9, 
  3.938242649535187*^9}},ExpressionUUID->"b7fb0259-fe52-4d19-97ee-\
