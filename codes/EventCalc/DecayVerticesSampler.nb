            RowBox[{
            "ME", ",", "MP", ",", "indexpx", ",", "indexpy", ",", "indexpz", 
             ",", "indexptom", ",", "indexenergy", ",", "indexc\[Theta]", ",",
              "indexmass"}], "}"}], "]"}]}], "/.", 
         RowBox[{"ruleDown", "[", 
          RowBox[{"{", 
