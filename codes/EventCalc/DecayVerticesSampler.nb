                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", 
               "conds2"}], ")"}], "//", "Histogram"}]}], "}"}], "]"}], ",", 
         RowBox[{"ImageSizeMultipliers", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.942465483588686*^9, 3.94246552610343*^9}, {
   3.9424658089024944`*^9, 3.942465953041439*^9}, {3.942465992090639*^9, 
