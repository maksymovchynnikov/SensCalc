}]}], ";", RowBox[{"boostedphasespace", "=", RowBox[{"TabBoostedDecayProducts", "[", RowBox[{"llpevents", ",", "phasespacedecaysrest"}], "]"}]}], ";", RowBox[{"{", RowBox[{"llpevents", ",", "boostedphasespace"}], "}"}]}]}], "]"}]}], ";", RowBox[{RowBox[{"SimulateFullEvent", "[", RowBox[{"mLLP_", ",", "coupling1_", ",", "coupling2_", ",", "Nev_"}], "]"}], ":=", RowBox[{"SimulateFullEvent", "[", RowBox[{"mLLP", ",", "coupling1", ",", "coupling2", ",", "Nev", ",", "\"False\"", ",", "\"False\""}], "]"}]}]}]}], "]"}], "\[IndentingNewLine]"}]], "Input",
