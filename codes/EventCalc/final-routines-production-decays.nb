     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", "ListBrRatiosGivenComputation", "]"}], "!=", 
        "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
