 RowBox[{
  RowBox[{
   RowBox[{"CompilePrint", "@", "detectableproducts"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "block", " ", "generates", " ", "the", " ", "phase", " ", 
    "space", " ", "per", " ", "LLP", " ", "decay", " ", "by", " ", 
    "averaging", " ", "over", " ", "various", " ", "decay", " ", "channels"}],
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PhaseSpacePerDecay", "[", 
   RowBox[{
   "mLLP_", ",", "isim_", ",", "HadronizationOption_", ",", 
    "decayDescription_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
