     " ", "the", " ", "given", " ", "LLP", " ", "mass"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"weightsBlock", "[", 
      RowBox[{"mLLP_", ",", "Nevents_", ",", "IfMixing_"}], "]"}], ":=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"selprocs", "=", 
