       RowBox[{
        RowBox[{"isimulvalPerDecayChannelTemp", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Partition", "[", 
            RowBox[{
             RowBox[{"NeventsSplitted", "[", 
              RowBox[{"isim", ",", "ListBrRatiosGivenComputation"}], "]"}], 
             ",", "1"}], "]"}], ",", 
           RowBox[{"Partition", "[", 
            RowBox[{"ProcessesListSelected", ",", "1"}], "]"}], ",", "2"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
