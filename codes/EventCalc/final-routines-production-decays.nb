                    "\[IndentingNewLine]", 
                    RowBox[{"umin2", "=", 
                    RowBox[{"uzmin", "[", 
                    RowBox[{"ldec2", ",", "c\[Theta]2"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"umin2", ">", "0.99999999995"}], ",", 
