Cell[CellGroupData[{

Cell["Br ratios", "Subsection",
 CellChangeTimes->{{3.9310695412712126`*^9, 
  3.9310695423651114`*^9}},ExpressionUUID->"3fa29425-0616-4f6d-b9ce-\
67d10904dfbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"LLPdirName", "==", "\"\<Scalar\>\""}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LLPsel", "=", "\"\<Scalar\>\""}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"BrRatiosDPdata", "[", 
      RowBox[{"mLLP_", ",", "E1_", ",", "E3_"}], "]"}], "=", 
     RowBox[{"Import", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "dirpheno", ",", "LLPdirName", ",", "\"\<decay widths\>\"", 
          ",", "\"\<BrRatioScalar.mx\>\""}], "}"}], "]"}], 
       ",", "\"\<MX\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "List", " ", "of", " ", "all", " ", "representative", " ", "processes"}],
      "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ProcessesList", "[", 
      RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}], "=", 
     RowBox[{
      RowBox[{"BrRatiosDPdata", "[", 
       RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "proc", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"proc", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"BrRatiosDPdata", "[", 
              RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ListDecayProducts", "[", 
            RowBox[{"LLPsel", ",", "proc"}], "]"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"BrRatiosDPdata", "[", 
              RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"JetsPresence", "[", 
            RowBox[{"LLPsel", ",", "proc"}], "]"}], "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"StringContainsQ", "[", 
              RowBox[{"proc", ",", "\"\<Jets\>\""}], "]"}], ",", "\"\<Yes\>\"",
              ",", "\"\<No\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ListBrRatios", "[", 
            RowBox[{"LLPsel", ",", "mLLP_", ",", "proc"}], "]"}], "=", 
           RowBox[{
            RowBox[{"ListBrRatiosTemp", "[", 
             RowBox[{"LLPsel", ",", "mLLP_", ",", "proc"}], "]"}], "=", 
            RowBox[{
             RowBox[{
              RowBox[{"BrRatiosDPdata", "[", 
               RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"ListDecayProducts", "[", 
                 RowBox[{"LLPsel", ",", "proc"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"#", "!=", "\"\<Null\>\""}], "&"}]}], "]"}], "]"}], "==",
              "3"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"Msquared3BodyLLP", "[", 
               RowBox[{
               "LLPsel", ",", "proc", ",", "E1_", ",", "E3_", ",", "mLLP_"}], 
               "]"}], "=", 
              RowBox[{
               RowBox[{
                RowBox[{"BrRatiosDPdata", "[", 
                 RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "4", "]"}], "]"}]}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"BrRatiosDPdata", "[", 
          RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "]"}], ",", "1"}], 
       "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Artificially", " ", "setting", " ", "the", " ", "br", " ", "ratios", " ",
       "into", " ", "jets", " ", "to", " ", "zero", " ", "in", " ", "the", " ",
       "mass", " ", "range", " ", "where", " ", "they", " ", "are", " ", 
      "anyway", " ", "negligible"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListBrRatios", "[", 
      RowBox[{"LLPsel", ",", "mLLP_", ",", "\"\<Jets-GG\>\""}], "]"}], "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"mLLP", "<", "5"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"ListBrRatios", "[", 
         RowBox[{"LLPsel", ",", "mLLP", ",", "\"\<Jets-GG\>\""}], "]"}], 
        "]"}], ",", "0."}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListBrRatios", "[", 
      RowBox[{"LLPsel", ",", "mLLP_", ",", "\"\<Jets-ss\>\""}], "]"}], "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"mLLP", "<=", "3.8"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"ListBrRatios", "[", 
         RowBox[{"LLPsel", ",", "mLLP", ",", "\"\<Jets-ss\>\""}], "]"}], 
        "]"}], ",", "0."}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListBrRatios", "[", 
      RowBox[{"LLPsel", ",", "mLLP_", ",", "\"\<Jets-cc\>\""}], "]"}], "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"mLLP", "<", "17"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"ListBrRatios", "[", 
         RowBox[{"LLPsel", ",", "mLLP", ",", "\"\<Jets-cc\>\""}], "]"}], 
        "]"}], ",", "0."}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "Redefinition", " ", "to", " ", "ensure", " ", "exact", " ", "unit", " ",
        "br", " ", 
       RowBox[{"ratio", ".", " ", "In"}], " ", "principle"}], ",", " ", 
      RowBox[{"it", " ", "is", " ", "not", " ", "necessary"}]}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ListBrRatios", "[", 
         RowBox[{"LLPsel", ",", "mLLP_", ",", "proc"}], "]"}], "=", 
        RowBox[{
         RowBox[{"ListBrRatiosTemp", "[", 
          RowBox[{"LLPsel", ",", "mLLP", ",", "proc"}], "]"}], "/", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"ListBrRatiosTemp", "[", 
            RowBox[{"LLPsel", ",", "mLLP", ",", "pr"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"pr", ",", 
             RowBox[{"ProcessesList", "[", 
              RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}]}], "}"}]}], 
          "]"}]}]}], ";"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"proc", ",", 
        RowBox[{"ProcessesList", "[", 
         RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}]}], "}"}]}], "]"}], ";",
     "\[IndentingNewLine]", 
    RowBox[{
    "Print", "[", "\"\<All processes with at least two charged particles:\>\"",
      "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ProcessesList", "[", 
      RowBox[{"LLPsel", ",", "\"\<False\>\""}], "]"}], "=", 
     RowBox[{"procListnoecal", "[", "LLPsel", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "\"\<Processes with jets:\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"ProcessesList", "[", 
       RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"JetsPresence", "[", 
         RowBox[{"LLPsel", ",", "#"}], "]"}], "==", "\"\<Yes\>\""}], "&"}]}], 
     "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.931069445259421*^9, 3.9310694950305443`*^9}, {
   3.93106961034059*^9, 3.93106961943919*^9}, 3.931070573586976*^9, {
   3.9356778386820316`*^9, 3.9356778638917217`*^9}, {3.942205994082897*^9, 
