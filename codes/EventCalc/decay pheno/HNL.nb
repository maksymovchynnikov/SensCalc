Cell[BoxData[RowBox[{"If", "[", RowBox[{RowBox[{"LLPdirName", "==", "\"HNL\""}], ",", "\[IndentingNewLine]", RowBox[{RowBox[{"HNLsList", "=", RowBox[{"{", RowBox[{"\"HNL-mixing-e\"", ",", "\"HNL-mixing-mu\"", ",", "\"HNL-mixing-tau\""}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{"\[CapitalGamma]table", "=", RowBox[{"Import", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"dirpheno", ",", "LLPdirName", ",", "\"decay widths\"", ",", "\"HNLdecayWidth.dat\""}], "}"}], "]"}], ",", "\"Table\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"{", RowBox[{RowBox[{"DecayWidth", "[", RowBox[{"mLLP_", ",", "U2_", ",", RowBox[{"HNLsList", "[", RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", RowBox[{"DecayWidth", "[", RowBox[{"mLLP_", ",", "U2_", ",", RowBox[{"HNLsList", "[", RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", RowBox[{"DecayWidth", "[", RowBox[{"mLLP_", ",", "U2_", ",", RowBox[{"HNLsList", "[", RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "}"}], "=", RowBox[{RowBox[{RowBox[{"U2", RowBox[{"(", RowBox[{"10", "^", RowBox[{RowBox[{"Interpolation", "[", RowBox[{RowBox[{RowBox[{RowBox[{"{", RowBox[{RowBox[{"#", "[", RowBox[{"[", "1", "]"}], "]"}], ",", RowBox[{"Log10", "[", RowBox[{RowBox[{"#", "[", RowBox[{"[", "2", "]"}], "]"}], "+", SuperscriptBox["10", RowBox[{"-", "99"}]]}], "]"}]}], "}"}], "&"}], "/@", RowBox[{"\[CapitalGamma]table", "[", RowBox[{"[", RowBox[{"All", ",", RowBox[{"{", RowBox[{"1", ",", "#"}], "}"}]}], "]"}], "]"}]}], ",", RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}], "[", "mLLP", "]"}]}], ")"}]}], "&"}], "/@", RowBox[{"{", RowBox[{"2", ",", "3", ",", "4"}], "}"}]}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"\[CapitalGamma]LLP", "[", RowBox[{"mLLP_", ",", "U2_"}], "]"}], "=", RowBox[{RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"HNLtype", "\[Equal]", "\"Dirac\""}], ",", RowBox[{"1", "/", "2"}], ",", "1"}], "]"}], RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{"DecayWidth", "[", RowBox[{"mLLP", ",", "U2", ",", "#"}], "]"}], "&"}], "/@", "HNLsList"}], ")"}], ".", "MixingPattern"}]}], "//", "Chop"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"c\[Tau]LLP", "[", RowBox[{"mLLP_", ",", "U2_"}], "]"}], "=", FractionBox["chbarval", RowBox[{"\[CapitalGamma]LLP", "[", RowBox[{"mLLP", ",", "U2"}], "]"}]]}], ";"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.931072150290454*^9, 3.931072178609068*^9}, {
