           RowBox[{"(*", 
            RowBox[{"Energies", " ", "of", " ", "particles", " ", "1", " ", 
             RowBox[{"(", "E12body", ")"}], " ", "and", " ", "2", " ", 
             RowBox[{"(", "E22body", ")"}], " ", "at", " ", "the", " ", 
