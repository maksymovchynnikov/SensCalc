             "particle"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"E12body", "=", 
             FractionBox[
              RowBox[{
               SuperscriptBox["MASSM", "2"], "-", 
               SuperscriptBox["m2", "2"], "+", 
               SuperscriptBox["m1", "2"]}], 
              RowBox[{"2", "*", "MASSM"}]]}], ";", "\[IndentingNewLine]", 
