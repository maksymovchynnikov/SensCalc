   "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", 
    "\"\<Check that \!\(\*SubscriptBox[SuperscriptBox[\(E\), \(2\)], \
\(boosted\)]\) - \!\(\*SubscriptBox[SuperscriptBox[OverscriptBox[\(p\), \
