   RowBox[{"filepheno", ",", 
    RowBox[{"SortBy", "[", 
     RowBox[{"file", ",", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "&"}]}], "]"}], ",", "\"\<MX\>\""}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"file", ";"}]}], "Input",
 CellChangeTimes->{{3.950692693496708*^9, 3.9506927822852573`*^9}, {
