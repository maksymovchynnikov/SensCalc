              RowBox[{
               RowBox[{"channelsnonzero", "[", 
                RowBox[{"hnl", ",", "mLLP", ",", "E1", ",", "E3"}], "]"}], 
               "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
