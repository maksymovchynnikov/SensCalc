Cell[CellGroupData[{

Cell["Model description", "Subsection",
 CellChangeTimes->{{3.9506926867608128`*^9, 
  3.9506926926469193`*^9}},ExpressionUUID->"e38027b4-03b6-6b4f-b484-\
e99351d3c439"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LLPsel", "=", "\"\<HNL\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ModelDescription", "[", "LLPsel", "]"}], "=", 
   RowBox[{"Row", "[", 
    RowBox[{
    "{", "\"\<Heavy Neutral Lepton N - a fermion with the phenomenological \
Lagrangian L = \!\(\*SubscriptBox[\(Y\), \(\[Alpha]\)]\) \
\!\(\*SubscriptBox[OverscriptBox[\(L\), \(_\)], \
\(\[Alpha]\)]\)\!\(\*SubscriptBox[\(i\[Sigma]\), \
\(2\)]\)\!\(\*SuperscriptBox[\(H\), \(*\)]\)N, where \
\!\(\*SubscriptBox[\(Y\), \(\[Alpha]\)]\) is the Yukawa coupling, H is the \
Higgs doublet, and \!\(\*SubscriptBox[\(L\), \(\[Alpha]\)]\) is the left \
lepton SU(2\!\(\*SubscriptBox[\()\), \(L\)]\) doublet. Below the electroweak \
scale, HNLs have effective mixing with neutrinos \
\!\(\*SubscriptBox[\(\[Nu]\), \(\[Alpha]\)]\) given by the mixing angle \
\!\(\*SubscriptBox[\(U\), \(\[Alpha]\)]\). Further, everything is expressed \
in terms of the squared mixing angles \
\!\(\*SuperscriptBox[SubscriptBox[\(U\), \(\[Alpha]\)], \(2\)]\) = \
\!\(\*SuperscriptBox[\(U\), \(2\)]\)(\!\(\*SubscriptBox[\(x\), \(e\)]\), \!\(\
\*SubscriptBox[\(x\), \(\[Mu]\)]\), \!\(\*SubscriptBox[\(x\), \(\[Tau]\)]\)), \
where \!\(\*SubscriptBox[\(x\), \(e\)]\)+\!\(\*SubscriptBox[\(x\), \(\[Mu]\)]\
\)+\!\(\*SubscriptBox[\(x\), \(\[Tau]\)]\) = 1. See 1805.08567 for the \
phenomenology description. The models with \!\(\*SubscriptBox[\(x\), \(e\)]\) \
= 1 (and others zero), \!\(\*SubscriptBox[\(x\), \(\[Mu]\)]\) = 1 (and others \
zero), \!\(\*SubscriptBox[\(x\), \(\[Tau]\)]\) = 1 (and others zero) are \
known as BC6, BC7, BC8 within PBC benchmarking (1901.09966)\>\"", "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"filepheno", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], "//",
        "ParentDirectory"}], ",", "\"\<phenomenology\>\"", ",", 
      "\"\<ModelDescriptors.mx\>\""}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rowtoadd", "=", 
   RowBox[{"{", 
    RowBox[{"LLPsel", ",", 
     RowBox[{"ModelDescription", "[", "LLPsel", "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"!", 
    RowBox[{"FileExistsQ", "[", "filepheno", "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"file", "=", 
     RowBox[{"{", "rowtoadd", "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"file", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"filepheno", ",", "\"\<MX\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"file", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"file", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "!=", "LLPsel"}], "&"}]}], "]"}], 
       ",", 
       RowBox[{"{", "rowtoadd", "}"}]}], "]"}]}], ";"}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
