              RowBox[{"StringContainsQ", "[", 
               RowBox[{"proc", ",", "\"\<Jets\>\""}], "]"}], ",", 
              "\"\<Yes\>\"", ",", "\"\<No\>\""}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ListBrRatios", "[", 
             RowBox[{
             "hnl", ",", "mLLP_", ",", "proc", ",", "\"\<Default\>\""}], 
             "]"}], "=", 
            RowBox[{
             RowBox[{"ListBrRatiosTemp", "[", 
              RowBox[{
              "hnl", ",", "mLLP_", ",", "proc", ",", "\"\<Default\>\""}], 
              "]"}], "=", 
