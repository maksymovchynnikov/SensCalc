           RowBox[{
            RowBox[{"ListDecayProducts", "[", 
             RowBox[{"hnl", ",", "proc"}], "]"}], "=", 
            RowBox[{
             RowBox[{
              RowBox[{"channelsnonzero", "[", 
               RowBox[{"hnl", ",", "mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"JetsPresence", "[", 
             RowBox[{"hnl", ",", "proc"}], "]"}], "=", 
            RowBox[{"If", "[", 
