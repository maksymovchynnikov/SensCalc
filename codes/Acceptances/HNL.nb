       RowBox[{"HNLsList", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "}"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"U2", 
      RowBox[{"(", 
       RowBox[{"10", "^", 
        RowBox[{
         RowBox[{"Interpolation", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"Log10", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "+", 
                 SuperscriptBox["10", 
                  RowBox[{"-", "99"}]]}], "]"}]}], "}"}], "&"}], "/@", 
