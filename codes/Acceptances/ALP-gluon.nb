Cell[BoxData[{RowBox[{RowBox[{"LLPsel", "=", "\"ALP-gluon\""}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"filesDecay", "=", RowBox[{"FileNames", "[", RowBox[{"\"Widths*\"", ",", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], "//", "ParentDirectory"}], ",", "\"phenomenology\"", ",", "LLPsel", ",", "\"decay widths\""}], "}"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[{"descrlist", "=", RowBox[{RowBox[{RowBox[{RowBox[{"StringSplit", "[", RowBox[{RowBox[{"FileNameTake", "[", "#", "]"}], ",", RowBox[{"{", RowBox[{"\"GeV-\"", ",", "\".m\""}], "}"}]}], "]"}], "[", RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "filesDecay"}]}], "\[IndentingNewLine]", RowBox[{"Print", "[", "\"Default description:\"", "]"}], "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"descrDefault", "[", "LLPsel", "]"}], "=", RowBox[{"descrlist", "[", RowBox[{"[", "2", "]"}], "]"}]}], "\[IndentingNewLine]", RowBox[{"(*", RowBox[{"List", " ", "of", " ", "widths", " ", "of", " ", "the", " ", "ALP", " ", "into", " ", "various", " ", "final", " ", "states"}], "*)"}]}], "\[IndentingNewLine]", RowBox[{"Do", "[", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"DecayWidthsDataTemp", "=", RowBox[{"Import", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], "//", "ParentDirectory"}], ",", "\"phenomenology\"", ",", "LLPsel", ",", "\"decay widths\"", ",", RowBox[{"\"Widths-model-Gluon-scale-1000.-GeV-\"", "<>", "descr", "<>", "\".m\""}]}], "}"}], "]"}], ",", "\"MX\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"DecayWidthsDataTemp2", "=", RowBox[{"DecayWidthsDataTemp", "[", RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"Print", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Table", "[", RowBox[{"i", ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", RowBox[{"DecayWidthsDataTemp2", "[", RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "1"}], "}"}]}], "]"}], ",", RowBox[{"DecayWidthsDataTemp2", "[", RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "//", "TableForm"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"DecayWidthsData", "=", RowBox[{"Drop", "[", RowBox[{"DecayWidthsDataTemp2", ",", "3"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"(*", RowBox[{"Total", " ", "decay", " ", "width", " ", "and", " ", "lifetime"}], "*)"}], "\[IndentingNewLine]", RowBox[{"totalwidthdata", "=", RowBox[{"DecayWidthsData", "[", RowBox[{"[", RowBox[{"All", ",", RowBox[{"{", RowBox[{"1", ",", RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"c\[Tau]LLP", "[", RowBox[{"LLPsel", ",", "descr", ",", "mLLP_", ",", "finv_"}], "]"}], "=", RowBox[{"chbar", "/", RowBox[{"(", RowBox[{SuperscriptBox["finv", "2"], "*", RowBox[{RowBox[{"Interpolation", "[", RowBox[{RowBox[{"DecayWidthsData", "[", RowBox[{"[", RowBox[{"All", ",", RowBox[{"{", RowBox[{"1", ",", RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}], ",", RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "mLLP", "]"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"couplingSymbol", "[", "LLPsel", "]"}], "=", "finv"}], ";"}], "\[IndentingNewLine]", ",", RowBox[{"{", RowBox[{"descr", ",", "descrlist"}], "}"}]}], "]"}], "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"DecayDescriptionExplanation", "[", RowBox[{"LLPsel", ",", "\"kappa\""}], "]"}], "=", "\"Description of hadronic width of ALPs without invariance under the chiral rotation parameters and without inclusion of mixing of ALPs with heavy pseudoscalar excitations. Implemented for testing purposes. See 2501.04525 for details\""}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"DecayDescriptionExplanation", "[", RowBox[{"LLPsel", ",", "\"2501.04525\""}], "]"}], "=", "\"Description of the ALP widths from 2501.04525: invariance under chiral rotation parameters, inclusion of mixing of ALPs with heavy pseudoscalar excitations\""}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"DecayDescriptionExplanation", "[", RowBox[{"LLPsel", ",", "\"1811.03474\""}], "]"}], "=", "\"Description of the ALP widths from 1811.03474: non-invariance of all widths (except for 2\[Gamma]) under chiral rotation parameters, no mixing of ALPs with heavy pseudoscalar excitations\""}], ";"}]}], "Input",
