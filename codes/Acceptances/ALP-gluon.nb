Cell[CellGroupData[{
Cell["ALPs coupled to gluons", "Section",
 CellChangeTimes->{{3.890548205242524*^9, 3.890548233837968*^9}, {
  3.9038932905205584`*^9, 
  3.903893291439942*^9}},ExpressionUUID->"2bef9f06-2131-48fa-b87e-\
76b67c176d17"],

Cell[BoxData[{RowBox[{RowBox[{"LLPsel", "=", "\"ALP-gluon\""}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"ModelDescription", "[", "LLPsel", "]"}], "=", RowBox[{"Row", "[", RowBox[{"{", "\"Axion-like particle a with the phenomenological Lagrangian L = \!\(\*SubscriptBox[\(c\), \(G\)]\)\!\(\*FractionBox[\(a\), SubscriptBox[\(f\), \(a\)]]\)\!\(\*FractionBox[SubscriptBox[\(\[Alpha]\), \(S\)], \(4  \[Pi]\)]\)\!\(\*SuperscriptBox[\(G\), \(\[Mu]\[Nu]\)]\)\!\(\*SubscriptBox[OverscriptBox[\(G\), \(~\)], \(\[Mu]\[Nu]\)]\). The Lagrangian is defined at some scale \[CapitalLambda], with \!\(\*SubscriptBox[\(c\), \(G\)]\), \!\(\*SubscriptBox[\(f\), \(a\)]\) being the couplings (\!\(\*SubscriptBox[\(f\), \(a\)]\) is in general unrelated to \[CapitalLambda]). \!\(\*SubscriptBox[\(G\), \(\[Mu]\[Nu]\)]\) is the SM gluon field, and \!\(\*SubscriptBox[OverscriptBox[\(G\), \(~\)], \(\[Mu]\[Nu]\)]\) is its dual. The RG flow down to scales of interest induces small couplings to quarks. For the particular choice \[CapitalLambda] = 1 TeV and \!\(\*SubscriptBox[\(c\), \(G\)]\) = 1, the model is called BC11 within PBC benchmarking (1901.09966). See 2110.10698, 2310.03524, and 2501.04525 for the phenomenology description\"", "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"filepheno", "=", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], "//", "ParentDirectory"}], ",", "\"phenomenology\"", ",", "\"ModelDescriptors.mx\""}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"rowtoadd", "=", RowBox[{"{", RowBox[{"LLPsel", ",", RowBox[{"ModelDescription", "[", "LLPsel", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"FileExistsQ", "[", "filepheno", "]"}]}], ",", "\[IndentingNewLine]", RowBox[{RowBox[{"file", "=", RowBox[{"{", "rowtoadd", "}"}]}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", RowBox[{RowBox[{"file", "=", RowBox[{"Import", "[", RowBox[{"filepheno", ",", "\"MX\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"file", "=", RowBox[{"Join", "[", RowBox[{RowBox[{"Select", "[", RowBox[{"file", ",", RowBox[{RowBox[{RowBox[{"#", "[", RowBox[{"[", "1", "]"}], "]"}], "!=", "LLPsel"}], "&"}]}], "]"}], ",", RowBox[{"{", "rowtoadd", "}"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", RowBox[{RowBox[{"Export", "[", RowBox[{"filepheno", ",", RowBox[{"SortBy", "[", RowBox[{"file", ",", RowBox[{RowBox[{"#", "[", RowBox[{"[", "1", "]"}], "]"}], "&"}]}], "]"}], ",", "\"MX\""}], "]"}], ";"}]}], "Input",
