  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c\[Tau]LLP", "[", 
    RowBox[{"LLPsel", ",", "\"\<Default\>\"", ",", "ma_", ",", "ga_"}], "]"}],
    "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["ga", "2"]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"c\[Tau]Data", "//", "Log"}], ",", 
         RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
       RowBox[{"Log", "[", "ma", "]"}], "]"}], "//", "Exp"}], ")"}]}]}], 
