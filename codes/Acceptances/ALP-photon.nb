    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListBrRatios", "[", 
      RowBox[{
      "\"\<ALP-photon\>\"", ",", "mLLP_", ",", "\"\<\[Gamma]-pair\>\""}], 
      "]"}], "=", 
     RowBox[{"ListBrRatiosTemp", "[", 
      RowBox[{
      "\"\<ALP-photon\>\"", ",", "mLLP", ",", "\"\<\[Gamma]-pair\>\""}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Print", "[", 
       "\"\<All processes with at least two charged/neutral particles:\>\"", 
       "]"}], "\[IndentingNewLine]", 
      RowBox[{"ProcessesList", "[", 
       RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"procList", "[", "LLPsel", "]"}], "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", 
        "\"\<All processes with at least two charged particles:\>\"", "]"}], 
       "\[IndentingNewLine]", 
       RowBox[{"ProcessesList", "[", 
        RowBox[{"LLPsel", ",", "\"\<False\>\""}], "]"}]}], "=", 
      RowBox[{
       RowBox[{"procListnoecal", "[", "LLPsel", "]"}], "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<Processes with jets:\>\"", "]"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"ProcessesList", "[", 
          RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"JetsPresence", "[", 
            RowBox[{"LLPsel", ",", "#"}], "]"}], "==", "\"\<Yes\>\""}], 
          "&"}]}], "]"}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"LLPsel", "=", "\"\<ALP-photon\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<Default description:\>\"", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"descrDefault", "[", "LLPsel", "]"}], "=", "\"\<Default\>\""}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"BrRatiosDPdata", "[", 
      RowBox[{"mLLP_", ",", "E1_", ",", "E3_"}], "]"}], "=", 
     RowBox[{"Import", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"NotebookDirectory", "[", "]"}], "//", 
