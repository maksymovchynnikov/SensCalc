      RowBox[{
       RowBox[{"ListBrRatiosTemp", "[", 
        RowBox[{"LLPsel", ",", "mLLP", ",", "proc", ",", "\"\<Default\>\""}], 
        "]"}], "/", 
       RowBox[{"Sum", "[", 
