          "\"\<decay widths/BrRatiosALPphoton.mx\>\""}], "}"}], "]"}], ",", 
       "\"\<MX\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "List", " ", "of", " ", "all", " ", "representative", " ", "processes"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ProcessesList", "[", 
     RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}], "=", 
    RowBox[{
     RowBox[{"BrRatiosDPdata", "[", 
      RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "proc", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"proc", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"BrRatiosDPdata", "[", 
            RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
           RowBox[{"[", "i", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ListDecayProducts", "[", 
          RowBox[{"LLPsel", ",", "proc"}], "]"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"BrRatiosDPdata", "[", 
            RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
           RowBox[{"[", "i", "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"JetsPresence", "[", 
          RowBox[{"LLPsel", ",", "proc"}], "]"}], "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"proc", ",", "\"\<Jets\>\""}], "]"}], ",", "\"\<Yes\>\"", 
           ",", "\"\<No\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ListBrRatios", "[", 
          RowBox[{
          "LLPsel", ",", "mLLP_", ",", "proc", ",", "\"\<Default\>\""}], 
          "]"}], "=", 
         RowBox[{
          RowBox[{"ListBrRatiosTemp", "[", 
           RowBox[{
           "LLPsel", ",", "mLLP_", ",", "proc", ",", "\"\<Default\>\""}], 
           "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"BrRatiosDPdata", "[", 
             RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"ListDecayProducts", "[", 
               RowBox[{"LLPsel", ",", "proc"}], "]"}], ",", 
              RowBox[{
               RowBox[{"#", "!=", "\"\<Null\>\""}], "&"}]}], "]"}], "]"}], "==",
            "3"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Msquared3BodyLLP", "[", 
             RowBox[{
             "LLPsel", ",", "proc", ",", "E1_", ",", "E3_", ",", "mLLP_", 
              ",", "\"\<Default\>\""}], "]"}], "=", 
            RowBox[{
             RowBox[{
              RowBox[{"BrRatiosDPdata", "[", 
               RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]",
          "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]",
      ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", 
        RowBox[{"BrRatiosDPdata", "[", 
         RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "]"}], ",", "1"}], 
      "}"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ListBrRatios", "[", 
       RowBox[{"LLPsel", ",", "mLLP_", ",", "proc", ",", "\"\<Default\>\""}], 
