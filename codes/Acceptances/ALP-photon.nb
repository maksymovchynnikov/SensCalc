         RowBox[{"ListBrRatiosTemp", "[", 
          RowBox[{"LLPsel", ",", "mLLP", ",", "pr", ",", "\"\<Default\>\""}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"pr", ",", 
           RowBox[{"ProcessesList", "[", 
            RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}]}], "}"}]}], 
        "]"}]}]}], "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"proc", ",", 
       RowBox[{"ProcessesList", "[", 
        RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}]}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", "\"\<All processes with at least two charged particles:\>\"",
     "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ProcessesList", "[", 
     RowBox[{"LLPsel", ",", "\"\<False\>\""}], "]"}], "=", 
    RowBox[{"procListnoecal", "[", "LLPsel", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<Processes with jets:\>\"", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"ProcessesList", "[", 
      RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"JetsPresence", "[", 
        RowBox[{"LLPsel", ",", "#"}], "]"}], "==", "\"\<Yes\>\""}], "&"}]}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{
