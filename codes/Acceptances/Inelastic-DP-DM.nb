Cell[CellGroupData[{

Cell["Model description and all the definitions", "Subsection",
 CellChangeTimes->{{3.9506926867608128`*^9, 3.9506926926469193`*^9}, {
  3.9511983917763844`*^9, 
  3.9511983985657444`*^9}},ExpressionUUID->"8824d8d8-95d1-c74c-99e7-\
187cf769438e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"modelInfo", "[", "mLLP_", "]"}], "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], 
         "//", "ParentDirectory"}], ",", "\"\<phenomenology\>\"", ",", 
        "\"\<Inelastic-DP-DM\>\"", ",", "\"\<decay widths\>\"", ",", 
        "\"\<ctau.mx\>\""}], "}"}], "]"}], ",", "\"\<MX\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"LLPsel", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"modelInfo", "[", "mLLP", "]"}], "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"decdescr", "=", "\"\<Default\>\""}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"descrDefault", "[", "LLPsel", "]"}], "=", "decdescr"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"m\[Chi]1TomVval", "[", "LLPsel", "]"}], "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"modelInfo", "[", "mLLP", "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[CapitalDelta]val", "[", "LLPsel", "]"}], "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"modelInfo", "[", "mLLP", "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"couplingSymbol", "[", "LLPsel", "]"}], "=", 
       "\[Epsilon]2\[Alpha]D"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"DecayDescriptionExplanation", "[", 
        RowBox[{"LLPsel", ",", "decdescr"}], "]"}], "=", 
       "\"\<Calculation of the decay widths following Ref. 2012.08595 for the \
decay widths, using Hidden Local Symmetry approach to calculate the matrix \
elements of 3-body decays. Exclusive hadronic decays are then matched to \
decays calculated using perturbative QCD\>\""}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"c\[Tau]LLP", "[", 
        RowBox[{
        "LLPsel", ",", "decdescr", ",", "mLLP_", ",", 
         "\[Epsilon]2\[Alpha]D_"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"modelInfo", "[", "mLLP", "]"}], "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ModelDescription", "[", "LLPsel", "]"}], "=", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Two fermions \[Chi], \[Chi]' with mass splitting \
\[CapitalDelta] = (\!\(\*SubscriptBox[\(m\), \(\[Chi]'\)]\) - \
\!\(\*SubscriptBox[\(m\), \(\[Chi]\)]\))/\!\(\*SubscriptBox[\(m\), \(\(\[Chi]\
\)\(\\\ \)\)]\)<< 1, coupled to the dark photons V via L = \!\(\*SqrtBox[\(4 \
\*SubscriptBox[\(\[Pi]\[Alpha]\), \(D\)]\)]\)\!\(\*SuperscriptBox[\(V\), \(\
\[Mu]\)]\)\!\(\*OverscriptBox[\(\[Chi]\), \(_\)]\)'\!\(\*SubscriptBox[\(\
\[Gamma]\), \(\[Mu]\)]\)\[Chi] + h.c. It is assumed that \
\!\(\*SubscriptBox[\(m\), \(V\)]\)>\!\(\*SubscriptBox[\(m\), \(\[Chi]\)]\)+\!\
\(\*SubscriptBox[\(m\), \(\[Chi]'\)]\). The value of \[CapitalDelta] is fixed \
by \[CapitalDelta] = \>\"", ",", 
          RowBox[{"ToString", "[", 
           RowBox[{"\[CapitalDelta]val", "[", "LLPsel", "]"}], "]"}], ",", 
          "\"\<, while \!\(\*SubscriptBox[\(m\), \
\(\[Chi]\)]\)/\!\(\*SubscriptBox[\(m\), \(V\)]\) = \>\"", ",", 
          RowBox[{"ToString", "[", 
           RowBox[{"m\[Chi]1TomVval", "[", "LLPsel", "]"}], "]"}], ",", 
          
          "\"\<. See 2012.08595 for the description of decays of \[Chi]' and \
2409.11096 for the phenomenology of production of dark photons\>\""}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mXval", "[", 
        RowBox[{"LLPsel", ",", "mLLP_"}], "]"}], "=", 
       RowBox[{"mX", "/.", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{
            FractionBox[
             RowBox[{"mLLP", "-", "mX"}], "mLLP"], "==", 
            RowBox[{"\[CapitalDelta]val", "[", "LLPsel", "]"}]}], ",", "mX"}],
           "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"filepheno", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"NotebookDirectory", "[", "]"}], "//", 
            "ParentDirectory"}], "//", "ParentDirectory"}], ",", 
          "\"\<phenomenology\>\"", ",", "\"\<ModelDescriptors.mx\>\""}], 
         "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rowtoadd", "=", 
       RowBox[{"{", 
        RowBox[{"LLPsel", ",", 
         RowBox[{"ModelDescription", "[", "LLPsel", "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"FileExistsQ", "[", "filepheno", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"file", "=", 
          RowBox[{"{", "rowtoadd", "}"}]}], ";"}], "\[IndentingNewLine]", ",",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"file", "=", 
          RowBox[{"Import", "[", 
           RowBox[{"filepheno", ",", "\"\<MX\>\""}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"file", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"file", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "!=", "LLPsel"}], "&"}]}], 
             "]"}], ",", 
            RowBox[{"{", "rowtoadd", "}"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{"filepheno", ",", 
        RowBox[{"SortBy", "[", 
         RowBox[{"file", ",", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "&"}]}], "]"}], ",", 
        "\"\<MX\>\""}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", 
     RowBox[{"Length", "[", 
      RowBox[{"modelInfo", "[", "mLLP", "]"}], "]"}], ",", "1"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"InelasticDPModelList", "=", 
  RowBox[{
   RowBox[{"modelInfo", "[", "mLLP", "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.950692693496708*^9, 3.9506927822852573`*^9}, {
   3.9506928195256615`*^9, 3.9506928222656727`*^9}, {3.950692990855385*^9, 
   3.950693547593548*^9}, {3.9506939530254307`*^9, 3.95069395566675*^9}, 
