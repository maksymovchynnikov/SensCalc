Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BrRatiosInelasticDPdata", "[", 
     RowBox[{"mLLP_", ",", "E1_", ",", "E3_"}], "]"}], "=", 
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}],
           "//", "ParentDirectory"}], ",", "\"\<phenomenology\>\"", 
         ",", "\"\<Inelastic-DP-DM\>\"", 
         ",", "\"\<decay widths/BrRatiosMatrixElements.mx\>\""}], "}"}], 
       "]"}], ",", "\"\<MX\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "List", " ", "of", " ", "all", " ", "representative", " ", "processes"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"LLPsel", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"BrRatiosInelasticDPdata", "[", 
        RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dataset", "[", 
      RowBox[{"mLLP_", ",", "E1_", ",", "E3_"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"BrRatiosInelasticDPdata", "[", 
        RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}], "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ProcessesList", "[", 
      RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}], "=", 
     RowBox[{
      RowBox[{"dataset", "[", 
       RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "proc", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"proc", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"dataset", "[", 
             RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
            RowBox[{"[", "j", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ListDecayProducts", "[", 
           RowBox[{"LLPsel", ",", "proc"}], "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"dataset", "[", 
             RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
            RowBox[{"[", "j", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"JetsPresence", "[", 
           RowBox[{"LLPsel", ",", "proc"}], "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"StringContainsQ", "[", 
             RowBox[{"proc", ",", "\"\<Jets\>\""}], "]"}], ",", "\"\<Yes\>\"",
             ",", "\"\<No\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ListBrRatios", "[", 
           RowBox[{"LLPsel", ",", "mLLP_", ",", "proc", ",", "decdescr"}], 
           "]"}], "=", 
          RowBox[{
           RowBox[{"ListBrRatiosTemp", "[", 
            RowBox[{"LLPsel", ",", "mLLP_", ",", "proc", ",", "decdescr"}], 
            "]"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"dataset", "[", 
              RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
             RowBox[{"[", "j", "]"}], "]"}], "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"ListDecayProducts", "[", 
                RowBox[{"LLPsel", ",", "proc"}], "]"}], ",", 
               RowBox[{
                RowBox[{"#", "!=", "\"\<Null\>\""}], "&"}]}], "]"}], "]"}], "==",
             "3"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Msquared3BodyLLP", "[", 
              RowBox[{
              "LLPsel", ",", "proc", ",", "E1_", ",", "E3_", ",", "mLLP_", ",",
                "decdescr"}], "]"}], "=", 
             RowBox[{
              RowBox[{
               RowBox[{"dataset", "[", 
                RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
               RowBox[{"[", "j", "]"}], "]"}], "[", 
              RowBox[{"[", "4", "]"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
       "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"ProcessesList", "[", 
          RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}], "]"}], ",", "1"}], 
       "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ProcessesList", "[", 
      RowBox[{"LLPsel", ",", "\"\<False\>\""}], "]"}], "=", 
     RowBox[{"procListnoecal", "[", "LLPsel", "]"}]}]}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", 
     RowBox[{"Length", "[", 
      RowBox[{"BrRatiosInelasticDPdata", "[", 
       RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "]"}], ",", "1"}], 
    "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<All processes with at least two charged particles:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"#", ",", 
     RowBox[{"ProcessesList", "[", 
      RowBox[{"#", ",", "\"\<False\>\""}], "]"}]}], "}"}], "&"}], "/@", 
  "InelasticDPModelList"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Processes with jets:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{"ProcessesList", "[", 
    RowBox[{
     RowBox[{"InelasticDPModelList", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<True\>\""}], "]"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"JetsPresence", "[", 
      RowBox[{
       RowBox[{"InelasticDPModelList", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", "#"}], "]"}], 
     "==", "\"\<Yes\>\""}], "&"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"listDecayDescriptions", "[", "LLP", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Keys", "[", 
             RowBox[{"DownValues", "@", "ListBrRatios"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", "LLP"}], "&"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}], "//", "DeleteDuplicates"}]}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"LLP", ",", "InelasticDPModelList"}], "}"}]}], "]"}]}], "Input",
