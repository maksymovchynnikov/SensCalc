Cell["Decays", "Section", ExpressionUUID->"9022508f-b0c2-468b-ad5a-358e6df64d02"],
Cell[BoxData[RowBox[{RowBox[{"LLPsel", "=", "\"ALP-electroweak\""}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"descrDefault", "[", "LLPsel", "]"}], "=", "\"Default\""}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ProcessesList", "[", RowBox[{"LLPsel", ",", "\"True\""}], "]"}], "=", RowBox[{"{", "\"2gamma\"", "}"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ProcessesList", "[", RowBox[{"LLPsel", ",", "\"False\""}], "]"}], "=", RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ListDecayProducts", "[", RowBox[{"LLPsel", ",", "\"2gamma\""}], "]"}], "=", RowBox[{"{", RowBox[{RowBox[{"ParamPDGidToProduct", "[", "22.`", "]"}], ",", RowBox[{"ParamPDGidToProduct", "[", "22.`", "]"}], ",", "\"Null\"", ",", "\"Null\""}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"JetsPresence", "[", RowBox[{"LLPsel", ",", "\"2gamma\""}], "]"}], "=", "\"No\""}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ListBrRatios", "[", RowBox[{"LLPsel", ",", "mLLP_", ",", "\"2gamma\"", ",", "\"Default\""}], "]"}], "=", RowBox[{RowBox[{"ListBrRatiosTemp", "[", RowBox[{"LLPsel", ",", "mLLP_", ",", "\"2gamma\"", ",", "\"Default\""}], "]"}], "=", "1.`"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"listDecayDescriptions", "[", "LLPsel", "]"}], "=", RowBox[{"{", "\"Default\"", "}"}]}], ";"}]], "Input", ExpressionUUID->"cfafa8fe-1073-440c-9db6-9d6e3d8f16bd"]
