Notebook[{
Cell["ALP-electroweak", "Title", ExpressionUUID->"d3fcb6ec-b94c-4c81-817b-920b05242448"],

Cell[CellGroupData[{
Cell["Model", "Section", ExpressionUUID->"a592f1b6-26e8-416e-9d15-34c47faf59c3"],
Cell[BoxData[RowBox[{RowBox[{"LLPsel", "=", "\"ALP-electroweak\""}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ModelDescription", "[", "LLPsel", "]"}], "=", TemplateBox[{"\"Pure SU(2)L ALP: L = C_W a W^I_mu nu Wtilde^I mu nu, C_W = alpha_2 gW/(4 Pi). The coupling gW is in GeV^-1; g_agammagamma = (alpha_em/Pi) gW. This is the diphoton benchmark of arXiv:2609.19269 and EventCalc-SHiP/ALP_SU2L. BR(a -> gamma gamma) = 1; subleading modes are neglected. B and charged-K decays plus primary/cascade Primakov production use the existing samplers.\""}, "RowDefault"]}], ";", "\[IndentingNewLine]", RowBox[{"filepheno", "=", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"ParentDirectory", "[", RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}], "]"}], ",", "\"phenomenology\"", ",", "\"ModelDescriptors.mx\""}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"rowtoadd", "=", RowBox[{"{", RowBox[{"LLPsel", ",", RowBox[{"ModelDescription", "[", "LLPsel", "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{"file", "=", RowBox[{"If", "[", RowBox[{RowBox[{"FileExistsQ", "[", "filepheno", "]"}], ",", RowBox[{"Join", "[", RowBox[{RowBox[{"Select", "[", RowBox[{RowBox[{"Import", "[", RowBox[{"filepheno", ",", "\"MX\""}], "]"}], ",", RowBox[{RowBox[{RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[NotEqual]", "LLPsel"}], "&"}]}], "]"}], ",", RowBox[{"{", "rowtoadd", "}"}]}], "]"}], ",", RowBox[{"{", "rowtoadd", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"Export", "[", RowBox[{"filepheno", ",", RowBox[{"SortBy", "[", RowBox[{"file", ",", RowBox[{RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "&"}]}], "]"}], ",", "\"MX\""}], "]"}], ";"}]], "Input", ExpressionUUID->"11ee6acb-6801-4f5f-a9f6-37afb89a7a4c"]
}, Open]],

Cell[CellGroupData[{
Cell["Lifetime", "Section", ExpressionUUID->"3b221d4a-062d-48b6-9a80-8a2a70cb79c3"],
Cell[BoxData[RowBox[{RowBox[{"LLPsel", "=", "\"ALP-electroweak\""}], ";", "\[IndentingNewLine]", RowBox[{"c\[Tau]Data", "=", RowBox[{"Import", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"ParentDirectory", "[", RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}], "]"}], ",", "\"phenomenology\"", ",", "LLPsel", ",", "\"decay widths\"", ",", "\"ctauALP.txt\""}], "}"}], "]"}], ",", "\"Table\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"c\[Tau]LLP", "[", RowBox[{"LLPsel", ",", "\"Default\"", ",", "ma_", ",", "gW_"}], "]"}], "=", FractionBox[RowBox[{"Exp", "[", RowBox[{RowBox[{"Interpolation", "[", RowBox[{RowBox[{"Log", "[", "c\[Tau]Data", "]"}], ",", RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}], "[", RowBox[{"Log", "[", "ma", "]"}], "]"}], "]"}], SuperscriptBox["gW", "2"]]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"couplingSymbol", "[", "LLPsel", "]"}], "=", "gW"}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"DecayDescriptionExplanation", "[", RowBox[{"LLPsel", ",", "\"Default\""}], "]"}], "=", "\"Diphoton-only benchmark, BR=1. Tabulated ctau in metres at gW=1 GeV^-1; Gamma = alpha_em^2 m_a^3 gW^2/(64 Pi^3).\""}], ";"}]], "Input", ExpressionUUID->"4ad7e7c0-271e-4f12-9557-51bd8b7a21fd"]
}, Open]],

