Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LLPsel", "=", "\"\<ALP-fermion\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"filesDecay", "=", 
   RowBox[{"FileNames", "[", 
    RowBox[{"\"\<Widths*\>\"", ",", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], 
         "//", "ParentDirectory"}], ",", "\"\<phenomenology\>\"", ",", 
        "LLPsel", ",", "\"\<decay widths\>\""}], "}"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"descrlist", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"StringSplit", "[", 
      RowBox[{
       RowBox[{"FileNameTake", "[", "#", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<GeV-\>\"", ",", "\"\<.m\>\""}], "}"}]}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", 
   "filesDecay"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Default description:\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"descrDefault", "[", "LLPsel", "]"}], "=", 
   RowBox[{"descrlist", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "List", " ", "of", " ", "widths", " ", "of", " ", "the", " ", "ALP", " ", 
    "into", " ", "various", " ", "final", " ", "states"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DecayWidthsDataTemp", "=", 
     RowBox[{"Import", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"NotebookDirectory", "[", "]"}], "//", 
            "ParentDirectory"}], "//", "ParentDirectory"}], ",", 
          "\"\<phenomenology\>\"", ",", "LLPsel", ",", "\"\<decay widths\>\"",
           ",", 
          RowBox[{
          "\"\<Widths-model-ALP-fermion-scale-1000.-GeV-\>\"", "<>", "descr", 
           "<>", "\"\<.m\>\""}]}], "}"}], "]"}], ",", "\"\<MX\>\""}], "]"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{"DecayWidthsDataTemp2", "=", 
     RowBox[{"DecayWidthsDataTemp", "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{"i", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"DecayWidthsDataTemp2", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "1"}], "}"}]}], 
         "]"}], ",", 
        RowBox[{"DecayWidthsDataTemp2", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "//", "TableForm"}], "]"}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"DecayWidthsData", "=", 
     RowBox[{"Drop", "[", 
      RowBox[{"DecayWidthsDataTemp2", ",", "3"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Total", " ", "decay", " ", "width", " ", "and", " ", "lifetime"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"totalwidthdata", "=", 
     RowBox[{"DecayWidthsData", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c\[Tau]LLP", "[", 
      RowBox[{"LLPsel", ",", "descr", ",", "mLLP_", ",", "finv_"}], "]"}], 
     "=", 
     RowBox[{"chbar", "/", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["1", 
           RowBox[{"2", "vh"}]], ")"}], "2"], 
        SuperscriptBox["y", "2"], "*", 
        RowBox[{
         RowBox[{"Interpolation", "[", 
          RowBox[{
           RowBox[{"DecayWidthsData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}], ",", 
           RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "mLLP", 
         "]"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"couplingSymbol", "[", "LLPsel", "]"}], "=", "y"}], ";"}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"descr", ",", "descrlist"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DecayDescriptionExplanation", "[", 
    RowBox[{"LLPsel", ",", "\"\<2310.03524\>\""}], "]"}], "=", 
   "\"\<Description of hadronic width of ALPs closely following 2310.03524: \
no inclusion of mixing of ALPs with heavy pseudoscalar excitations\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DecayDescriptionExplanation", "[", 
    RowBox[{"LLPsel", ",", "\"\<2501.04525\>\""}], "]"}], "=", 
   "\"\<Description of the ALP widths from 2501.04525: invariance under \
chiral rotation parameters, inclusion of mixing of ALPs with heavy \
pseudoscalar excitations\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"descr", "=", "\"\<PBC description\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c\[Tau]LLP", "[", 
    RowBox[{"LLPsel", ",", "descr", ",", "mLLP_", ",", "y_"}], "]"}], "=", 
   RowBox[{"chbar", "/", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["1", 
         RowBox[{"2", "vh"}]], ")"}], "2"], 
      SuperscriptBox["y", "2"], 
      RowBox[{
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"DecayWidthsData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"{", "1", "}"}]}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"DecayWidthsData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "+", 
            RowBox[{"DecayWidthsData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"{", "4", "}"}]}], "]"}], "]"}], "+", 
            RowBox[{"DecayWidthsData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"{", "5", "}"}]}], "]"}], "]"}]}], ",", "2"}], "]"}], 
         ",", 
         RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "mLLP", 
       "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DecayDescriptionExplanation", "[", 
    RowBox[{"LLPsel", ",", "descr"}], "]"}], "=", 
   "\"\<Description of hadronic width following the PBC report 1901.09966: no \
hadronic decays. It was widely used in the past\>\""}], ";"}]}], "Input",
