Cell["Model description", "Subsection",
 CellChangeTimes->{{3.9506926867608128`*^9, 
  3.9506926926469193`*^9}},ExpressionUUID->"636bc0c7-6a7c-8141-92cf-\
90ed253e8097"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LLPsel", "=", "\"\<ALP-fermion\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ModelDescription", "[", "LLPsel", "]"}], "=", 
   RowBox[{"Row", "[", 
    RowBox[{
    "{", "\"\<Axion-like particle a with the phenomenological Lagrangian L = \
\!\(\*SubscriptBox[\(c\), \(f\)]\)\!\(\*FractionBox[\((\*SubscriptBox[\(d\), \
\(\[Mu]\)] a)\), SubscriptBox[\(f\), \(a\)]]\)\!\(\*OverscriptBox[\(f\), \
\(_\)]\)\!\(\*SuperscriptBox[\(\[Gamma]\), \(\[Mu]\)]\)\!\(\*SubscriptBox[\(\
\[Gamma]\), \(5\)]\)f. The Lagrangian is defined at some scale \
\[CapitalLambda], with \!\(\*SubscriptBox[\(c\), \(G\)]\), \
\!\(\*SubscriptBox[\(f\), \(a\)]\) being the couplings \
(\!\(\*SubscriptBox[\(f\), \(a\)]\) is in general unrelated to \
\[CapitalLambda]). f is the SM fermion field. The particula value \
\!\(\*SubscriptBox[\(c\), \(f\)]\) = 1 at \[CapitalLambda] = 1 TeV is called \
BC10 within PBC benchmarking (1901.09966). In this model, initially, ALPs \
universally couple to fermions; however, the RG flow down to scales of \
interest destroys the universality. See 2110.10698, 2310.03524, and \
2501.04525 for the phenomenology description\>\"", "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"filepheno", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], "//",
        "ParentDirectory"}], ",", "\"\<phenomenology\>\"", ",", 
      "\"\<ModelDescriptors.mx\>\""}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rowtoadd", "=", 
   RowBox[{"{", 
    RowBox[{"LLPsel", ",", 
     RowBox[{"ModelDescription", "[", "LLPsel", "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"!", 
    RowBox[{"FileExistsQ", "[", "filepheno", "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"file", "=", 
     RowBox[{"{", "rowtoadd", "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"file", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"filepheno", ",", "\"\<MX\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"file", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"file", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "!=", "LLPsel"}], "&"}]}], "]"}], 
       ",", 
       RowBox[{"{", "rowtoadd", "}"}]}], "]"}]}], ";"}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"filepheno", ",", 
    RowBox[{"SortBy", "[", 
     RowBox[{"file", ",", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "&"}]}], "]"}], ",", "\"\<MX\>\""}], 
   "]"}], ";"}]}], "Input",
