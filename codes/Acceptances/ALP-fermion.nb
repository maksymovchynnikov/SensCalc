ox[{"descr", "=", "\"PBC description\""}], ";"}], "Null", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"data", ",", RowBox[{"channels", "=", RowBox[{"{", RowBox[{"\"2e\"", ",", "\"2\[Mu]\"", ",", "\"2\[Tau]\""}], "}"}]}], ",", "columns"}], "}"}], ",", RowBox[{RowBox[{"data", "=", RowBox[{RowBox[{"Import", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"ParentDirectory", "[", RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}], "]"}], ",", "\"phenomenology\"", ",", "LLPsel", ",", "\"decay widths\"", ",", "\"Widths-model-ALP-fermion-scale-1000.-GeV-2310.03524.m\""}], "}"}], "]"}], ",", "\"MX\""}], "]"}], "[[", "4", "]]"}]}], ";", RowBox[{"columns", "=", RowBox[{RowBox[{"(", RowBox[{RowBox[{"First", "[", RowBox[{"FirstPosition", "[", RowBox[{RowBox[{"data", "[[", "1", "]]"}], ",", "#1"}], "]"}], "]"}], "&"}], ")"}], "/@", "channels"}]}], ";", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"DecayWidthALPFermionPBC", "[", RowBox[{RowBox[{"channels", "[[", "i", "]]"}], ",", "mLLP_"}], "]"}], "=", RowBox[{RowBox[{"Interpolation", "[", RowBox[{RowBox[{RowBox[{"Drop", "[", RowBox[{"data", ",", "3"}], "]"}], "[[", RowBox[{"All", ",", RowBox[{"{", RowBox[{"1", ",", RowBox[{"columns", "[[", "i", "]]"}]}], "}"}]}], "]]"}], ",", RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "mLLP", "]"}]}], ",", RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", "channels", "]"}]}], "}"}]}], "]"}], ";", RowBox[{RowBox[{"c\[Tau]LLP", "[", RowBox[{"LLPsel", ",", "descr", ",", "mLLP_", ",", "y_"}], "]"}], "=", FractionBox["chbar", RowBox[{SuperscriptBox[RowBox[{"(", FractionBox["y", RowBox[{"2", " ", "vh"}]], ")"}], "2"], " ", RowBox[{"Total", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"DecayWidthALPFermionPBC", "[", RowBox[{"#1", ",", "mLLP"}], "]"}], "&"}], ")"}], "/@", "channels"}], "]"}]}]]}]}]}], "]"}], ";"}], ")"}], ";"}], "Null", RowBox[{RowBox[{RowBox[{"DecayDescriptionExplanation", "[", RowBox[{"