Cell[BoxData[{
 RowBox[{
  RowBox[{"LLPsel", "=", "\"\<Scalar\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ModelDescription", "[", "LLPsel", "]"}], "=", 
   RowBox[{"Row", "[", 
    RowBox[{
    "{", "\"\<Higgs-like scalar S with the phenomenological Lagrangian L = \!\
\(\*SubscriptBox[SuperscriptBox[\(\[Theta]m\), \(2\)], \(h\)]\) hS + \
\!\(\*FractionBox[\(\[Alpha]\), \(2\)]\)\!\(\*SuperscriptBox[\(hS\), \
\(2\)]\), where \[Theta] is called the mixing angle and h is the Higgs boson. \
The coupling \[Alpha] is often expressed in terms of the fixed \
\!\(\*SubscriptBox[\(Br\), \(h \[Rule] SS\)]\). The model with \[Alpha] = 0 \
is called BC4 within PBC benchmarking, while the model with \
\!\(\*SubscriptBox[\(Br\), \(h \[Rule] SS\)]\) = 0.01 is called BC5 \
(1901.09966). See 1904.10447, 2407.13587, and 2503.01760 for details on the \
phenomenology\>\"", "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"filepheno", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], "//",
        "ParentDirectory"}], ",", "\"\<phenomenology\>\"", 
      ",", "\"\<ModelDescriptors.mx\>\""}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rowtoadd", "=", 
   RowBox[{"{", 
    RowBox[{"LLPsel", ",", 
     RowBox[{"ModelDescription", "[", "LLPsel", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"!", 
    RowBox[{"FileExistsQ", "[", "filepheno", "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"file", "=", 
     RowBox[{"{", "rowtoadd", "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"file", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"filepheno", ",", "\"\<MX\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"file", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"file", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "!=", "LLPsel"}], "&"}]}], "]"}], 
