Cell[BoxData[{
 RowBox[{
  RowBox[{"c\[Tau]ListXX", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], 
