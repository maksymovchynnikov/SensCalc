        "LLPsel", ",", "\"\<decay widths/ctauS.mx\>\""}], "}"}], "]"}], 
     ",", "\"\<MX\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<List of all decay phenomenology descriptions:\>\"",
   "]"}], "\[IndentingNewLine]", 
 RowBox[{"decayDescriptionsScalar", "=", 
  RowBox[{"c\[Tau]ListXX", "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Default description:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"descrDefault", "[", "LLPsel", "]"}], "=", 
  RowBox[{"decayDescriptionsScalar", "[", 
   RowBox[{"[", "1", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"descr", "=", 
        RowBox[{
         RowBox[{"c\[Tau]ListXX", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"c\[Tau]LLP", "[", 
         RowBox[{"LLPsel", ",", "descr", ",", "mLLP_", ",", "\[Theta]2_"}], 
         "]"}], "=", 
        RowBox[{
         FractionBox["1", "\[Theta]2"], "*", 
         RowBox[{"10", "^", 
          RowBox[{
           RowBox[{"Interpolation", "[", 
            RowBox[{
             RowBox[{"Log10", "[", 
              RowBox[{
               RowBox[{"c\[Tau]ListXX", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
             RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
           RowBox[{"Log10", "[", "mLLP", "]"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"couplingSymbol", "[", "LLPsel", "]"}], "=", "\[Theta]2"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "c\[Tau]ListXX", "]"}], ",", "1"}], "}"}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DecayDescriptionExplanation", "[", 
    RowBox[{"LLPsel", ",", "\"\<1809.01876\>\""}], "]"}], "=", 
   RowBox[{
    RowBox[{"DecayDescriptionExplanation", "[", 
     RowBox[{"LLPsel", ",", 
      RowBox[{"decayDescriptionsScalar", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}], 
    "=", "\"\<Description following 1809.01876: below \
\!\(\*SubscriptBox[\(m\), \(S\)]\) = 2 GeV, hadronic decays are approximated \
by \[Pi]\[Pi], KK, plus the 4\[Pi], which is added by hand and adjusted such \
that the total exclusive hadronic width matches the perturbative QCD \
width\>\""}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DecayDescriptionExplanation", "[", 
    RowBox[{"LLPsel", ",", 
     RowBox[{"decayDescriptionsScalar", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], "]"}], 
   "=", "\"\<Description of decays into \[Pi]\[Pi] and KK following \
2407.13587 (central value), plus added fake 4\[Pi] decay as in 1809.01876 to \
match \[Pi]\[Pi]+KK+4\[Pi] with perturbative QCD width\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DecayDescriptionExplanation", "[", 
    RowBox[{"LLPsel", ",", 
     RowBox[{"decayDescriptionsScalar", "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], "]"}], 
   "=", "\"\<Description of decays into \[Pi]\[Pi] and KK following \
2407.13587 (lower value), plus added fake 4\[Pi] decay as in 1809.01876 to \
match \[Pi]\[Pi]+KK+4\[Pi] with perturbative QCD width\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DecayDescriptionExplanation", "[", 
    RowBox[{"LLPsel", ",", 
     RowBox[{"decayDescriptionsScalar", "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], "]"}], 
   "=", "\"\<Description of decays into \[Pi]\[Pi] and KK following \
2407.13587 (upper value), plus added fake 4\[Pi] decay as in 1809.01876 to \
match \[Pi]\[Pi]+KK+4\[Pi] with perturbative QCD width\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]2val", "=", 
   SuperscriptBox["10", 
    RowBox[{"-", "12."}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotc\[Tau]", "=", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"c\[Tau]LLP", "[", 
         RowBox[{"LLPsel", ",", "#", ",", "mLLP", ",", "\[Theta]2val"}], 
         "]"}], "&"}], "/@", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "\"\<Default\>\"", "}"}], ",", 
         RowBox[{"Drop", "[", 
