Cell[BoxData[{
 RowBox[{
  RowBox[{"LLPsel", "=", "LLPselGen"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BrRatiosDPdata", "[", 
     RowBox[{"mLLP_", ",", "E1_", ",", "E3_"}], "]"}], "=", 
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}],
           "//", "ParentDirectory"}], ",", "\"\<phenomenology\>\"", ",", 
         "LLPsel", ",", "\"\<decay widths/BrRatios.mx\>\""}], "}"}], "]"}], 
      ",", "\"\<MX\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "List", " ", "of", " ", "all", " ", "representative", " ", "processes"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ProcessesList", "[", 
     RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}], "=", 
    RowBox[{
     RowBox[{"BrRatiosDPdata", "[", 
      RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "proc", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"proc", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"BrRatiosDPdata", "[", 
           RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ListDecayProducts", "[", 
         RowBox[{"LLPsel", ",", "proc"}], "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"BrRatiosDPdata", "[", 
           RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"JetsPresence", "[", 
         RowBox[{"LLPsel", ",", "proc"}], "]"}], "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", 
           RowBox[{"proc", ",", "\"\<Jets\>\""}], "]"}], ",", "\"\<Yes\>\"", 
          ",", "\"\<No\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"ListBrRatios", "[", 
            RowBox[{"LLPsel", ",", "mLLP_", ",", "proc", ",", "descr"}], 
            "]"}], "=", 
           RowBox[{
            RowBox[{"ListBrRatiosTemp", "[", 
             RowBox[{"LLPsel", ",", "mLLP_", ",", "proc", ",", "descr"}], 
             "]"}], "=", 
            RowBox[{
             RowBox[{
              RowBox[{"BrRatiosDPdata", "[", 
               RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"ListDecayProducts", "[", 
                 RowBox[{"LLPsel", ",", "proc"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"#", "!=", "\"\<Null\>\""}], "&"}]}], "]"}], "]"}], "==",
              "3"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"Msquared3BodyLLP", "[", 
               RowBox[{
               "LLPsel", ",", "proc", ",", "E1_", ",", "E3_", ",", "mLLP_", 
                ",", "descr"}], "]"}], "=", 
              RowBox[{
               RowBox[{
                RowBox[{"BrRatiosDPdata", "[", 
                 RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
