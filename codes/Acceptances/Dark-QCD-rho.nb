     RowBox[{"FileExistsQ", "[", "filepheno", "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"file", "=", 
      RowBox[{"{", "rowtoadd", "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"file", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"filepheno", ",", "\"\<MX\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"file", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"file", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "!=", "LLPsel"}], "&"}]}], "]"}],
         ",", 
        RowBox[{"{", "rowtoadd", "}"}]}], "]"}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"filepheno", ",", 
    RowBox[{"SortBy", "[", 
     RowBox[{"file", ",", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "&"}]}], "]"}], ",", "\"\<MX\>\""}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"file", ";"}]}], "Input",
 CellChangeTimes->{{3.950692693496708*^9, 3.9506927822852573`*^9}, {
