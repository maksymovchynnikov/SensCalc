Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LLPsel", "=", "LLPselGen"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Kappa]In\[CapitalLambda]2", "[", 
   RowBox[{"\[CapitalLambda]2_", ",", "mZpr_"}], "]"}], "=", 
  RowBox[{
   RowBox[{"\[Kappa]", "/.", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", 
           SuperscriptBox["mZpr", "2"]], "*", "\[Kappa]", "*", "ed", "*", 
          "e"}], ")"}], "==", 
        FractionBox["1", "\[CapitalLambda]2"]}], ",", "\[Kappa]"}], "]"}], 
     "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ed", "->", "1"}], ",", 
     RowBox[{"e", "->", 
      SqrtBox[
       RowBox[{"4", "Pi", "*", 
        RowBox[{"1", "/", "137."}]}]]}]}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Epsilon]2Eff", "[", 
   RowBox[{"LLPsel", ",", "\[CapitalLambda]2_", ",", "g\[Pi]d\[Rho]d_"}], 
   "]"}], "=", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"2", "*", 
     FractionBox[
      SuperscriptBox["mLLP", "2"], 
      RowBox[{"g\[Pi]d\[Rho]d", "*", 
       SuperscriptBox["mZpr", "2"]}]], 
     RowBox[{"\[Kappa]In\[CapitalLambda]2", "[", 
      RowBox[{"\[CapitalLambda]2", ",", "mZpr"}], "]"}]}], ")"}], 
   "2"]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalGamma]LLP", "[", 
     RowBox[{"mLLP_", ",", "\[CapitalLambda]2_", ",", "g\[Pi]d\[Rho]d_"}], 
     "]"}], "=", 
    RowBox[{
     RowBox[{"\[Epsilon]2Eff", "[", 
      RowBox[{"LLPsel", ",", "\[CapitalLambda]2", ",", "g\[Pi]d\[Rho]d"}], 
      "]"}], "*", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Log10", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
              RowBox[{"Log10", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
           RowBox[{"Import", "[", 
            RowBox[{
             RowBox[{"FileNameJoin", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"NotebookDirectory", "[", "]"}], "//", 
                  "ParentDirectory"}], "//", "ParentDirectory"}], ",", 
                "\"\<phenomenology\>\"", ",", "LLPsel", ",", 
                "\"\<decay widths\>\"", ",", "\"\<Decay-Width-DP.txt\>\""}], 
               "}"}], "]"}], ",", "\"\<Table\>\""}], "]"}]}], ",", 
          RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}], "[", 
        RowBox[{"Log10", "[", "mLLP", "]"}], "]"}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Decay", " ", "length"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c\[Tau]LLP", "[", 
    RowBox[{
    "LLPsel", ",", "\"\<2203.08824\>\"", ",", "mLLP_", ",", 
     "\[CapitalLambda]2_"}], "]"}], "=", 
