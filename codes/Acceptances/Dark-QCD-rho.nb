Cell["Model description", "Subsection",
 CellChangeTimes->{{3.9506926867608128`*^9, 
  3.9506926926469193`*^9}},ExpressionUUID->"360473b3-2ae2-1f43-9c69-\
e56b26fafa52"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LLPselGen", "=", "\"\<Dark-QCD-rho\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mZprVal", "=", 
   SuperscriptBox["10", "3."]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LLPsel", "=", "LLPselGen"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ModelDescription", "[", "LLPsel", "]"}], "=", 
   RowBox[{"Row", "[", 
    RowBox[{
    "{", "\"\<Dark \[Rho] meson \!\(\*SubscriptBox[\(\[Rho]\), \(D\)]\) - a \
vector boson from dark QCD with stable \!\(\*SubscriptBox[\(\[Pi]\), \
\(D\)]\). Dark vector current with the charge \!\(\*SubscriptBox[\(e\), \
\(d\)]\) couples to a heavy Z' boson coupled to the EM current: L = \
\!\(\*FractionBox[\(\[Kappa]\), \(2 \*SubscriptBox[\(c\), \
\(W\)]\)]\)\!\(\*SubscriptBox[\(Z\), \
\(\[Mu]\[Nu]\)]\)\!\(\*SuperscriptBox[\(B\), \(\[Mu]\[Nu]\)]\). The model's \
parameters are \!\(\*SubscriptBox[\(m\), SubscriptBox[\(\[Rho]\), \(D\)]]\) \
and \[CapitalLambda], defined via \!\(\*FractionBox[\(1\), SuperscriptBox[\(\
\[CapitalLambda]\), \(2\)]]\) = \
\!\(\*FractionBox[\(\*SubscriptBox[\(\[Kappa]e\), \(d\)] e\), \
\(\*SubscriptBox[SuperscriptBox[\(m\), \(2\)], \(Z'\)] \
\*SubscriptBox[SubscriptBox[\(g\), \(\*SubscriptBox[\(\[Pi]\), \(d\)] \
\[Rho]\)], \(d\)]\)]\). The decay modes of \!\(\*SubscriptBox[\(\[Rho]\), \(D\
\)]\) are similar to the decay modes of the dark photon, with the effective \
`dark-photon-like` coupling \[Epsilon] = \
2\!\(\*FractionBox[SubscriptBox[SuperscriptBox[\(m\), \(2\)], SubscriptBox[\(\
\[Rho]\), \(D\)]], SubscriptBox[SuperscriptBox[\(m\), \(2\)], \
\(Z'\)]]\)\!\(\*FractionBox[\(\[Kappa]\\\ \*SubscriptBox[\(e\), \(d\)]\), \
SubscriptBox[SubscriptBox[\(g\), \(\*SubscriptBox[\(\[Pi]\), \(d\)] \
\[Rho]\)], \(d\)]]\)=2\!\(\*FractionBox[SubscriptBox[SuperscriptBox[\(m\), \
\(2\)], SubscriptBox[\(\[Rho]\), \(d\)]], \(\*SuperscriptBox[\(\
\[CapitalLambda]\), \(2\)] \*SuperscriptBox[\(e\), \(2\)]\)]\). The \
dimensional scale \[CapitalLambda] is introduced using the formula \
\!\(\*FractionBox[\(1\), SuperscriptBox[\(\[CapitalLambda]\), \(2\)]]\) = \
\!\(\*FractionBox[\(\*SubscriptBox[\(\[Kappa]e\), \(d\)] e\), \
SubscriptBox[SuperscriptBox[\(m\), \(2\)], \(Z'\)]]\). Details on the \
phenomenology may be found in 2203.08824 and 2311.17157\>\"", "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"filepheno", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], "//", "ParentDirectory"}], "//",
        "ParentDirectory"}], ",", "\"\<phenomenology\>\"", ",", 
      "\"\<ModelDescriptors.mx\>\""}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
