           "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"descr", ",", "descrs"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"BrRatiosDPdata", "[", 
        RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}], "]"}], ",", "1"}], 
     "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"ListBrRatios", "[", 
        RowBox[{"LLPsel", ",", "mLLP_", ",", "proc", ",", "descr"}], "]"}], 
       "=", 
       RowBox[{
        RowBox[{"ListBrRatiosTemp", "[", 
         RowBox[{"LLPsel", ",", "mLLP", ",", "proc", ",", "descr"}], "]"}], 
        "/", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"ListBrRatiosTemp", "[", 
           RowBox[{"LLPsel", ",", "mLLP", ",", "pr", ",", "descr"}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"pr", ",", 
            RowBox[{"ProcessesList", "[", 
             RowBox[{"LLPsel", ",", "\"\<True\>\""}], "]"}]}], "}"}]}], 
