 RowBox[{
  RowBox[{
   RowBox[{RowBox[{RowBox[{"BrRatiosDPdata", "[", RowBox[{"mLLP_", ",", "E1_", ",", "E3_"}], "]"}], "=", RowBox[{"Import", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"ParentDirectory", "[", RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}], "]"}], ",", "\"phenomenology\"", ",", "LLPsel", ",", "\"decay widths/BrRatios.mx\""}], "}"}], "]"}], ",", "\"MX\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"BrRatiosDPdata", "[", RowBox[{"mLLP_", ",", "E1_", ",", "E3_"}], "]"}], "=", RowBox[{RowBox[{"Function", "[", RowBox[{"row", ",", RowBox[{"If", "[", RowBox[{RowBox[{"MemberQ", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"310.`", ",", RowBox[{"-", "321.`"}], ",", "211.`"}], "}"}], ",", RowBox[{"{", RowBox[{"310.`", ",", "321.`", ",", RowBox[{"-", "211.`"}]}], "}"}], ",", RowBox[{"{", RowBox[{"321.`", ",", RowBox[{"-", "321.`"}], ",", "111.`"}], "}"}]}], "}"}], ",", RowBox[{"ParamProductToPDGid", "/@", RowBox[{"Take", "[", RowBox[{RowBox[{"row", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", "3"}], "]"}]}]}], "]"}], ",", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"products", "=", RowBox[{"row", "\[LeftDoubleBracket]", RowBox[{"2", ",", RowBox[{"{", RowBox[{"3", ",", "1", ",", "2", ",", "4"}], "}"}]}], "\[RightDoubleBracket]"}]}], ",", "masses", ",", "p1sq", ",", "p3sq", ",", "dot13", ",", "s12"}], "}"}], ",", RowBox[{RowBox[{"masses", "=", RowBox[{"ParamProductMass", "/@", RowBox[{"ParamProductToPDGid", "/@", RowBox[{"Take", "[", RowBox[{"products", ",", "3"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", RowBox[{"p1sq", "=", RowBox[{SuperscriptBox["E1", "2"], "-", SuperscriptBox[RowBox[{"masses", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "2"]}]}], ";", "\[IndentingNewLine]", RowBox[{"p3sq", "=", RowBox[{SuperscriptBox["E3", "2"], "-", SuperscriptBox[RowBox[{"masses", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "2"]}]}], ";", "\[IndentingNewLine]", RowBox[{"dot13", "=", RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", RowBox[{SuperscriptBox[RowBox[{"(", RowBox[{"mLLP", "-", "E1", "-", "E3"}], ")"}], "2"], "-", SuperscriptBox[RowBox[{"masses", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "2"], "-", "p1sq", "-", "p3sq"}], ")"}]}]}], ";", "\[IndentingNewLine]", RowBox[{"s12", "=", RowBox[{SuperscriptBox["mLLP", "2"], "+", SuperscriptBox[RowBox[{"masses", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "2"], "-", RowBox[{"2", " ", "mLLP", " ", "E3"}]}]}], ";", "\[IndentingNewLine]", RowBox[{"ReplacePart", "[", RowBox[{"row", ",", RowBox[{"{", RowBox[{RowBox[{"2", "\[Rule]", "products"}], ",", RowBox[{"4", "\[Rule]", FractionBox[RowBox[{RowBox[{"(", RowBox[{"4", " ", SuperscriptBox["mLLP", "2"], " ", RowBox[{"(", RowBox[{RowBox[{"p1sq", " ", "p3sq"}], "-", SuperscriptBox["dot13", "2"]}], ")"}]}], ")"}], " ", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"ParamProductToPDGid", "/@", RowBox[{"Take", "[", RowBox[{"products", ",", "3"}], "]"}]}], "\[Equal]", RowBox[{"{", RowBox[{"111.`", ",", "321.`", ",", RowBox[{"-", "321.`"}]}], "}"}]}], ",", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"d1", "=", RowBox[{"s12", "-", SuperscriptBox[RowBox[{"ParamProductMass", "[", "313.`", "]"}], "2"]}]}], ",", RowBox[{"d2", "=", RowBox[{SuperscriptBox["mLLP", "2"], "+", SuperscriptBox[RowBox[{"masses", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "2"], "-", RowBox[{"2", " ", "mLLP", " ", RowBox[{"(", RowBox[{"mLLP", "-", "E1", "-", "E3"}], ")"}]}], "-", SuperscriptBox[RowBox[{"ParamProductMass", "[", "313.`", "]"}], "2"]}]}], ",", RowBox[{"w", "=", RowBox[{"0.05`", " ", RowBox[{"ParamProductMass", "[", "313.`", "]"}]}]}]}], "}"}], ",", FractionBox[RowBox[{SuperscriptBox[RowBox[{"(", RowBox[{"d1", "+", "d2"}], ")"}], "2"], "+", RowBox[{"4", " ", SuperscriptBox["w", "2"]}]}], RowBox[{SuperscriptBox["d2", "2"], "+", SuperscriptBox["w", "2"]}]]}], "]"}], ",", "1.`"}], "]"}]}], RowBox[{SuperscriptBox[RowBox[{"(", RowBox[{"s12", "-", SuperscriptBox[RowBox[{"ParamProductMass", "[", "313.`", "]"}], "2"]}], ")"}], "2"], "+", SuperscriptBox[RowBox[{"(", RowBox[{"0.05`", " ", RowBox[{"ParamProductMass", "[", "313.`", "]"}]}], ")"}], "2"]}]]}]}], "}"}]}], "]"}]}]}], "]"}], ",", "row"}], "]"}]}], "]"}], "/@", RowBox[{"BrRatiosDPdata", "[", RowBox[{"mLLP", ",", "E1", ",", "E3"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
