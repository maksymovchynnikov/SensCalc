                 "]"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"ellpCM", "=", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox["pxmes", "2"], "+", 
                 SuperscriptBox["pymes", "2"], "+", 
                 SuperscriptBox["pzllpCM", "2"], "+", 
                 SuperscriptBox["mLLP", "2"]}]]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"LLP", "'"}], "s", " ", "kinematics", " ", "at", " ", 
