   RowBox[{
    RowBox[{
     RowBox[{"PcmPlab", "[", 
      RowBox[{"plab_", ",", "m_", ",", "Eplab_", ",", "mp_"}], "]"}], "=", 
     RowBox[{"Assuming", "[", 
