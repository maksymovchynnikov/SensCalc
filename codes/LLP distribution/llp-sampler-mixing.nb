                 "mixing"}]}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"\[Theta]llpFin", "=", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"!", "IfESS"}], ",", 
                 RowBox[{"ArcCos", "[", 
                  FractionBox["pzllpLab", 
                   SqrtBox[
                    RowBox[{
                    SuperscriptBox["pxllpLab", "2"], "+", 
                    SuperscriptBox["pyllpLab", "2"], "+", 
                    SuperscriptBox["pzllpLab", "2"]}]]], "]"}], ",", 
                 RowBox[{"ArcCos", "[", 
                  FractionBox["pzmes", 
