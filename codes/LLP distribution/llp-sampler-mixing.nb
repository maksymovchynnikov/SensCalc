              ",", " ", 
             RowBox[{
             "simply", " ", "renormalize", " ", "the", " ", "LLP", " ", 
              "energy"}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", "IfCollider"}], ",", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
                RowBox[{"Meson", "'"}], "s", " ", "and", " ", 
                RowBox[{"LLP", "'"}], "s", " ", "kinematics", " ", "at", " ", 
                "CM", " ", "frame"}], ",", " ", 
               RowBox[{
               "assuming", " ", "that", " ", "their", " ", "CM", " ", 
                "momenta", " ", "are", " ", "the", " ", 
                RowBox[{"same", ".", " ", "It"}], " ", "is", " ", "also", " ",
                 "assumed", " ", "that", " ", "the", " ", "boost", " ", "is", 
                " ", "in", " ", "the", " ", "z", " ", "direction"}]}], "*)"}],
              "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pzmesCM", "=", 
               RowBox[{"pzllpCM", "=", 
                RowBox[{"pproductLab3Cart", "[", 
                 RowBox[{"0.", ",", "0.", ",", 
                  RowBox[{"-", "pboost"}], ",", "Eplab", ",", "0.938", ",", 
