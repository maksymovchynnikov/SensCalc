          RowBox[{"{", 
           RowBox[{"IfCollider", ",", 
            RowBox[{"True", "|", "False"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"IfESS", ",", 
            RowBox[{"True", "|", "False"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Theta]llpFin", "=", "0."}], ",", 
