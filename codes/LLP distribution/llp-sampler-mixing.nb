                 SuperscriptBox["pzllpLab", "2"], "+", 
                 SuperscriptBox["mLLP", "2"]}]]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                 RowBox[{"Warning", "!"}], " ", "If", " ", "relating", " ", 
