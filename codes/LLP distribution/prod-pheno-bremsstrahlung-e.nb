Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"d\[Sigma]", "[", 
    RowBox[{
    "m\[Gamma]_", ",", "\[Epsilon]2_", ",", "\[Theta]\[Gamma]_", ",", 
     "E\[Gamma]_", ",", "Ee_", ",", "E0_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Theta]\[Gamma]", "*", "8.", "*", 
      SuperscriptBox["\[Alpha]EMval", "3"], "*", "\[Epsilon]2", "*", 
      SuperscriptBox["Ee", "2"], "*", "xe", "*", 
      RowBox[{"\[Gamma]FluxInt", "[", 
       RowBox[{"Ee", ",", "m\[Gamma]"}], "]"}], "*", 
      SqrtBox[
       RowBox[{"1", "-", 
        FractionBox[
         SuperscriptBox["m\[Gamma]", "2"], 
         SuperscriptBox["Ee", "2"]]}]], "*", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"1", "-", "xe", "+", 
          FractionBox[
           SuperscriptBox["xe", "2"], "2"]}], "U2"], "+", 
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", "xe"}], ")"}], "2"], 
          SuperscriptBox["U2", "2"]], 
         SuperscriptBox["m\[Gamma]", "4"]}], "-", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "xe"}], ")"}], "xe", "*", 
          SuperscriptBox["m\[Gamma]", "2"]}], 
         SuperscriptBox["U2", 
          FractionBox["3", "2"]]]}], ")"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{"U2", "->", 
       RowBox[{
        RowBox[{
         SuperscriptBox["Ee", "2"], "*", "xe", "*", 
         SuperscriptBox["\[Theta]\[Gamma]", "2"]}], "+", 
        RowBox[{
         SuperscriptBox["m\[Gamma]", "2"], 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"1", "-", "xe"}], ")"}], "xe"]}], "+", 
        RowBox[{
         SuperscriptBox["me", "2"], "xe"}]}]}], "}"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"me", "->", 
       RowBox[{"ParamProductMass", "[", "11.", "]"}]}], ",", 
      RowBox[{"xe", "->", 
       FractionBox["E\[Gamma]", "Ee"]}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dNDP", "[", 
    RowBox[{
    "m\[Gamma]_", ",", "\[Epsilon]2_", ",", "\[Theta]\[Gamma]_", ",", 
     "E\[Gamma]_", ",", "Ee_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"NeE137", "*", 
     FractionBox[
      RowBox[{"N0", "*", "X0al"}], "Aal"], "*", 
     RowBox[{"fluxEexact", "[", "Ee", "]"}], "*", 
     FractionBox["E0E137", "Ee"], "*", 
     RowBox[{"d\[Sigma]", "[", 
      RowBox[{
      "m\[Gamma]", ",", "\[Epsilon]2", ",", "\[Theta]\[Gamma]", ",", 
       "E\[Gamma]", ",", "Ee", ",", "E0E137"}], "]"}]}], "//", "Simplify"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d2NDPd\[Theta]\[Gamma]dE\[Gamma]", "[", 
   RowBox[{
   "m\[Gamma]_", ",", "\[Epsilon]2_", ",", "\[Theta]\[Gamma]_", ",", 
    "E\[Gamma]_"}], "]"}], ":=", 
  RowBox[{"\[Epsilon]2", "*", 
   RowBox[{"If", "[", 
