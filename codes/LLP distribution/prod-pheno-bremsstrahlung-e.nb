Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"!", 
    RowBox[{"FileExistsQ", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", 
        "\"\<Bremsstrahlung data\>\"", ",", "\"\<Brem-e-data.mx\>\""}], "}"}],
       "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ffRules", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "->", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{"111", "*", 
           SuperscriptBox["Zal", 
            FractionBox[
             RowBox[{"-", "1"}], "3"]]}], ")"}], 
         RowBox[{"ParamProductMass", "[", "11.", "]"}]]}], ",", " ", 
       RowBox[{"d", "->", " ", 
        RowBox[{"0.164", "*", 
         SuperscriptBox["Aal", 
          FractionBox[
           RowBox[{"-", "2"}], "3"]]}]}], ",", 
       RowBox[{"b", "->", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{"773", "*", 
           SuperscriptBox["Zal", 
            FractionBox[
             RowBox[{"-", "2"}], "3"]]}], ")"}], 
         RowBox[{"ParamProductMass", "[", "11.", "]"}]]}], ",", 
       RowBox[{"\[Mu]", "->", "2.79"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"G", "[", "t_", "]"}], "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{
              SuperscriptBox["a", "2"], "*", "t"}], 
             RowBox[{"1", "+", 
              RowBox[{
               SuperscriptBox["a", "2"], "*", "t"}]}]], ")"}], "2"], "*", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox["1", 
             RowBox[{"1", "+", 
              RowBox[{"t", "/", "d"}]}]], ")"}], "2"], 
          SuperscriptBox["Zal", "2"]}], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{
              SuperscriptBox["b", "2"], "*", "t"}], 
             RowBox[{"1", "+", 
              RowBox[{
               SuperscriptBox["b", "2"], "*", "t"}]}]], ")"}], "2"], "*", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{"1", "+", 
              RowBox[{
               FractionBox["t", 
                RowBox[{"4", "*", 
                 SuperscriptBox[
                  RowBox[{"ParamProductMass", "[", "2212.", "]"}], "2"]}]], 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["\[Mu]", "2"], "-", "1"}], ")"}]}]}], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"t", "/", "0.71"}]}], ")"}], "4"]], ")"}], "2"], 
          "Zal"}]}], ")"}], "/.", " ", "ffRules"}], " ", "//", "Simplify"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Gamma]FluxIntegral", "[", 
      RowBox[{"Ee_", ",", "m\[Gamma]_"}], "]"}], ":=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"G", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            SuperscriptBox["m\[Gamma]", "2"], 
            RowBox[{"2", "Ee"}]], ")"}], "2"], ",", 
         SuperscriptBox["m\[Gamma]", "2"]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Gamma]FluxInt", "[", 
      RowBox[{"Ee_", ",", "m\[Gamma]_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"Interpolation", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"ParallelTable", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Ee", ",", "m\[Gamma]", ",", 
              RowBox[{"\[Gamma]FluxIntegral", "[", 
               RowBox[{"Ee", ",", "m\[Gamma]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Ee", ",", "0.05", ",", 
              RowBox[{"1.05", "*", "E0E137"}], ",", "0.1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"m\[Gamma]", ",", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0.001", ",", "0.005", ",", "0.01", ",", "0.015"}], 
                 "}"}], ",", 
                RowBox[{"Table", "[", 
                 RowBox[{"m", ",", 
                  RowBox[{"{", 
                   RowBox[{"m", ",", "0.02", ",", "0.4", ",", "0.01"}], 
                   "}"}]}], "]"}]}], "]"}]}], "}"}]}], "]"}], ",", "1"}], 
         "]"}], ",", 
        RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
      RowBox[{"Ee", ",", "m\[Gamma]"}], "]"}]}], ";", "\[IndentingNewLine]", 
