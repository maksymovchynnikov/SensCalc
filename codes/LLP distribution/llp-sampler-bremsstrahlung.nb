Cell[BoxData[
 RowBox[{
  RowBox[{"BlockTabulatedPDFsFromBreme", "[", 
   RowBox[{"LLP_", ",", "Facility_", ",", "mLLPlist_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TabulatedDoubleDistrBremeTot", "=", 
      RowBox[{"{", 
       RowBox[{"{", "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"NormBremeTot", "=", 
      RowBox[{"{", 
       RowBox[{"{", "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], "@", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"TabulatedDoubleDistrBreme", "[", "mLLP", "]"}], "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"ParallelTable", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"mLLP", ",", "\[Theta]LLP", ",", "ELLP", ",", 
                RowBox[{"d2PBremsstrahlunged\[Theta]\[Gamma]dE\[Gamma]", "[", 
                 RowBox[{
                 "LLP", ",", "mLLP", ",", "1", ",", "\[Theta]LLP", ",", 
                  "ELLP"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\[Theta]LLP", ",", 
                RowBox[{"\[Theta]Nlist", "[", "Facility", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"ELLP", ",", 
                RowBox[{"ENlist", "[", "Facility", "]"}]}], "}"}]}], "]"}], ",",
             "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"distrMaxValBreme", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"TabulatedDoubleDistrBreme", "[", "mLLP", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"-", "1"}]}], "]"}], "]"}], "//", "Max"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"\[Theta]maxNonZeroBreme", "=", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"TabulatedDoubleDistrBreme", "[", "mLLP", "]"}], ",", 
              RowBox[{
               RowBox[{
                FractionBox[
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "1"}], "]"}], "]"}], "distrMaxValBreme"], ">", 
                SuperscriptBox["10", 
                 RowBox[{"-", "15"}]]}], "&"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"TabulatedDoubleDistrBremeInt", "[", 
           RowBox[{"\[Theta]LLP_", ",", "ELLP_"}], "]"}], "=", 
          RowBox[{
           RowBox[{"Interpolation", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"TabulatedDoubleDistrBreme", "[", "mLLP", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "3", ",", "4"}], "}"}]}], "]"}], "]"}], ",", 
             RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
           RowBox[{"\[Theta]LLP", ",", "ELLP"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"TabulatedDoubleDistrBremeNormVal", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"TabulatedDoubleDistrBremeInt", "[", 
             RowBox[{"\[Theta]LLP", ",", "ELLP"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Theta]LLP", ",", 
              RowBox[{"Min", "[", 
               RowBox[{"\[Theta]Nlist", "[", "Facility", "]"}], "]"}], ",", 
              RowBox[{"Min", "[", 
               RowBox[{"\[Theta]maxNonZeroBreme", ",", 
                RowBox[{"Max", "[", 
                 RowBox[{"\[Theta]Nlist", "[", "Facility", "]"}], "]"}]}], 
               "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ELLP", ",", "mLLP", ",", 
              RowBox[{"Max", "[", 
               RowBox[{"ENlist", "[", "Facility", "]"}], "]"}]}], "}"}], ",", 
            RowBox[{
            "Method", "->", "\"\<InterpolationPointsSubdivision\>\""}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"TabulatedDoubleDistrBremeTot", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"TabulatedDoubleDistrBremeTot", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], ",", 
                FractionBox[
                 RowBox[{"#", "[", 
                  RowBox[{"[", "4", "]"}], "]"}], 
                 "TabulatedDoubleDistrBremeNormVal"]}], "}"}], "&"}], "/@", 
             RowBox[{"TabulatedDoubleDistrBreme", "[", "mLLP", "]"}]}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"NormBremeTot", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"NormBremeTot", ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"mLLP", ",", "TabulatedDoubleDistrBremeNormVal"}], 
              "}"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"mLLP", ",", "mLLPlist"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TabulatedDoubleDistrBremeTot", "=", 
      RowBox[{
       RowBox[{"Drop", "[", 
        RowBox[{"TabulatedDoubleDistrBremeTot", ",", "1"}], "]"}], "//", 
       "Developer`ToPackedArray"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"NormBremeTotInt", "[", "mLLP_", "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
              RowBox[{"Log", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "+", 
                SuperscriptBox["10", 
                 RowBox[{"-", "90."}]]}], "]"}]}], "}"}], "&"}], "/@", 
           RowBox[{"Drop", "[", 
            RowBox[{"NormBremeTot", ",", "1"}], "]"}]}], ",", 
          RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
        RowBox[{"Log", "[", "mLLP", "]"}], "]"}], "//", "Exp"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"filenameToExport", "[", 
        RowBox[{"LLP", ",", "\"\<Bremsstrahlung-e\>\"", ",", "Facility"}], 
        "]"}], ",", "TabulatedDoubleDistrBremeTot", ",", "\"\<MX\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "dirMain", ",", "\"\<phenomenology\>\"", ",", "LLP", 
          ",", "\"\<Production probabilities\>\"", ",", 
          
          RowBox[{"\"\<ProdProb_\>\"", "<>", "LLP", 
           "<>", "\"\<_Bremsstrahlung-e_\>\"", "<>", "Facility", 
           "<>", "\"\<.m\>\""}]}], "}"}], "]"}], ",", 
       RowBox[{"NormBremeTotInt", "[", "mLLP", "]"}], ",", "\"\<MX\>\""}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
