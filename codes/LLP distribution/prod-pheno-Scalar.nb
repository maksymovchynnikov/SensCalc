Cell[CellGroupData[{

Cell["Descriptions of the processes", "Subsection",
 CellChangeTimes->{{3.9505808008253574`*^9, 3.9505808033833046`*^9}, {
  3.9869105649887676`*^9, 
  3.9869105695679245`*^9}},ExpressionUUID->"32399c11-a602-2544-b508-\
