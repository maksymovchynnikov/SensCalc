      RowBox[{
       RowBox[{"SimilarParticle", "[", 
        RowBox[{"\"\<SPS\>\"", ",", "\"\<tau\>\""}], "]"}], "=", 
       RowBox[{
        RowBox[{"SimilarParticle", "[", 
         RowBox[{"\"\<FermilabBD\>\"", ",", "\"\<tau\>\""}], "]"}], 
        "=", "\"\<Ds\>\""}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SimilarParticle", "[", 
      RowBox[{"\"\<FCC-hh\>\"", ",", "\"\<D0\>\""}], "]"}], "=", 
     RowBox[{
      RowBox[{"SimilarParticle", "[", 
       RowBox[{"\"\<FCC-hh\>\"", ",", "\"\<Ds\>\""}], "]"}], 
      "=", "\"\<Dcharged\>\""}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"keysFCChh", "=", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Keys", "[", 
             RowBox[{"DownValues", "@", "SimilarParticle"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
          RowBox[{"{", 
