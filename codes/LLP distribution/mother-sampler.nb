        RowBox[{"SimilarParticle", "[", 
         RowBox[{"\"\<FermilabBD\>\"", ",", "\"\<Bs\>\""}], "]"}], 
        "=", "\"\<Bcharged\>\""}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SimilarParticle", "[", 
      RowBox[{"\"\<FCC-hh\>\"", ",", "\"\<tau\>\""}], "]"}], "=", 
     RowBox[{
      RowBox[{"SimilarParticle", "[", 
