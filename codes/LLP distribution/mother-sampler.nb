 RowBox[{
  RowBox[{"MotherInterpolation", "[", 
   RowBox[{"Facility_", ",", "Particle_", ",", 
    RowBox[{"ifNormComputing_", ":", "False"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"data", ",", "datalog", ",", "eMinMax", ",", 
      RowBox[{"norm", "=", "0."}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"data", "=", 
      RowBox[{"DataDistr", "[", 
       RowBox[{"Facility", ",", "Particle"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"datalog", "=", 
      RowBox[{"DataLogarithmiedComp", "[", "data", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]MinMax", "[", 
       RowBox[{"Facility", ",", "Particle"}], "]"}], "=", 
      RowBox[{"MinMax", "[", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Emax", "[", 
       RowBox[{"\[Theta]X_", ",", "Facility", ",", "Particle"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{"FindingEmax\[Theta]", "[", 
           RowBox[{
            RowBox[{"DataDistr", "[", 
             RowBox[{"Facility", ",", "Particle"}], "]"}], ",", "Facility", ",",
             "7"}], "]"}], ",", 
          RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
        RowBox[{"Log", "[", "\[Theta]X", "]"}], "]"}], "//", "Exp"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"DoubleDistrMotherInt", "[", 
       RowBox[{"\[Theta]X_", ",", "EX_", ",", "Facility", ",", "Particle"}], 
       "]"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"mSM", "[", "Particle", "]"}], "<=", "EX", "<=", 
          RowBox[{"Emax", "[", 
           RowBox[{"\[Theta]X", ",", "Facility", ",", "Particle"}], "]"}]}], "&&", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Theta]MinMax", "[", 
            RowBox[{"Facility", ",", "Particle"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<=", "\[Theta]X", "<=", 
          RowBox[{
           RowBox[{"\[Theta]MinMax", "[", 
            RowBox[{"Facility", ",", "Particle"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
        RowBox[{"Evaluate", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"Interpolation", "[", 
            RowBox[{"datalog", ",", 
             RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
           RowBox[{
            RowBox[{"Log", "[", "\[Theta]X", "]"}], ",", 
            RowBox[{"Log", "[", "EX", "]"}]}], "]"}], "]"}], "]"}], ",", 
        "0."}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"ifNormComputing", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"eMinMax", "=", 
         RowBox[{"MinMax", "[", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"norm", "=", 
         RowBox[{
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"DoubleDistrMotherInt", "[", 
              RowBox[{
               RowBox[{"Exp", "[", "th", "]"}], ",", 
               RowBox[{"Exp", "[", "e", "]"}], ",", "Facility", ",", 
               "Particle"}], "]"}], 
             RowBox[{"Exp", "[", 
              RowBox[{"th", "+", "e"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"th", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Theta]MinMax", "[", 
                 RowBox[{"Facility", ",", "Particle"}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], "//", "Log"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Theta]MinMax", "[", 
                 RowBox[{"Facility", ",", "Particle"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], "//", "Log"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"e", ",", 
              RowBox[{"Log", "[", 
               RowBox[{"eMinMax", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
              RowBox[{"Log", "[", 
               RowBox[{"eMinMax", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], ",", 
            RowBox[{
            "Method", "->", "\"\<InterpolationPointsSubdivision\>\""}]}], 
           "]"}], "//", "Quiet"}]}], ";", "\[IndentingNewLine]", "norm"}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
