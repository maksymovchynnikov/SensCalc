                     "Nothing"}], "]"}]}], ",", "Nothing"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"Length", "[", "photonStrata", "]"}]}], "}"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "stratumData", "]"}], ">", "0"}], ",", 
              RowBox[{
               RowBox[{"combinedWeights", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Join", "@@", 
                   RowBox[{"stratumData", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "//", "N"}], "//",
                  "Developer`ToPackedArray"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"combinedALPPoints", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Join", "@@", 
                   RowBox[{"stratumData", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "//", "N"}], "//",
                  "Developer`ToPackedArray"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"norm", "=", 
                RowBox[{"Total", "[", "combinedWeights", "]"}]}]}], ",", 
              RowBox[{"norm", "=", "0."}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"norm", ">", "0."}], ",", 
              RowBox[{
               RowBox[{"alpPoints", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"RandomChoice", "[", 
                   RowBox[{
                    RowBox[{"combinedWeights", "->", "combinedALPPoints"}], ",",
                     "neventsTotal"}], "]"}], "//", "N"}], "//", 
                 "Developer`ToPackedArray"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"FromDataToSmoothDistribution", "[", 
                RowBox[{
                "alpPoints", ",", "ma", ",", "Facility", ",", "IfTesting"}], 
                "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"tabpdf", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Flatten", "[", 
                   RowBox[{
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"ma", ",", "\[Theta]a", ",", "Ea", ",", 
                    RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"10", "^", 
                    RowBox[{"-", "90."}]}], ",", 
                    RowBox[{"DoubleDistr", "[", 
                    RowBox[{"\[Theta]a", ",", "Ea"}], "]"}]}], "]"}]}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"\[Theta]a", ",", "\[Theta]list"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"Ea", ",", "Elist"}], "}"}]}], "]"}], ",", "1"}], 
                   "]"}], "//", "N"}], "//", "Developer`ToPackedArray"}]}]}], 
              ",", 
              RowBox[{"tabpdf", "=", "emptyTabpdf"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"ma", ",", 
              RowBox[{"Max", "[", 
               RowBox[{
                RowBox[{"10", "^", 
                 RowBox[{"-", "90."}]}], ",", "norm"}], "]"}], ",", 
              "tabpdf"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"ma", ",", "mlist"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"norms", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"perMassData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], "//", "N"}], "//",
          "Developer`ToPackedArray"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NormalizationALP", "[", "ma_", "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Interpolation", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", 
                  RowBox[{"Max", "[", 
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "90."}]}]}], "]"}]}], "}"}], "&"}], "/@", 
               "norms"}], ")"}], "//", "Log"}], ",", 
            RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
          RowBox[{"Log", "[", "ma", "]"}], "]"}], "//", "Exp"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tabulatedDistr", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Join", "@@", 
           RowBox[{"perMassData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "//", "N"}], "//", 
         "Developer`ToPackedArray"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"filename1", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
          "dirMain", ",", "\"\<spectra\>\"", 
           ",", "\"\<New physics particles spectra\>\"", ",", 
           RowBox[{"LLPfolder", "[", "fipn", "]"}], ",", 
           RowBox[{"ToString", "@", 
            RowBox[{"StringForm", "[", 
             RowBox[{"\"\<DoubleDistr_``_``-``_``.m\>\"", ",", 
              RowBox[{"Sequence", "@@", 
               RowBox[{"{", 
                RowBox[{
                "fipn", ",", "proc", ",", "Nucleus", ",", "Facility"}], 
                "}"}]}]}], "]"}]}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"filename2", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dirMain", ",", "\"\<phenomenology\>\"", ",", 
           RowBox[{"LLPfolder", "[", "fipn", "]"}], 
           ",", "\"\<Production probabilities\>\"", ",", 
           RowBox[{"ToString", "@", 
            RowBox[{"StringForm", "[", 
             RowBox[{"\"\<Pprod_``_``-``_``.m\>\"", ",", 
              RowBox[{"Sequence", "@@", 
               RowBox[{"{", 
                RowBox[{
                "fipn", ",", "proc", ",", "Nucleus", ",", "Facility"}], 
                "}"}]}]}], "]"}]}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"filename1", ",", "tabulatedDistr", ",", "\"\<MX\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", RowBox[{"filename2", ",", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"fipn", "\[Equal]", "\"ALP-electroweak\""}], ",", SuperscriptBox[RowBox[{"(", FractionBox["1", RowBox[{"137.035999177`", " ", "\[Pi]"}]], ")"}], "2"], ",", "1.`"}], "]"}], " ", RowBox[{"NormalizationALP", "[", "ma", "]"}]}], ",", "\"MX\""}], "]"}], ";"}]}], "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
