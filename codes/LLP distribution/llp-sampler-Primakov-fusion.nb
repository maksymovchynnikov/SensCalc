Notebook[{

Cell[CellGroupData[{
Cell["Production via Primakov process: PDF and normalization", "Chapter",
 CellChangeTimes->{{3.913478380065708*^9, 3.9134784012039795`*^9}},
 CellTags->
  "Evaluation",ExpressionUUID->"ede618e1-db1f-4052-9341-3ad98669ba20"],

Cell[CellGroupData[{

Cell[TextData[{
 "Collinear approximation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "a"], " ", "=", " ", 
    SubscriptBox["\[Theta]", "\[Gamma]"]}], TraditionalForm]],ExpressionUUID->
  "593b2594-587c-48c3-8754-06fb5f6003bc"]
}], "Section",
 CellChangeTimes->{{3.9880470872263107`*^9, 
  3.988047100909174*^9}},ExpressionUUID->"e577f11d-6ab7-594c-a4d2-\
a3a239c7f875"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BlockTabulatedPDFsFromPrimakov", "[", 
   RowBox[{
   "Facility_", ",", "Nucleus_", ",", "\[Theta]list_", ",", "Elist_"}], "]"}],
   ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Theta]min", ",", "\[Theta]max", ",", "mlist", ",", "filename1", ",", 
      "filename2", ",", "proc", ",", "fipn", ",", "mother"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"proc", "=", "\"\<Primakov-primary\>\""}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mother", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"proc", "==", "\"\<Primakov-primary\>\""}], 
        ",", "\"\<photon\>\"", ",", "\"\<photon-cascade\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fipn", "=", "\"\<ALP-photon\>\""}], ";", "\[IndentingNewLine]", 
     RowBox[{"mlist", "=", 
      RowBox[{"MassList", "[", 
       RowBox[{"fipn", ",", "proc", ",", "Facility"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ProbPrimakovTab", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"ParallelTable", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ma", ",", "E\[Gamma]", ",", 
              RowBox[{"Max", "[", 
               RowBox[{
                SuperscriptBox["10", 
                 RowBox[{"-", "90."}]], ",", 
                RowBox[{
                 FractionBox["1", 
                  RowBox[{"\[Sigma]\[Gamma]Abs", "[", "Nucleus", "]"}]], 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Quiet", "[", 
                    RowBox[{"\[Sigma]PrimakovNucleus", "[", 
                    RowBox[{"ma", ",", "E\[Gamma]", ",", 
                    RowBox[{"mnucleus", "[", "Nucleus", "]"}], ",", 
                    RowBox[{"anucleus", "[", "Nucleus", "]"}], ",", 
                    RowBox[{"znucleus", "[", "Nucleus", "]"}]}], "]"}], "]"}],
                    "+", 
                   RowBox[{"Quiet", "[", 
                    RowBox[{"\[Sigma]PrimakovNucleons", "[", 
                    RowBox[{"ma", ",", "E\[Gamma]", ",", 
                    RowBox[{"znucleus", "[", "Nucleus", "]"}]}], "]"}], 
                    "]"}]}], ")"}]}]}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ma", ",", "mlist"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"E\[Gamma]", ",", 
              RowBox[{"ENlist", "[", "Facility", "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "//", "N"}], "//", 
       "Developer`ToPackedArray"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"Approximation", ":", " ", 
         SubscriptBox["E", "a"]}], " ", "=", " ", 
        SubscriptBox["E", "\[Gamma]"]}], ",", " ", 
       RowBox[{
        SubscriptBox["\[Theta]", "a"], " ", "=", " ", 
        SubscriptBox["\[Theta]", "\[Gamma]"]}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ProbPrimakov", "[", 
       RowBox[{"ma_", ",", "Ea_"}], "]"}], "=", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{"Log", "[", "ProbPrimakovTab", "]"}], ",", 
          RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
        RowBox[{
         RowBox[{"Log", "[", "ma", "]"}], ",", 
         RowBox[{"Log", "[", "Ea", "]"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MotherInterpolation", "[", 
      RowBox[{"Facility", ",", "mother"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ALPdoubleFlux", "[", 
       RowBox[{"ma_", ",", "\[Theta]a_", ",", "Ea_"}], "]"}], "=", 
      RowBox[{
       RowBox[{"DoubleDistrMotherInt", "[", 
        RowBox[{"\[Theta]a", ",", "Ea", ",", "Facility", ",", "mother"}], 
        "]"}], "*", 
       RowBox[{"ProbPrimakov", "[", 
        RowBox[{"ma", ",", "Ea"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]min", ",", "\[Theta]max"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]MinMax", "[", 
          RowBox[{"Facility", ",", "\"\<photon\>\""}], "]"}], "[", 
         RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"NormalizationALP1", "[", "ma_", "]"}], "=", 
      RowBox[{
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ma", ",", 
             RowBox[{"Quiet", "[", 
              RowBox[{"NIntegrate", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ALPdoubleFlux", "[", 
                  RowBox[{"ma", ",", 
                   RowBox[{"Exp", "[", "t", "]"}], ",", 
                   RowBox[{"Exp", "[", "e", "]"}]}], "]"}], 
                 RowBox[{"Exp", "[", 
                  RowBox[{"t", "+", "e"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"t", ",", 
                  RowBox[{"Log", "[", "\[Theta]min", "]"}], ",", 
                  RowBox[{"Log", "[", "\[Theta]max", "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"e", ",", 
                  RowBox[{"Log", "[", "ma", "]"}], ",", 
                  RowBox[{"Log", "[", 
                   RowBox[{"Emax", "[", 
                    RowBox[{
                    "\[Theta]min", ",", "Facility", ",", "\"\<photon\>\""}], 
                    "]"}], "]"}]}], "}"}], ",", 
                RowBox[{
                "Method", "->", "\"\<InterpolationPointsSubdivision\>\""}]}], 
               "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ma", ",", "mlist"}], "}"}]}], "]"}], ",", 
         RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}], "[", "ma", 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"DoubleDistrALP", "[", 
       RowBox[{"ma_", ",", "\[Theta]a_", ",", "Ea_"}], "]"}], "=", 
      RowBox[{
       RowBox[{"ALPdoubleFlux", "[", 
        RowBox[{"ma", ",", "\[Theta]a", ",", "Ea"}], "]"}], "/", 
       RowBox[{"NormalizationALP1", "[", "ma", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"filename1", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "dirMain", ",", "\"\<spectra\>\"", 
         ",", "\"\<New physics particles spectra\>\"", ",", 
         RowBox[{"LLPfolder", "[", "\"\<ALP-photon\>\"", "]"}], ",", 
         RowBox[{"ToString", "@", 
          RowBox[{"StringForm", "[", 
           RowBox[{"\"\<DoubleDistr_``_``-``_``.m\>\"", ",", 
            RowBox[{"Sequence", "@@", 
             RowBox[{"{", 
              RowBox[{"fipn", ",", "proc", ",", "Nucleus", ",", "Facility"}], 
              "}"}]}]}], "]"}]}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"filename2", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"dirMain", ",", "\"\<phenomenology\>\"", ",", 
         RowBox[{"LLPfolder", "[", "fipn", "]"}], 
         ",", "\"\<Production probabilities\>\"", ",", 
         RowBox[{"ToString", "@", 
          RowBox[{"StringForm", "[", 
           RowBox[{"\"\<Pprod_``_``-``_``.m\>\"", ",", 
            RowBox[{"Sequence", "@@", 
             RowBox[{"{", 
              RowBox[{"fipn", ",", "proc", ",", "Nucleus", ",", "Facility"}], 
              "}"}]}]}], "]"}]}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tabulatedDistr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ma", ",", "\[Theta]a", ",", "Ea", ",", 
              RowBox[{"DoubleDistrALP", "[", 
               RowBox[{"ma", ",", "\[Theta]a", ",", "Ea"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ma", ",", "mlist"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Theta]a", ",", "\[Theta]list"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Ea", ",", "Elist"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], "//", "N"}], "//",
        "Developer`ToPackedArray"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"filename1", ",", "tabulatedDistr", ",", "\"\<MX\>\""}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"filename2", ",", 
       RowBox[{"NormalizationALP1", "[", "ma", "]"}], ",", "\"\<MX\>\""}], 
      "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.913478598526929*^9, 3.9134786088906193`*^9}, {
   3.913479045210778*^9, 3.9134790484558215`*^9}, {3.913479859567234*^9, 
   3.9134798610344944`*^9}, {3.9136289669868803`*^9, 3.913629003229072*^9}, {
   3.9136290904436054`*^9, 3.9136290914999332`*^9}, 3.913883326179581*^9, {
   3.913883380744624*^9, 3.913883402165001*^9}, {3.913887808984487*^9, 
   3.913887814403036*^9}, 3.915082852511978*^9, {3.9154388176298885`*^9, 
   3.9154388176340685`*^9}, {3.9423247079044304`*^9, 3.942324734955353*^9}, {
   3.988257294742363*^9, 3.9882572968081284`*^9}, {3.988307448518383*^9, 
   3.9883074515765*^9}, {3.9888992258065367`*^9, 3.988899237449174*^9}, {
   3.989163854748476*^9, 3.989163909676755*^9}},
 CellTags->
  "Evaluation",ExpressionUUID->"1b07e271-afb1-4157-a0b3-9451e6471051"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Alternative - MC with exact ALP-\[Gamma] angle", "Section",
 CellChangeTimes->{{3.9880470584913883`*^9, 3.9880470709032555`*^9}},
 CellTags->
  "Evaluation",ExpressionUUID->"20808182-612b-ba47-a55a-280cf65a84d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"BlockTabulatedPDFsFromPrimakovAlt", "[", 
     RowBox[{
     "Facility_", ",", "proc_", ",", "Nucleus_", ",", "\[Theta]list_", ",", 
      "Elist_", ",", 
      RowBox[{"Nevents_", ":", 
       RowBox[{"10", "^", "7"}]}], ",", 
      RowBox[{"order_", ":", "9"}], ",", 
      RowBox[{"IfTesting_", ":", "\"\<False\>\""}]}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "mlist", ",", "filename1", ",", "filename2", ",", "fipn", ",", 
        "photonDistrTab", ",", "photonPoints", ",", "perMassData", ",", 
        "norms", ",", "tabulatedDistr", ",", "ma", ",", "rawALP", ",", 
        "weights", ",", "norm", ",", "alpPoints", ",", "tabpdf", ",", 
        "mother", ",", "eminsamplPrim", ",", "emaxPhoton", ",", 
        "strataTemplate", ",", "activeStrata", ",", "fractions", ",", 
        "rawNevents", ",", "neventsByStratum", ",", "remainder", ",", 
        "addOne", ",", "stratumData", ",", "i", ",", "eminStratum", ",", 
        "emaxStratum", ",", "neventsStratum", ",", "norm\[Gamma]Stratum", ",",
         "rawALPStratum", ",", "weightsStratum", ",", "goodStratum", ",", 
        "combinedWeights", ",", "combinedALPPoints", ",", "emptyTabpdf", ",", 
        "neventsTotal", ",", "nStrata", ",", "strataFractions"}], "}"}], ",", 
      RowBox[{
       RowBox[{"fipn", "=", "\"\<ALP-photon\>\""}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"neventsTotal", "=", 
        RowBox[{"Round", "[", "Nevents", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mlist", "=", 
        RowBox[{"MassList", "[", 
         RowBox[{"fipn", ",", "proc", ",", "Facility"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mother", "=", 
        RowBox[{
         RowBox[{"ReactionProductsList", "[", 
          RowBox[{"\"\<ALP-photon\>\"", ",", "proc"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"photonDistrTab", "=", 
        RowBox[{"DataDistr", "[", 
         RowBox[{"Facility", ",", "mother"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"emaxPhoton", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"photonDistrTab", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nStrata", "=", "7"}], ";", "\[IndentingNewLine]", 
       RowBox[{"strataFractions", "=", 
        RowBox[{"{", 
         RowBox[{
         "0.20", ",", "0.15", ",", "0.15", ",", "0.15", ",", "0.15", ",", 
          "0.10", ",", "0.10"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"strataTemplate", "=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "edges", "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"edges", "=", 
            RowBox[{"Exp", "@", 
             RowBox[{"Subdivide", "[", 
              RowBox[{
               RowBox[{"Log", "[", "0.1", "]"}], ",", 
               RowBox[{"Log", "[", "emaxPhoton", "]"}], ",", "nStrata"}], 
              "]"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Most", "[", "edges", "]"}], ",", 
              RowBox[{"Rest", "[", "edges", "]"}], ",", "strataFractions"}], 
             "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"perMassData", "=", 
        RowBox[{
         RowBox[{"ResourceFunction", "[", "\"\<MonitorProgress\>\"", "]"}], "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"eminsamplPrim", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"0.1", ",", "ma"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"emptyTabpdf", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"ma", ",", "\[Theta]a", ",", "Ea", ",", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "90."}]}]}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"\[Theta]a", ",", "\[Theta]list"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"Ea", ",", "Elist"}], "}"}]}], "]"}], ",", "1"}], 
                "]"}], "//", "N"}], "//", "Developer`ToPackedArray"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"activeStrata", "=", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "eminsamplPrim"}], 
                    "]"}], ",", 
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "emaxPhoton"}], 
                    "]"}], ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "&"}], "/@", 
                 "strataTemplate"}], ")"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ">", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "activeStrata", "]"}], ">", "0"}], ",", 
              RowBox[{
               RowBox[{"fractions", "=", 
                RowBox[{
                 RowBox[{"activeStrata", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "3"}], "]"}], "]"}], "/", 
                 RowBox[{"Total", "[", 
                  RowBox[{"activeStrata", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"rawNevents", "=", 
                RowBox[{"N", "[", 
                 RowBox[{"fractions", "*", "neventsTotal"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"neventsByStratum", "=", 
                RowBox[{"Floor", "[", "rawNevents", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"remainder", "=", 
                RowBox[{"neventsTotal", "-", 
                 RowBox[{"Total", "[", "neventsByStratum", "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"remainder", ">", "0"}], ",", 
                 RowBox[{
                  RowBox[{"addOne", "=", 
                   RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"rawNevents", "-", "neventsByStratum"}], ",", 
                    RowBox[{"-", "remainder"}]}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"neventsByStratum", "[", 
                    RowBox[{"[", "addOne", "]"}], "]"}], "=", 
                   RowBox[{
                    RowBox[{"neventsByStratum", "[", 
                    RowBox[{"[", "addOne", "]"}], "]"}], "+", "1"}]}], 
                  ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"stratumData", "=", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"eminStratum", ",", "emaxStratum"}], "}"}], "=", 
                    RowBox[{"activeStrata", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"neventsStratum", "=", 
                    RowBox[{"neventsByStratum", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"neventsStratum", ">", "0"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"photonPoints", ",", "norm\[Gamma]Stratum"}], 
                    "}"}], "=", 
                    RowBox[{"N", "@", 
                    RowBox[{"BlockPointsFromSmoothDistribution1", "[", 
                    RowBox[{
                    "photonDistrTab", ",", "0.", ",", "neventsStratum", ",", 
                    "order", ",", "Facility", ",", "eminStratum", ",", 
                    "emaxStratum"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"photonPoints", "=", 
                    RowBox[{
                    "photonPoints", "//", "Developer`ToPackedArray"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"rawALPStratum", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ALPsamplingComp", "[", 
                    RowBox[{"photonPoints", ",", "ma", ",", 
                    RowBox[{"anucleus", "[", "Nucleus", "]"}], ",", 
                    RowBox[{"znucleus", "[", "Nucleus", "]"}], ",", 
                    RowBox[{"mnucleus", "[", "Nucleus", "]"}]}], "]"}], "//", 
                    "N"}], "//", "Developer`ToPackedArray"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"weightsStratum", "=", 
                    RowBox[{
                    RowBox[{"rawALPStratum", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "3"}], "]"}], "]"}], "/", 
                    RowBox[{"\[Sigma]\[Gamma]Abs", "[", "Nucleus", "]"}]}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"goodStratum", "=", 
                    RowBox[{"Flatten", "@", 
                    RowBox[{"Position", "[", 
                    RowBox[{"weightsStratum", ",", 
                    RowBox[{"_", "?", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", ">", "0."}], "&"}], ")"}]}]}], "]"}]}]}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "goodStratum", "]"}], ">", "0"}], "&&", 
                    RowBox[{"norm\[Gamma]Stratum", ">", "0."}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"norm\[Gamma]Stratum", "*", 
                    RowBox[{
                    RowBox[{"weightsStratum", "[", 
                    RowBox[{"[", "goodStratum", "]"}], "]"}], "/", 
                    RowBox[{"Length", "[", "photonPoints", "]"}]}]}], ",", 
                    RowBox[{"rawALPStratum", "[", 
                    RowBox[{"[", 
                    RowBox[{"goodStratum", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], "}"}], ",",
                     "Nothing"}], "]"}]}], ",", "Nothing"}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", 
