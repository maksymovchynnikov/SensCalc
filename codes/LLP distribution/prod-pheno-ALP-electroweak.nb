(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{
Cell["ALP-electroweak production", "Title", ExpressionUUID->"207e0fb9-1a3d-4574-b622-e4ba55559404"],

Cell["Branching-ratio tables are at gW=1 GeV^-1. B0 rates use 0.93 times the B+ rate in the sensitivity notebook. The Primakov PDFs use the existing photon sampler; only the exported production probability is rescaled. See phenomenology/ALP-electroweak/README.md.", "Text", ExpressionUUID->"14bced63-c21c-464b-93bb-d26fef30e5ee"],

Cell[CellGroupData[{
Cell["Processes", "Section", ExpressionUUID->"04d9e35c-63d6-48f9-8bab-4ff21fd41389"],
Cell[BoxData[RowBox[{RowBox[{"LLPname", "=", "\"ALP-electroweak\""}], ";", "\[IndentingNewLine]", RowBox[{"BchannelsEW", "=", RowBox[{"{", RowBox[{"\"B-to-K+\"", ",", "\"B-to-K*(892)+\"", ",", "\"B-to-K*(1410)+\"", ",", "\"B-to-K*(1680)+\"", ",", "\"B-to-K0*(700)+\"", ",", "\"B-to-K0*(1430)+\"", ",", "\"B-to-K1(1270)+\"", ",", "\"B-to-K1(1400)+\"", ",", "\"B-to-K2*(1430)+\"", ",", "\"B-to-pi+\""}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{"BrecoilsEW", "=", RowBox[{"{", RowBox[{"\"K+\"", ",", "\"K*(892)+\"", ",", "\"K*(1410)+\"", ",", "\"K*(1680)+\"", ",", "\"K0*(700)+\"", ",", "\"K0*(1430)+\"", ",", "\"K1(1270)+\"", ",", "\"K1(1400)+\"", ",", "\"K2*(1430)+\"", ",", "\"pi+\""}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{"MapThread", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{"mSM", "[", "#1", "]"}], "=", "#2"}], ")"}], "&"}], ",", RowBox[{"{", RowBox[{"BrecoilsEW", ",", RowBox[{"{", RowBox[{"0.493677`", ",", "0.89556`", ",", "1.414`", ",", "1.718`", ",", "0.838`", ",", "1.425`", ",", "1.256`", ",", "1.403`", ",", "1.4324`", ",", "0.13957039`"}], "}"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ProcessesListAll", "[", "LLPname", "]"}], "=", RowBox[{"Join", "[", RowBox[{"BchannelsEW", ",", RowBox[{"{", RowBox[{"\"K-to-Pi\"", ",", "\"Primakov-primary\"", ",", "\"Primakov-cascades\""}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"ProductionType", "[", RowBox[{"LLPname", ",", "proc"}], "]"}], "=", "\"Decay\""}], ",", RowBox[{"{", RowBox[{"proc", ",", RowBox[{"Join", "[", RowBox[{"BchannelsEW", ",", RowBox[{"{", RowBox[{"\"K-to-Pi\"", ",", "\"B\"", ",", "\"K\""}], "}"}]}], "]"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"MapThread", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{"ReactionProductsList", "[", RowBox[{"LLPname", ",", "#1"}], "]"}], "=", RowBox[{"{", RowBox[{"\"Bcharged\"", ",", "#2", ",", "LLPname"}], "}"}]}], ")"}], "&"}], ",", RowBox[{"{", RowBox[{"BchannelsEW", ",", "BrecoilsEW"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ReactionProductsList", "[", RowBox[{"LLPname", ",", "\"K-to-Pi\""}], "]"}], "=", RowBox[{"{", RowBox[{"\"Kcharged\"", ",", "\"PiCharged\"", ",", "LLPname"}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ReactionProductsList", "[", RowBox[{"LLPname", ",", "\"B\""}], "]"}], "=", RowBox[{"{", RowBox[{"\"Bcharged\"", ",", "\"PiCharged\"", ",", "LLPname"}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ReactionProductsList", "[", RowBox[{"LLPname", ",", "\"K\""}], "]"}], "=", RowBox[{"{", RowBox[{"\"Kcharged\"", ",", "\"PiCharged\"", ",", "LLPname"}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ProductionType", "[", RowBox[{"LLPname", ",", "\"Primakov-primary\""}], "]"}], "=", RowBox[{RowBox[{"ProductionType", "[", RowBox[{"LLPname", ",", "\"Primakov-cascades\""}], "]"}], "=", "\"Scattering\""}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ReactionProductsList", "[", RowBox[{"LLPname", ",", "\"Primakov-primary\""}], "]"}], "=", RowBox[{"{", RowBox[{"\"photon\"", ",", "LLPname"}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ReactionProductsList", "[", RowBox[{"LLPname", ",", "\"Primakov-cascades\""}], "]"}], "=", RowBox[{"{", RowBox[{"\"photon-cascade\"", ",", "LLPname"}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"mergedDecayProcessesNames", "[", "LLPname", "]"}], "=", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"B\"", ",", "\"Bcharged\"", ",", "BchannelsEW"}], "}"}], ",", RowBox[{"{", RowBox[{"\"K\"", ",", "\"Kcharged\"", ",", RowBox[{"{", "\"K-to-Pi\"", "}"}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"samemotherprocesses", "[", "LLPname", "]"}], "=", RowBox[{RowBox[{"mergedDecayProcessesNames", "[", "LLPname", "]"}], "\[LeftDoubleBracket]", RowBox[{"All", ",", RowBox[{"{", RowBox[{"2", ",", "3"}], "}"}]}], "\[RightDoubleBracket]"}]}], ";"}]], "Input", ExpressionUUID->"422cab7b-e96b-42d1-a3b4-3401947fba34"]
}, Open]],

Cell[CellGroupData[{
Cell["Descriptions", "Section", ExpressionUUID->"6d2ec9aa-4247-48b5-8f18-05f46660ce4a"],
Cell[BoxData[RowBox[{RowBox[{"LLPname", "=", "\"ALP-electroweak\""}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"DescriptionProcess", "[", RowBox[{"LLPname", ",", "\"B\""}], "]"}], "=", RowBox[{RowBox[{"DescriptionProcess", "[", RowBox[{"LLPname", ",", "\"Bcharged\""}], "]"}], "=", "\"B -> X_s/d a: ten exclusive recoil states, with Higgs-like-scalar ratios rescaled to the electroweak ALP; arXiv:2609.19269 Appendix A.\""}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"DescriptionProcess", "[", RowBox[{"LLPname", ",", "\"K\""}], "]"}], "=", RowBox[{RowBox[{"DescriptionProcess", "[", RowBox[{"LLPname", ",", "\"Kcharged\""}], "]"}], "=", "\"Charged K -> pi a, including the u,c,t loop contributions; arXiv:2609.19269 Appendix A.\""}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"DescriptionProcess", "[", RowBox[{"LLPname", ",", "\"Primakov-primary\""}], "]"}], "=", "\"Primakov production from primary photons with g_agammagamma=(alpha_em/Pi)gW.\""}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"DescriptionProcess", "[", RowBox[{"LLPname", ",", "\"Primakov-cascades\""}], "]"}], "=", "\"Primakov production from cascade photons with g_agammagamma=(alpha_em/Pi)gW.\""}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"DescriptionProcess", "[", RowBox[{"LLPname", ",", "\"All channels\""}], "]"}], "=", "\"B, charged K, primary photons and cascade photons.\""}], ";", RowBox[{RowBox[{"ModelDescription", "[", "LLPname", "]"}], "=", "\"Pure SU(2)L ALP, gW in GeV^-1; g_agammagamma=(alpha_em/Pi)gW. Diphoton-only benchmark of arXiv:2609.19269, produced by B/K decays and Primakov scattering.\""}]}], ";"}]], "Input", ExpressionUUID->"20be3a2f-68ce-49ef-a1c0-ac0c836b4cd7"]
}, Open]],

Cell[CellGroupData[{
Cell["Exclusive branching ratios", "Section", ExpressionUUID->"4192d9bf-bf2e-4553-b880-4ced669b9724"],
Cell[BoxData[RowBox[{RowBox[{"LLPname", "=", "\"ALP-electroweak\""}], ";", "\[IndentingNewLine]", RowBox[{"BrBdataEW", "=", RowBox[{"Import", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"ParentDirectory", "[", RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}], "]"}], ",", "\"phenomenology\"", ",", "LLPname", ",", "\"Production probabilities\"", ",", "\"Br-B-exclusive.txt\""}], "}"}], "]"}], ",", "\"Table\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"BrKdataEW", "=", RowBox[{"Import", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"ParentDirectory", "[", RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}], "]"}], ",", "\"phenomenology\"", ",", "LLPname", ",", "\"Production probabilities\"", ",", "\"Br-Kcharged.txt\""}], "}"}], "]"}], ",", "\"Table\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"Do", "[", RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"proc", "=", RowBox[{"BchannelsEW", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ",", RowBox[{"threshold", "=", RowBox[{RowBox[{"Min", "[", RowBox[{"5.27941`", ",", RowBox[{"mSM", "[", "\"Bcharged\"", "]"}]}], "]"}], "-", RowBox[{"mSM", "[", RowBox[{"BrecoilsEW", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "]"}]}]}], ",", RowBox[{"data", "=", RowBox[{"BrBdataEW", "\[LeftDoubleBracket]", RowBox[{"All", ",", RowBox[{"{", RowBox[{"1", ",", RowBox[{"i", "+", "1"}]}], "}"}]}], "\[RightDoubleBracket]"}]}]}], "}"}], ",", RowBox[{RowBox[{"\[Omega]proc", "[", RowBox[{"LLPname", ",", "proc", ",", "mLLP_"}], "]"}], "=", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"BrBdataEW", "\[LeftDoubleBracket]", RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "\[LessEqual]", "mLLP", "<", "threshold"}], ",", RowBox[{"Evaluate", "[", RowBox[{RowBox[{"Interpolation", "[", RowBox[{"data", ",", RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}], "[", "mLLP", "]"}], "]"}], ",", "0.`"}], "]"}]}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", "BchannelsEW", "]"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"\[Omega]proc", "[", RowBox[{"LLPname", ",", "\"K-to-Pi\"", ",", "mLLP_"}], "]"}], "=", RowBox[{"If", "[", RowBox[{RowBox[{"0.`", "\[LessEqual]", "mLLP", "<", RowBox[{"Min", "[", RowBox[{"0.35410661`", ",", RowBox[{RowBox[{"mSM", "[", "\"Kcharged\"", "]"}], "-", RowBox[{"mSM", "[", "\"PiCharged\"", "]"}]}]}], "]"}]}], ",", RowBox[{"Evaluate", "[", RowBox[{RowBox[{"Interpolation", "[", RowBox[{"BrKdataEW", ",", RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}], "[", "mLLP", "]"}], "]"}], ",", "0.`"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"Clear", "[", RowBox[{"LLPname", ",", "BchannelsEW", ",", "BrecoilsEW", ",", "BrBdataEW", ",", "BrKdataEW"}], "]"}], ";"}]], "Input", ExpressionUUID->"51b00f00-b111-481f-ac95-d95d2650c13c"]
}, Open]]
},
StyleDefinitions->"Default.nb"]
